  {
    "name": "proposal_show",
    "description": "Show a proposal's full detail by UUID or short_id. Use `fields` to select sections (proposal, targets, feedback, signoffs, revisions, debate, epics, gate_status; default: all) and `revision_bodies` to control verbosity (excerpt/full/omit).",
    "inputSchema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Proposal UUID or short_id"
        },
        "fields": {
          "type": [
            "array",
            "null"
          ],
          "description": "Select which top-level sections to include. Accepted values: proposal, targets, feedback, signoffs, revisions, debate, epics, gate_status. Default: all. Invalid values return a validation error naming the accepted values.",
          "items": {
            "type": "string"
          },
          "default": null
        },
        "revision_bodies": {
          "type": [
            "string",
            "null"
          ],
          "description": "Controls revision body verbosity when revisions is selected: excerpt (default, 512-char body_excerpt), full (complete body), omit (no body data). Ignored when fields omits revisions.",
          "default": null
        }
      }
    },
    "readOnly": true,
    "destructive": false,
    "idempotent": true,
    "openWorld": false,
    "concurrent_safe": true
  },
  {
    "name": "proposal_debate_list",
    "description": "List the tribunal debate trail for a proposal: every objection, rebuttal, and verdict across all rounds. The Adversary reads this to avoid re-raising objections; the Advocate reads it to address objections; the Judge reads it to verify resolution.",
    "inputSchema": {
      "type": "object",
      "required": [
        "proposal_id"
      ],
      "properties": {
