    "concurrent_safe": true
  },
  {
    "name": "skill_read",
    "description": "Load the full content of an assigned skill by name. Under progressive skill disclosure the system prompt lists each non-required skill's name and description only; call this to fetch the complete skill body on demand. Errors if the name is not an assigned skill.",
