        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "project": {
          "type": "string",
          "description": "Other registered project to read from (UUID or owner/repo slug). Omit for your own task repo."
        }
      },
      "required": [
        "file_path"
      ]
    },
    "readOnly": true,
    "destructive": false,
    "idempotent": true,
    "openWorld": false,
    "concurrent_safe": true
  },
