        "blocked_by_add": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Epics (UUIDs or short_ids) that must close before this epic's breakdown auto-dispatches."
        },
        "blocked_by_remove": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Epic dependencies to remove."
        }
