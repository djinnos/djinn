{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "regression_schemars_untagged_enum_anyof",
  "description": "Regression shape: schemars untagged-enum anyOf. The schemars crate serializes #[serde(untagged)] Rust enums as anyOf with type-discriminated branches, sometimes including a null variant. OpenAI strict mode rejects top-level anyOf; Gemini flattens nullable anyOf.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "payload": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "const": "text" },
              "content": { "type": "string" }
            },
            "required": ["type", "content"]
          },
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "const": "image" },
              "url": { "type": "string" }
            },
            "required": ["type", "url"]
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": ["payload"]
  },
  "readOnly": true,
  "destructive": false,
  "idempotent": true,
  "openWorld": false,
  "concurrent_safe": true
}
