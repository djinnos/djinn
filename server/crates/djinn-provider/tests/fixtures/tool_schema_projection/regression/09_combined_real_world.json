{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "regression_combined_real_world",
  "description": "Regression shape: combined real-world schema exercising multiple projection concerns simultaneously — nullable anyOf (schemars), $ref siblings, tuple prefixItems, unevaluatedItems, enum coercion, and nested object-without-properties. This mirrors the shape complexity found in the real DjinnMcpServer tool corpus (e.g. project_environment_config, image_create).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "workspace_ref": {
        "$ref": "#/$defs/WorkspaceRef",
        "description": "Workspace reference (siblings will be stripped by Moonshot)",
        "type": "object"
      },
      "config": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["docker", "devcontainer"] }
            },
            "required": ["type"]
          },
          { "type": "null" }
        ]
      },
      "services": {
        "type": "array",
        "prefixItems": [
          {
            "type": "object",
            "properties": {
              "name": { "type": "string" }
            }
          }
        ],
        "unevaluatedItems": false
      },
      "tags": {
        "type": "array",
        "items": {}
      },
      "raw_object": {
        "type": "object"
      },
      "status": {
        "type": "string",
        "enum": ["active", "inactive", "archived"],
        "description": "Current status"
      }
    },
    "required": ["name", "config"],
    "$defs": {
      "WorkspaceRef": {
        "type": "object",
        "properties": {
          "slug": { "type": "string" },
          "name": { "type": "string" }
        },
        "required": ["slug"]
      }
    }
  },
  "readOnly": false,
  "destructive": false,
  "idempotent": false,
  "openWorld": false,
  "concurrent_safe": false
}
