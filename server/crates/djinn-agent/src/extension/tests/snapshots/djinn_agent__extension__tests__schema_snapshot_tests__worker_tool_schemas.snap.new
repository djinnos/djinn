          "type": "string"
        },
        "issue_type": {
          "type": "string"
        },
        "priority": {
          "type": "integer"
        },
        "text": {
          "type": "string",
          "description": "Free-text search in title/description"
        },
        "label": {
          "type": "string"
        },
        "parent": {
          "type": "string",
          "description": "Epic ID to filter by"
        },
        "sort": {
          "type": "string"
        },
        "limit": {
