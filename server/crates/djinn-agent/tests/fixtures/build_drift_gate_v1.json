{
  "description": "ri23 Part 1 build-drift decision table. `canonical` is the flattened lifecycle.final_verification.command_groups; each case asserts the pure classification label produced by classify_build_drift.",
  "project_id": "proj-c9bo",
  "canonical": [
    { "executable": "cargo", "argv": ["clippy", "--all-targets", "--", "-D", "warnings"] },
    { "executable": "cargo", "argv": ["nextest", "run", "--workspace"] },
    { "executable": "pnpm", "argv": ["-C", "web", "test"] }
  ],
  "cases": [
    { "command": "cargo clippy --all-targets -- -D warnings", "expect": "argv_equal", "note": "exact canonical re-run" },
    { "command": "cargo nextest run --workspace", "expect": "argv_equal", "note": "exact canonical re-run, second group" },
    { "command": "pnpm -C web test", "expect": "argv_equal", "note": "exact canonical re-run, non-cargo tool" },
    { "command": "cargo build -p foo", "expect": "drift", "note": "same basename, diverging argv" },
    { "command": "cargo build --release", "expect": "drift", "note": "same basename, diverging argv" },
    { "command": "cargo test -p crate-a", "expect": "drift", "note": "same basename, diverging argv" },
    { "command": "cargo clippy", "expect": "drift", "note": "prefix of a canonical but not exact argv" },
    { "command": "pnpm -C web build", "expect": "drift", "note": "canonical tool, diverging argv" },
    { "command": "go build ./...", "expect": "unrelated", "note": "basename not in canonical set" },
    { "command": "make all", "expect": "unrelated", "note": "basename not in canonical set" },
    { "command": "ls -la", "expect": "unrelated", "note": "innocuous non-build command" },
    { "command": "FOO=bar cargo build -p foo", "expect": "ineligible:env_assignment", "note": "leading env assignment" },
    { "command": "cargo build | tee log.txt", "expect": "ineligible:pipeline", "note": "pipeline" },
    { "command": "cargo build && cargo test", "expect": "ineligible:chain", "note": "&& chain" },
    { "command": "cargo build || true", "expect": "ineligible:chain", "note": "|| chain" },
    { "command": "cargo build; echo ok", "expect": "ineligible:chain", "note": "; chain" },
    { "command": "cargo build > out.txt", "expect": "ineligible:redirection", "note": "stdout redirect" },
    { "command": "cargo build 2> err.txt", "expect": "ineligible:redirection", "note": "fd redirect" },
    { "command": "cargo build <input", "expect": "ineligible:redirection", "note": "stdin redirect" },
    { "command": "(cargo build)", "expect": "ineligible:subshell", "note": "subshell grouping" },
    { "command": "echo $(cargo build)", "expect": "ineligible:substitution", "note": "command substitution" },
    { "command": "cargo build $FLAGS", "expect": "ineligible:substitution", "note": "variable expansion" },
    { "command": "echo `cargo build`", "expect": "ineligible:substitution", "note": "backtick substitution" },
    { "command": "cargo build &", "expect": "ineligible:background", "note": "background op" },
    { "command": "bash -lc \"cargo build\"", "expect": "ineligible:nested_interpreter", "note": "bash -c wrapper" },
    { "command": "sh -c 'cargo build'", "expect": "ineligible:nested_interpreter", "note": "sh -c wrapper" },
    { "command": "env CARGO=x cargo build", "expect": "ineligible:nested_interpreter", "note": "env wrapper" },
    { "command": "sudo cargo build", "expect": "ineligible:nested_interpreter", "note": "sudo wrapper" },
    { "command": "xargs cargo build", "expect": "ineligible:nested_interpreter", "note": "xargs wrapper" },
    { "command": "timeout 60 cargo build", "expect": "ineligible:nested_interpreter", "note": "timeout wrapper" },
    { "command": "/usr/local/bin/cargo build -p foo", "expect": "ineligible:absolute_path", "note": "absolute-path executable" },
    { "command": "cargo \"build -p foo", "expect": "ineligible:parse_error", "note": "unbalanced quote" },
    { "command": "", "expect": "ineligible:parse_error", "note": "empty command" },
    { "command": "    ", "expect": "ineligible:parse_error", "note": "whitespace-only command" }
  ]
}
