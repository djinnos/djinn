{
  "version": "typed_evidence_lifecycle_v1",
  "allowed_transitions": [
    ["demanded", "spike_active"], ["demanded", "withdrawn"],
    ["spike_active", "evidence_received"], ["spike_active", "failed"],
    ["spike_active", "withdrawn"], ["evidence_received", "resolved"],
    ["evidence_received", "withdrawn"], ["failed", "demanded"],
    ["failed", "spike_active"], ["failed", "withdrawn"]
  ],
  "unresolved": ["demanded", "spike_active", "evidence_received", "failed"],
  "terminal_controls": {
    "generic_transition_error": "terminal transitions require dispose_in_transaction",
    "resolved_requires": ["judge_attribution", "committed_folding_revision"],
    "withdrawn_requires": ["judge_attribution", "committed_folding_revision", "nonempty_rationale", "non_load_bearing_assertion"]
  },
  "scenarios": [
    "identical_demand_idempotent", "distinct_demand_no_write_conflict",
    "cross_revision_n_n1_n2_blocking", "persisted_nonterminal_transition",
    "unlisted_transition_rejected", "generic_terminal_transition_rejected",
    "resolved_requires_judge_and_committed_folding_revision",
    "withdrawn_requires_rationale_and_non_load_bearing_assertion",
    "resolved_and_withdrawn_clear_unresolved_projection", "append_only_history"
  ],
  "conflict_error": "active_evidence_conflict"
}
