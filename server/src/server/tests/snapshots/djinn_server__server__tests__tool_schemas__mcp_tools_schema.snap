        "epics_closed": {
          "description": "Target epic closed, or that would be closed in preview.",
          "format": "int64",
          "type": "integer"
        },
        "error": {
          "nullable": true,
          "type": "string"
        },
        "merged_tasks": {
          "default": [],
          "description": "Task UUIDs in the target epic that have merged work and caused a block.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ok": {
          "type": "boolean"
        },
        "preview": {
          "description": "`true` when this was a dry-run that did not mutate anything.",
          "type": "boolean"
        },
        "proposal_id": {
          "nullable": true,
          "type": "string"
        },
        "sessions_killed": {
          "description": "Running target-epic worker sessions killed, or live sessions in preview.",
          "format": "int64",
          "type": "integer"
        },
        "tasks_closed": {
          "description": "Target-epic tasks force-closed, or open target-epic tasks in preview.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "ok",
        "preview",
        "blocked",
        "epics_closed",
        "tasks_closed",
        "sessions_killed"
      ],
      "title": "ProposalReconcileObsoleteEpicResponse",
      "type": "object"
    }
  },
