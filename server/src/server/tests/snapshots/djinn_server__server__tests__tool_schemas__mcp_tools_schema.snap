  {
    "name": "memory_list",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "depth": {
          "description": "Depth control: 0 = unlimited, 1 = exact folder (default), N = N levels.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "folder": {
          "description": "Filter by folder. Omit to list all notes.",
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "type": "string"
        },
        "status": {
          "description": "Explicit lifecycle status filter. Defaults to active; use archived or\ndeprecated to list non-live notes.",
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "description": "Filter by note type (e.g. \"adr\", \"reference\", \"research\").",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "project"
      ],
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "NoteCompact": {
          "description": "Compact note summary (no full content) for list and recent queries.",
          "properties": {
            "folder": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "note_type": {
              "type": "string"
            },
            "permalink": {
              "type": "string"
            },
            "scope_paths": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "updated_at": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "permalink",
            "title",
            "note_type",
            "folder",
            "status",
            "updated_at",
            "scope_paths"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "items": {
            "$ref": "#/$defs/NoteCompact"
          },
          "type": "array"
        }
      },
      "required": [
        "notes"
      ],
      "type": "object"
    }
  },
  {
    "name": "memory_move",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "identifier": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "title": {
          "description": "Optional new title; keep current title if omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "description": "New note type to move the note to. Use `proposed_adr` to recover a\nmis-routed ADR draft into `.djinn/decisions/proposed/`.",
          "type": "string"
        }
      },
      "required": [
        "project",
        "identifier",
        "type"
      ],
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "MemoryProposalRefItem": {
          "properties": {
            "id": {
              "type": "string"
            },
            "short_id": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "short_id",
            "title",
            "status"
          ],
          "type": "object"
        },
        "MemoryTaskRefItem": {
          "properties": {
            "id": {
              "type": "string"
            },
            "short_id": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "short_id",
            "title",
            "status"
          ],
          "type": "object"
        },
        "ResolvedMention": {
          "properties": {
            "entity_type": {
