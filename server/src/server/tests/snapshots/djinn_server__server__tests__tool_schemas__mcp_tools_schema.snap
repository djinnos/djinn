          "description": "Filter by author user id.",
          "type": [
            "string",
            "null"
          ]
        },
        "include_bodies": {
          "description": "When `true`, include the full `body` string on each list row.\nDefault `false` — rows omit the full body and carry only\n`body_excerpt` (first 512 Unicode scalars) and `body_truncated`.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "limit": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "offset": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "sort": {
          "description": "Sort order: \"created_desc\" (default), \"created\", \"updated\", \"updated_desc\".",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_project": {
          "description": "Filter to proposals targeting this project (UUID or owner/repo slug).",
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "description": "Full-text search on title and body.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "output_schema": {
