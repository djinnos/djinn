        "error": {
          "nullable": true,
          "type": "string"
        },
        "rules": {
          "description": "Verification rules from the `project_verifications` table (migration\n44). Empty when the project has none.",
          "items": {
            "$ref": "#/$defs/VerificationRule"
          },
          "type": "array"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
