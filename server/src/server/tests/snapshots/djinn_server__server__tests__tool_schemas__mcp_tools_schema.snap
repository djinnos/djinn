                  "nullable": true
                }
              ],
              "default": null
            },
            "java": {
              "anyOf": [
                {
                  "$ref": "#/$defs/JavaLanguage"
                },
                {
                  "const": null,
                  "nullable": true
                }
              ],
              "default": null
            },
            "node": {
              "anyOf": [
                {
