      ],
      "type": "object"
    }
  },
  {
    "name": "memory_build_context",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "budget": {
          "description": "Token budget for context (default 4096). Seed notes are uncapped.",
          "format": "int64",
          "type": "integer"
        },
        "depth": {
          "description": "Link traversal depth (default 1).",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "edge_kinds": {
          "description": "Optional list of edge kinds to include in graph traversal scoring.\nWhen provided, only edges whose `kind` matches one of these values\nparticipate in spreading activation. Omit to use all edge kinds.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "max_related": {
          "description": "Maximum related notes to return (default 10).",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "min_confidence": {
          "description": "Minimum confidence threshold for related notes (default 0.1). Notes\nbelow this threshold are excluded from the context response. Set to 0.0\nto include all notes regardless of confidence.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "project": {
          "type": "string"
        },
        "task_id": {
          "description": "Optional task ID for task-affinity scoring in RRF retrieval.",
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "description": "Memory URI: \"memory://folder/note\", \"folder/note\", or \"folder/*\" for all\nnotes in a folder.",
          "type": "string"
        }
      },
      "required": [
        "project",
        "url",
        "budget"
      ],
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "ContradictsAnnotation": {
          "description": "Annotation that a candidate note is contradicted by another note.",
          "properties": {
            "edge_kind": {
              "type": "string"
            },
            "note_id": {
              "type": "string"
            }
          },
          "required": [
            "note_id",
            "edge_kind"
          ],
          "type": "object"
        },
        "MemoryNoteView": {
          "properties": {
            "content": {
              "type": "string"
            },
            "created_at": {
              "type": "string"
            },
            "file_path": {
              "type": "string"
            },
            "folder": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "last_accessed": {
              "type": "string"
            },
            "note_type": {
              "type": "string"
            },
            "permalink": {
              "type": "string"
            },
            "project_id": {
              "type": "string"
            },
            "retrieval_anchor": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "type": "string"
            },
            "tags": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "title": {
              "type": "string"
            },
            "updated_at": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "project_id",
            "permalink",
            "title",
            "file_path",
            "note_type",
            "folder",
            "status",
            "tags",
            "content",
            "created_at",
            "updated_at",
            "last_accessed"
          ],
          "type": "object"
        },
        "MemoryProposalOverview": {
          "description": "Compact proposal overview for `memory_build_context` responses.\n\n**Progressive disclosure:** this overview ships `title` +\n`acceptance_criteria` so the planner can decide whether to fetch the\nfull body via `proposal_show`. The full proposal body is intentionally\nexcluded to keep prompt context lean.",
          "properties": {
            "acceptance_criteria": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "body_format": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "score": {
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "short_id": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "short_id",
            "title",
            "body_format",
            "acceptance_criteria",
            "status"
          ],
          "type": "object"
        },
        "NoteAbstract": {
          "description": "L0 note abstract payload used in tiered context responses.",
          "properties": {
            "abstract_text": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "note_type": {
              "type": "string"
            },
            "permalink": {
              "type": "string"
            },
            "score": {
              "format": "float",
              "type": [
                "number",
                "null"
              ]
            },
            "superseded": {
              "description": "True when this note has been superseded by a newer note (stale-citation\nconfidence signal applied). Consumers should treat the content as\npotentially outdated.",
              "type": "boolean"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "permalink",
            "title",
            "note_type",
            "abstract_text"
          ],
          "type": "object"
        },
        "NoteOverview": {
          "description": "L1 note overview payload used in tiered context responses.",
          "properties": {
            "id": {
              "type": "string"
            },
            "note_type": {
              "type": "string"
            },
            "overview_text": {
              "type": "string"
            },
            "permalink": {
              "type": "string"
            },
            "score": {
              "format": "float",
              "type": [
                "number",
                "null"
              ]
            },
            "superseded": {
              "description": "True when this note has been superseded by a newer note (stale-citation\nconfidence signal applied). Consumers should treat the content as\npotentially outdated.",
              "type": "boolean"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "permalink",
            "title",
            "note_type",
            "overview_text"
          ],
          "type": "object"
        },
        "SupersedesAnnotation": {
          "description": "Annotation that a candidate note is superseded by another note.",
          "properties": {
            "edge_kind": {
              "type": "string"
            },
            "superseded_by": {
              "description": "The note ID of the newer note that supersedes the candidate.",
              "type": "string"
            }
          },
          "required": [
            "superseded_by",
            "edge_kind"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "contradicts": {
          "description": "Notes in the context set that have a contradicting relationship.",
          "items": {
            "$ref": "#/$defs/ContradictsAnnotation"
          },
          "type": "array"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "primary": {
          "items": {
            "$ref": "#/$defs/MemoryNoteView"
          },
          "type": "array"
        },
        "proposals": {
          "description": "Proposals relevant to the seed note, surfaced as related entities with\nprogressive disclosure (title + acceptance criteria as the overview;\ncall `proposal_show` for the full body).",
          "items": {
            "$ref": "#/$defs/MemoryProposalOverview"
          },
          "type": "array"
        },
        "related_l0": {
          "items": {
            "$ref": "#/$defs/NoteAbstract"
          },
          "type": "array"
        },
        "related_l1": {
          "items": {
            "$ref": "#/$defs/NoteOverview"
          },
          "type": "array"
        },
        "supersedes": {
          "description": "Notes in the context set that are superseded by another note in the set.",
          "items": {
            "$ref": "#/$defs/SupersedesAnnotation"
          },
          "type": "array"
        }
      },
      "required": [
        "primary",
        "related_l1",
        "related_l0"
      ],
      "type": "object"
    }
  },
