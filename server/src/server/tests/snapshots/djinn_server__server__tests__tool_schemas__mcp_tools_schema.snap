  {
    "name": "code_graph",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$defs": {
        "BoundaryRule": {
          "description": "A single boundary-check rule — a pair of globs. Every rule is\ntreated as a forbidden edge; callers submit only the rules they want\nflagged as violations.",
          "properties": {
            "description": {
              "description": "Optional human-readable explanation of why this rule exists,\nsurfaced in CI output so violations are self-documenting.",
              "type": [
                "string",
                "null"
              ]
            },
            "from_glob": {
              "type": "string"
            },
            "to_glob": {
              "type": "string"
            }
          },
          "required": [
            "from_glob",
            "to_glob"
          ],
          "type": "object"
        },
        "ChangedRange": {
          "description": "A single `(file, start_line, end_line)` hunk from a parsed diff. The\ncaller supplies one of these per `git diff --unified=0` hunk when\ninvoking the `diff_touches` op on the `code_graph` tool.",
          "properties": {
            "end_line": {
              "description": "Inclusive 1-indexed last line of the hunk. Defaults to `start_line`\nwhen the caller passed a single-line hunk.",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "file": {
              "description": "Repository-relative path of the file the hunk lives in.",
              "type": "string"
            },
            "start_line": {
              "description": "Inclusive 1-indexed first line of the hunk.",
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "file",
            "start_line"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "by_depth_counts": {
          "default": null,
          "description": "df6s: per-depth counts for `impact`. When `Some(true)`, the\nresponse ships a `by_depth_counts: { \"1\": 12, \"2\": 7 }` map\nalongside the (sliced) impact list so triage can read the\ndepth distribution without walking every entry. Honoured by\n`impact` only; other ops ignore it. `summary_only=true`\nalready implies this — passing both is fine.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "changed_files": {
          "default": null,
          "description": "Repository-relative file paths for `detect_changes` when no\nSHA range is supplied (or as a coarser fallback). Every symbol\nin each listed file is treated as potentially touched.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "changed_ranges": {
          "default": null,
          "description": "List of `(file, start_line, end_line?)` hunks for `diff_touches`.",
          "items": {
            "$ref": "#/$defs/ChangedRange"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "confidence": {
          "default": null,
          "description": "Confidence tier for `dead_symbols`: `high`, `med`, or `low`.\nDefault `high`.",
          "type": [
            "string",
            "null"
          ]
        },
        "context_filter": {
          "default": null,
          "description": "Optional coarse context substring for `query_subgraph`. Use this to\nnarrow the natural-language subgraph query to a subsystem, API, type,\nor concern when the initial response is too broad; returned\n`narrowing_hints` may suggest values for this field.",
          "type": [
            "string",
            "null"
          ]
        },
        "current_head": {
          "default": null,
          "description": "jc47: the caller's current HEAD / git commit SHA. When supplied,\nevery successful `code_graph` response includes an additive\n`graph_staleness` object comparing this commit against the cached\ngraph blob's pinned commit. Omit to keep the previous response\nshape (no `graph_staleness` field). Empty/whitespace values are\nnormalized to `None` so clients that serialize every field as `\"\"`\ndon't accidentally trigger staleness computation. `caller_commit`\nand `currentHead` are accepted as aliases.",
          "type": [
            "string",
            "null"
          ]
        },
        "direction": {
          "default": null,
          "description": "Edge direction filter for `neighbors`: `incoming`, `outgoing`, or omit for both.",
          "type": [
            "string",
            "null"
          ]
        },
        "edge_filters": {
          "default": null,
          "description": "Optional explicit edge kinds for `query_subgraph` traversal. Omit to\nlet the planner infer edge kinds from the question; provide values such\nas calls/imports/returns/reads/writes/implements/extends to narrow the\nbounded subgraph. `edge_kind` is accepted as a single-kind compatibility\nalias when this list is omitted.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "edge_kind": {
          "default": null,
          "description": "Optional edge-kind filter for `edges`; for `query_subgraph`, a\nsingle-kind compatibility alias used when `edge_filters` is omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "end_line": {
          "default": null,
          "description": "1-indexed inclusive end line for `symbols_at`. Defaults to\n`start_line` when omitted.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "file": {
          "default": null,
          "description": "Repository-relative file path for `symbols_at`.",
          "type": [
            "string",
            "null"
          ]
        },
        "file_filter": {
          "default": null,
          "description": "Optional repository-relative path/file substring filter for\n`query_subgraph`. It narrows seed selection and traversal to matching\nfile paths. `file_glob` is also accepted as a compatibility alias and\nis used when `file_filter` is omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "file_glob": {
          "default": null,
          "description": "Optional file glob restricting `hotspots` to a subset of paths. For\n`query_subgraph`, a path-filter compatibility alias used when\n`file_filter` is omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "framework": {
          "default": null,
          "description": "Optional route framework filter for `route_map` discovery.",
          "type": [
            "string",
            "null"
          ]
        },
        "from": {
          "default": null,
          "description": "Source node for `path`.",
          "type": [
            "string",
            "null"
          ]
        },
        "from_glob": {
          "default": null,
          "description": "Source path glob for `edges`.",
          "type": [
            "string",
            "null"
          ]
        },
        "from_sha": {
          "default": null,
          "description": "Base SHA for `detect_changes`. When paired with `to_sha`, the\nop runs `git diff --unified=0 from_sha..to_sha` and maps the\nresulting hunks to symbols. Mutually exclusive with\n`changed_files` only when both are absent — when both are\nprovided, line-level wins.",
          "type": [
            "string",
            "null"
          ]
        },
        "group_by": {
          "default": null,
          "description": "Group results: only `file` is supported. Applies to `impact`/`neighbors`.",
          "type": [
            "string",
            "null"
          ]
        },
        "impact_targets": {
          "default": null,
          "description": "Proposed removals/renames for `impact_check`. Each entry is a\nsymbol key, repository-relative file path, or crate name whose\ncompile-time consumers should be analysed. The handler\nauto-detects whether a target is a crate (by checking the crate\ngraph) or a symbol/file (resolved through the canonical graph).",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "include_content": {
          "default": null,
          "description": "PR C1: when `true`, the `context` op populates\n`symbol_context.symbol.content` with the symbol's body text\nread from the project clone. Default `false` — bandwidth\nmatters; clients that already have the file open don't need\nthe body shipped over MCP.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "include_optional": {
          "default": null,
          "description": "Include optional response fields when computing `shape_check` drift.\nDefaults to `false`.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "key": {
          "default": null,
          "description": "The node key to query (file path or SCIP symbol string).\nRequired for `neighbors`, `impact`, `implementations`, and `describe`.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind_filter": {
          "default": null,
          "description": "Kind filter, op-specific:\n- `ranked` / `search` / `cycles` / `orphans`: node kind — `file` or\n  `symbol`.\n- `query_subgraph`: node-kind narrowing for seeds/traversal — `file`\n  or `symbol`.\n- `neighbors`: edge kind — `reads` or `writes` (PR A3). Restricts\n  the response to neighbors connected by `Reads` / `Writes` edges\n  only, so callers can ask for \"who writes to field X\" without\n  post-filtering.\n- `flow`: flow-hit tier — `process` or `step`.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind_hint": {
          "default": null,
          "description": "PR C2: optional kind hint biasing the C2 disambiguation score\nwhen `key` is a short identifier (e.g. `\"User\"`) and the\nresolver hits multiple candidates. Accepts the same labels the\nresolver emits: `\"file\"`, `\"class\"`, `\"interface\"`, `\"function\"`,\n`\"method\"`, `\"struct\"`, `\"enum\"`, etc.",
          "type": [
            "string",
            "null"
          ]
        },
        "level": {
          "default": null,
          "description": "Semantic zoom level for `snapshot`: `symbol` keeps the existing\nfile/symbol-node payload shape; `community` is accepted for forward\ncompatibility with the collapsed community view.",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "default": null,
          "description": "Maximum results for list operations. Defaults are op-specific:\n`ranked`/`search`/`neighbors`/`flow` default 20, `route_map`/\n`api_impact` default 50, `edges` default 100. For `impact`, this is\nmax traversal depth (default 3). Negative values are treated as zero by\nlegacy ops; new route/API/flow ops reject negative limits.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "max_depth": {
          "default": null,
          "description": "Optional max depth. For `path`, bounds shortest-path search depth. For\n`query_subgraph`, bounds traversal depth from selected seeds; omit to\nuse the backend default (currently 2). Values are clamped into 0..=8, so 0 means seed\nnodes only and larger values are capped at 8.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "max_files_per_commit": {
          "default": null,
          "description": "Max files per commit before a commit is skipped in the\n`coupling_hotspots` / `coupling_hubs` aggregation. Default 15.\nProtects the pair-count signal from lockfile refreshes,\ncodemods, and similar bulk rewrites that contribute `N^2`\npairs with essentially zero real coupling information.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "max_seeds": {
          "default": null,
          "description": "Maximum seed count for `query_subgraph`. Omit to use the backend\ndefault (currently 6). Positive values are clamped into 1..=32; zero/negative values\nare rejected. Returned seed debug metadata explains which seeds were\nselected and why.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "method": {
          "default": null,
          "description": "HTTP method for route-aware ops (`route_map`, `shape_check`,\n`api_impact`) when `route_id` is not supplied.",
          "type": [
            "string",
            "null"
          ]
        },
        "min_confidence": {
          "default": null,
          "description": "Minimum edge confidence in `[0, 1]` for the `impact` BFS frontier\n(PR A2). Edges below this threshold are skipped — useful for\nexcluding `local`-prefixed references and other low-confidence SCIP\nsignals from the blast radius. Omit to keep every edge regardless of\nconfidence (default behaviour).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "min_size": {
          "default": null,
          "description": "Minimum SCC size for `cycles` (default 2).",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "mode": {
          "default": null,
          "description": "PR B4: search mode for the `search` op. `\"name\"` (the legacy\nfast path) runs the canonical-graph name index only;\n`\"hybrid\"` blends lexical (`code_chunks` LIKE), semantic\n(Qdrant cosine), and structural signals via RRF k=60. The\neffective default is read from `DJINN_CODE_GRAPH_SEARCH_DEFAULT_MODE`\n(defaults to `\"name\"`); pass an explicit value to override.\nIgnored by every other op.",
          "type": [
            "string",
            "null"
          ]
        },
        "module_glob": {
          "default": null,
          "description": "Optional module-path glob for `api_surface` (filter symbols by\n`file_path`).",
          "type": [
            "string",
            "null"
          ]
        },
        "offset": {
          "default": null,
          "description": "df6s: page offset for paginated traversal ops (`neighbors`,\n`impact`, `coupling_hotspots`). Sliced **only** when\nconstructing the agent-facing response DTO — the underlying\n`RepoDependencyGraph` traversal always runs to completion so\n`total` reflects the unsliced result count and pagination can\nnever be misread as \"the graph has no more nodes\". Empty\nstring is normalized to `None` via `normalize()`. Negative\nvalues are clamped to zero at the handler boundary.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "operation": {
          "description": "The operation to perform.\nOne of: `neighbors`, `ranked`, `impact`, `implementations`,\n`search`, `query_subgraph`, `route_map`, `shape_check`,\n`api_impact`, `flow`, `cycles`, `orphans`, `path`, `edges`,\n`symbols_at`, `diff_touches`, `detect_changes`, `describe`,\n`context`, `status`, `snapshot`, `workspaces`, and the other\ngraph analysis ops.",
          "type": "string"
        },
        "page_limit": {
          "default": null,
          "description": "df6s: distinct result cap for paginated traversal ops. For\n`neighbors` / `coupling_hotspots` this is the existing `limit`\n(re-aliased for clarity), so the field is **only** consumed by\nops where `limit` means something else — currently `impact`,\nwhere `limit` is the BFS depth. `impact` therefore reads\n`page_limit` for its result cap and keeps `limit` as the\ntraversal depth. Defaults to 100 when omitted; clamps to\n`[1, 1000]`. Sliced only at the response-DTO layer; the\ninternal traversal still runs to completion.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "path": {
          "default": null,
          "description": "Exact route path for `shape_check` / `api_impact` when `route_id` is\nnot supplied.",
          "type": [
            "string",
            "null"
          ]
        },
        "path_glob": {
          "default": null,
          "description": "Route path glob for `route_map` discovery.",
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "description": "Project identifier — either the UUID (`project_id`) or the\ncanonical `\"owner/repo\"` slug. The handler resolves it to the\nserver-managed clone path via `djinn_core::paths::project_dir`\nbefore dispatching to the graph backend.",
          "type": "string"
        },
        "query": {
          "default": null,
          "description": "Query text, op-specific:\n- `search`: substring/name lookup text.\n- `query_subgraph`: required nonblank natural-language question used\n  to pick relevant seeds and infer useful traversal edge kinds.\n- `flow`: required nonblank natural-language query re-ranked over\n  process/step matches.",
          "type": [
            "string",
            "null"
          ]
        },
        "route_id": {
          "default": null,
          "description": "Stable route id for route-aware ops. For `shape_check` and\n`api_impact`, callers must provide either `route_id` or both\n`method` and `path`.",
          "type": [
            "string",
            "null"
          ]
        },
        "rules": {
          "default": null,
          "description": "Boundary rules for `boundary_check`.",
          "items": {
            "$ref": "#/$defs/BoundaryRule"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "scope_crates": {
          "default": null,
          "description": "Crate names in the proposed task slice for `impact_check`. Used\nto determine `safe_independent_slice`: true only when every\naffected consumer crate is within this set. Omit to treat the\nproposed changes as crate-only (safe_independent_slice is true\nwhen no external crate consumers are found).",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "seed_entries": {
          "default": null,
          "description": "Entry-point symbol keys (route handlers, `main`, etc.) for\n`touches_hot_path`.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "seed_sinks": {
          "default": null,
          "description": "Sink symbol keys (DB queries, external APIs, etc.) for\n`touches_hot_path`.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "since_days": {
          "default": null,
          "description": "Time-window (in days) for the `churn` op. Omit for all-time.\nClamped to `[1, 3650]` server-side.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "sort_by": {
          "default": null,
          "description": "Sort key for `ranked`: `pagerank` (default), `in_degree`, `out_degree`,\nor `total_degree`.",
          "type": [
            "string",
            "null"
          ]
        },
        "start_line": {
          "default": null,
          "description": "1-indexed inclusive start line for `symbols_at`.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "summary_only": {
          "default": null,
          "description": "df6s: counts-only mode for paginated traversal ops\n(`neighbors`, `impact`, `coupling_hotspots`). When `Some(true)`,\nthe response omits the large node/pair lists and instead ships\n`total` + the relevant counters (`by_depth_counts` for impact).\nDesigned for triage: a model can ask \"how big is the blast\nradius?\" without paying the token cost of every impacted\nsymbol. The internal traversal still runs to completion so\ngroup_by-file rollups report the full per-module count.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "symbols": {
          "default": null,
          "description": "Queried symbol keys for `touches_hot_path` — which sit on any\nentry→sink shortest path?",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "target": {
          "default": null,
          "description": "Iter 28: target tier for the `complexity` op — `\"functions\"`\n(default) or `\"files\"`. The `functions` shape ranks individual\nfunction-like symbols; the `files` shape aggregates by file_path\nand returns per-file totals + worst-offender info. Reuses the\nshared `sort_by`, `file_glob`, and `limit` fields.",
          "type": [
            "string",
            "null"
          ]
        },
        "tests": {
          "default": null,
          "description": "v10: test-file filter. `\"include\"` (default for `snapshot` —\nreturns the whole graph), `\"exclude\"` (drop every node the graph\nbuilder marked `is_test`), or `\"only\"` (keep only test nodes).\nTest classification is the canonical `RepoGraphNode::is_test`\nflag (file-path convention OR SCIP `Test` role). Currently\nhonoured by the `snapshot` op; other ops keep their existing\ntest-handling.",
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "default": null,
          "description": "Destination node for `path`.",
          "type": [
            "string",
            "null"
          ]
        },
        "to_glob": {
          "default": null,
          "description": "Destination path glob for `edges`.",
          "type": [
            "string",
            "null"
          ]
        },
        "to_sha": {
          "default": null,
          "description": "Head SHA for `detect_changes`.",
          "type": [
            "string",
            "null"
          ]
        },
        "token_budget": {
          "default": null,
          "description": "Approximate response token budget for `query_subgraph`. Omit to use\nthe backend default (currently about 2000 tokens). Positive values below 1024 are clamped up to 1024,\nvalues above 32000 are clamped down to 32000, and zero/negative values\nare rejected. The result reports budget/truncation state so callers can\nretry with a narrower filter or a different budget.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "visibility": {
          "default": null,
          "description": "Visibility filter for `orphans`: `public`, `private`, or `any` (default).",
          "type": [
            "string",
            "null"
          ]
        },
        "window_days": {
          "default": null,
          "description": "Churn look-back window in days for `hotspots` (default 90, clamped\nto 365).",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "workspace": {
          "default": null,
          "description": "Optional workspace slug. Empty string is normalized to omitted. Use\n`operation = \"workspaces\"` to enumerate valid slugs and metadata\n(`slug`, `name`, `node_count`, `commit_sha`, `warmed_at`, `status`).\nKnown workspaces hard-scope listing/bounded ops such as `ranked`,\n`orphans`, `snapshot`, and `api_surface`. Traversal ops such as\n`impact`, `path`, `touches_hot_path`, and `query_subgraph` use the\nworkspace only while resolving seeds/endpoints, then keep the traversal\ncross-workspace so blast radius stays visible. Unknown non-empty slugs\nreturn unscoped results with `workspace_hint` candidate slugs where the\nresponse type supports hints; single-workspace graphs treat the parameter\nas a no-op.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "operation",
        "project"
      ],
      "type": "object"
    },
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": true,
      "type": "object"
    }
  },
  {
    "name": "credential_delete",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "key_name": {
          "description": "Env-var style key name of the credential to delete (e.g. 'ANTHROPIC_API_KEY').",
          "type": "string"
        }
      },
      "required": [
        "key_name"
      ],
      "type": "object"
    },
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "deleted": {
          "type": "boolean"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "key_name": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "success": {
          "type": "boolean"
        }
      },
      "required": [
        "ok",
        "success",
        "deleted",
        "key_name"
      ],
      "type": "object"
    }
  },
  {
    "name": "credential_list",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "target_user_id": {
          "default": null,
          "description": "Admin-only: act on behalf of this user id (e.g. another user to\nconfigure). Non-admins must omit it.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "CredentialSummary": {
          "properties": {
            "created_at": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "key_name": {
              "type": "string"
            },
            "provider_id": {
              "type": "string"
            },
            "updated_at": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "provider_id",
            "key_name",
            "created_at",
            "updated_at"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "credentials": {
          "items": {
            "$ref": "#/$defs/CredentialSummary"
          },
          "type": "array"
        }
      },
      "required": [
        "credentials"
      ],
      "type": "object"
    }
  },
  {
    "name": "credential_set",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "api_key": {
          "description": "The raw API key value to store encrypted.",
          "type": "string"
        },
        "key_name": {
          "description": "Env-var style key name (e.g. 'ANTHROPIC_API_KEY').",
          "type": "string"
        },
        "org_shared": {
          "default": false,
          "description": "Admin path: when `true`, store this as the ORG-SHARED fallback\ncredential (`owner_user_id = NULL`) that any user without a personal\ncredential for the same key_name will resolve. When `false`/absent, the\ncredential is stamped private to the acting user (the connect-flow\ndefault). Defaults to `false`.",
          "type": "boolean"
        },
        "provider_id": {
          "description": "Provider ID this key belongs to (e.g. 'anthropic', 'openai').",
          "type": "string"
        },
        "target_user_id": {
          "default": null,
          "description": "Admin-only: act on behalf of this user id (e.g. another user to\nconfigure). Non-admins must omit it.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "provider_id",
        "key_name",
        "api_key"
      ],
      "type": "object"
    },
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "key_name": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "success": {
          "type": "boolean"
        }
      },
      "required": [
        "ok",
        "success",
        "id",
        "key_name"
      ],
      "type": "object"
    }
  },
  {
    "name": "dispatch_pause",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$defs": {
        "DispatchPauseScope": {
          "description": "Dispatch pause scope supported by the persistence layer.",
          "enum": [
            "global",
            "project",
            "user"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "reason": {
          "description": "Non-empty administrative reason recorded with the pause.",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/DispatchPauseScope",
          "description": "Pause scope: `global`, `project`, or `user`."
        },
        "target_id": {
          "default": null,
          "description": "Required for `project` and `user`; must be omitted for `global`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "scope",
        "reason"
      ],
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "DispatchPause": {
          "additionalProperties": false,
          "description": "Metadata recorded when dispatch is paused for a scope.",
          "properties": {
            "expires_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "paused_at": {
              "type": "string"
            },
            "paused_by": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "paused_by",
            "paused_at",
            "reason"
          ],
          "type": "object"
        },
        "DispatchPauseScope": {
          "description": "Dispatch pause scope supported by the persistence layer.",
          "enum": [
            "global",
            "project",
            "user"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "changed": {
          "type": "boolean"
        },
        "current": {
          "anyOf": [
            {
              "$ref": "#/$defs/DispatchPause"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "ok": {
          "type": "boolean"
        },
        "previous": {
          "anyOf": [
            {
              "$ref": "#/$defs/DispatchPause"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "$ref": "#/$defs/DispatchPauseScope"
        },
        "target_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "ok",
        "changed",
        "scope"
      ],
      "type": "object"
    }
  },
  {
    "name": "dispatch_pause_status",
    "read_only": true,
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$defs": {
        "DispatchPauseScope": {
          "description": "Dispatch pause scope supported by the persistence layer.",
          "enum": [
            "global",
            "project",
            "user"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/DispatchPauseScope"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional scope filter. Omit to return all pause scopes."
        },
        "target_id": {
          "default": null,
          "description": "Required when filtering `project` or `user`; invalid for `global`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "DispatchPause": {
          "additionalProperties": false,
          "description": "Metadata recorded when dispatch is paused for a scope.",
          "properties": {
            "expires_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "paused_at": {
              "type": "string"
            },
            "paused_by": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "paused_by",
            "paused_at",
            "reason"
          ],
          "type": "object"
        },
        "DispatchPauseScope": {
          "description": "Dispatch pause scope supported by the persistence layer.",
          "enum": [
            "global",
            "project",
            "user"
          ],
          "type": "string"
        },
        "DispatchPauseState": {
          "additionalProperties": false,
          "description": "Snapshot of dispatch pause state across all scopes.",
          "properties": {
            "global": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DispatchPause"
                },
                {
                  "type": "null"
                }
              ]
            },
            "projects": {
              "additionalProperties": {
                "$ref": "#/$defs/DispatchPause"
              },
              "default": {},
              "type": "object"
            },
            "users": {
              "additionalProperties": {
                "$ref": "#/$defs/DispatchPause"
              },
              "default": {},
              "type": "object"
            }
          },
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "current": {
          "anyOf": [
            {
              "$ref": "#/$defs/DispatchPause"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "ok": {
          "type": "boolean"
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/DispatchPauseScope"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/DispatchPauseState"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "ok"
      ],
      "type": "object"
    }
  },
  {
    "name": "dispatch_resume",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$defs": {
        "DispatchPauseScope": {
          "description": "Dispatch pause scope supported by the persistence layer.",
          "enum": [
            "global",
            "project",
            "user"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "$ref": "#/$defs/DispatchPauseScope",
          "description": "Resume scope: `global`, `project`, or `user`."
        },
        "target_id": {
          "default": null,
          "description": "Required for `project` and `user`; must be omitted for `global`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "scope"
      ],
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "DispatchPause": {
          "additionalProperties": false,
          "description": "Metadata recorded when dispatch is paused for a scope.",
          "properties": {
            "expires_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "paused_at": {
              "type": "string"
            },
            "paused_by": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "paused_by",
            "paused_at",
            "reason"
          ],
          "type": "object"
        },
        "DispatchPauseScope": {
          "description": "Dispatch pause scope supported by the persistence layer.",
          "enum": [
            "global",
            "project",
            "user"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "changed": {
          "type": "boolean"
        },
        "current": {
          "anyOf": [
            {
              "$ref": "#/$defs/DispatchPause"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "ok": {
          "type": "boolean"
        },
        "previous": {
          "anyOf": [
            {
              "$ref": "#/$defs/DispatchPause"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "$ref": "#/$defs/DispatchPauseScope"
        },
        "target_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "ok",
        "changed",
        "scope"
      ],
      "type": "object"
    }
  },
  {
    "name": "doctor_fix",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "check_name": {
          "description": "The stable name of the check that owns the finding. Must match the\n`check_name` stored on the persisted finding row.",
          "type": "string"
        },
        "finding_id": {
          "description": "The persisted finding id (UUIDv7) to fix.",
          "type": "string"
        }
      },
      "required": [
        "check_name",
        "finding_id"
      ],
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "AnyJson": {}
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "check_name": {
          "type": "string"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "finding_id": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnyJson"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ok",
        "check_name",
        "finding_id"
      ],
      "type": "object"
    }
  },
  {
    "name": "doctor_list_findings",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "check": {
          "default": null,
          "description": "Optional check name to narrow on (matches `check_name` exactly).",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "default": null,
          "description": "Optional cap on the number of findings returned. Clamped to\n`MAX_RECENT_FINDINGS` (the repository's defensive ceiling) when\nlarger. Defaults to the repository's defensive ceiling when\nomitted.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "since": {
          "default": null,
          "description": "Optional lower-bound timestamp filter. Rows with\n`created_at < since` are excluded. Defaults to \"no time\nfilter\" so callers can ask for \"the last N findings for\nthis check\" without a cutoff.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "AnyJson": {},
        "DoctorListFindingEntry": {
          "description": "One persisted finding surfaced through `doctor_list_findings`.\n\nMirrors [`djinn_db::DoctorFinding`] but uses [`AnyJson`] for the\nfree-form JSON payloads (`entity_ids`, `evidence`,\n`resolver_snapshot`) so the generated JSON Schema is the\nstrict-client-friendly empty schema instead of the bare\n`serde_json::Value` catch-all that strict MCP clients (e.g.\nClaude Code) reject. The fields serialize to the same JSON shape\nas before — the wrapper is `#[serde(transparent)]` and only\nchanges the schema, not the wire format.",
          "properties": {
            "check_name": {
              "type": "string"
            },
            "created_at": {
              "description": "Wall-clock UTC ISO-8601 timestamp the finding was recorded.",
              "type": "string"
            },
            "detail": {
              "description": "Free-form human-readable detail surfaced in reports.",
              "type": [
                "string",
                "null"
              ]
            },
            "entity_ids": {
              "$ref": "#/$defs/AnyJson",
              "description": "Opaque entity ids this finding relates to. Always a JSON array\n(possibly empty) so callers can iterate without inspecting each\nrow's shape."
            },
            "evidence": {
              "$ref": "#/$defs/AnyJson",
              "description": "Structured check-specific evidence. Free-form JSON."
            },
            "id": {
              "description": "Persisted finding id (from `doctor_findings.id`).",
              "type": "string"
            },
            "resolver_snapshot": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AnyJson"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Resolver inputs and outputs captured at check time. `None` for\nchecks with no associated resolver."
            },
            "run_id": {
              "description": "The run that produced this finding. `None` for ad-hoc inserts.",
              "type": [
                "string",
                "null"
              ]
            },
            "severity": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "created_at",
            "check_name",
            "severity",
            "entity_ids",
            "evidence"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "filtered_by_check": {
          "description": "`true` when a filter was applied. Useful for the board / audit\nUI to display \"filtered by check X, since Y\" in the response.",
          "type": "boolean"
        },
        "filtered_by_since": {
          "description": "`true` when a `since` lower bound was applied.",
          "type": "boolean"
        },
        "findings": {
          "description": "Findings that match the request, newest-first. Empty when the\nfilter is too narrow or no findings have been recorded yet.",
          "items": {
            "$ref": "#/$defs/DoctorListFindingEntry"
          },
          "type": "array"
        },
        "limit": {
          "description": "The actual limit used by the query (after the repository\nclamped it to `MAX_RECENT_FINDINGS`).",
          "format": "int64",
          "type": "integer"
        },
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "ok",
        "findings",
        "filtered_by_check",
        "filtered_by_since",
        "limit"
      ],
      "type": "object"
    }
  },
  {
    "name": "doctor_run",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "check_names": {
          "default": null,
          "description": "Optional list of check names to run. When omitted (or empty), all\nregistered checks are run. Unknown names produce a structured error\nlisting the valid check names so the caller can self-correct.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "DoctorRunCheckMeta": {
          "description": "Metadata for one check as surfaced in the run report.",
          "properties": {
            "description": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "description"
          ],
          "type": "object"
        },
        "DoctorRunCheckResult": {
          "description": "Result of one check execution within a run.",
          "properties": {
            "check": {
              "$ref": "#/$defs/DoctorRunCheckMeta"
            },
            "error": {
              "description": "Error message when `ran` is `false`.",
              "type": [
                "string",
                "null"
              ]
            },
            "findings": {
              "description": "Findings emitted by this check, with their persisted ids filled in.",
              "items": {
                "$ref": "#/$defs/DoctorRunFindingEntry"
              },
              "type": "array"
            },
            "ran": {
              "description": "`true` when the check ran without error (even if it emitted zero\nfindings). `false` when the check itself returned an error.",
              "type": "boolean"
            }
          },
          "required": [
            "check",
            "ran",
            "findings"
          ],
          "type": "object"
        },
        "DoctorRunFindingEntry": {
          "description": "One persisted finding as surfaced in the run report.",
          "properties": {
            "check_name": {
              "type": "string"
            },
            "detail": {
              "type": "string"
            },
            "finding_id": {
              "description": "Persisted finding id (from `doctor_findings.id`).",
              "type": "string"
            },
            "recommended_action": {
              "description": "Recommended action for closed-parent orphan findings (e.g. \"close\",\n\"park\", \"retain\"). Omitted for checks that do not produce a recommendation.",
              "type": [
                "string",
                "null"
              ]
            },
            "recommended_reason": {
              "description": "Reason for the recommended action (e.g. \"parent_closed\",\n\"external_open_dependent\"). Omitted for checks that do not produce a recommendation.",
              "type": [
                "string",
                "null"
              ]
            },
            "severity": {
              "type": "string"
            }
          },
          "required": [
            "finding_id",
            "check_name",
            "severity",
            "detail"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "ok": {
          "type": "boolean"
        },
        "registered_checks": {
          "description": "All registered checks known at run time (even ones not selected),\nso the caller can see the full directory.",
          "items": {
            "$ref": "#/$defs/DoctorRunCheckMeta"
          },
          "type": "array"
        },
        "results": {
          "description": "Results for each check that was selected and executed.",
          "items": {
            "$ref": "#/$defs/DoctorRunCheckResult"
          },
          "type": "array"
        },
        "total_findings": {
          "description": "Total number of findings emitted across all selected checks.\n\nCounters are `i64` (not `usize`) so the generated MCP JSON schema\nlands on `format: int64` instead of the nonstandard `uint` pinned by\n`tool_schemas::mcp_tools_list_schemas_do_not_use_nonstandard_uint_…`.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "ok",
        "registered_checks",
        "results",
        "total_findings"
      ],
      "type": "object"
    }
  },
  {
