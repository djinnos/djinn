            }
          ]
        },
        "AcceptanceCriterionStatus": {
          "properties": {
            "criterion": {
              "type": "string"
            },
            "met": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "criterion"
          ],
          "type": "object"
        },
        "EvidenceLifecyclePhase": {
          "description": "Evidence lifecycle phase for a needs-evidence parking.\n\nThis is the inner phase within a `NeedsEvidenceStatus` and describes\nonly the evidence-spike lifecycle. See [`EvidenceLifecycleState`] for\nthe top-level refinement status discriminator that includes Active,\nPausedOrFrozen, and Terminal.",
          "oneOf": [
            {
              "const": "awaiting_evidence",
              "description": "Spike is running, no findings yet.",
              "type": "string"
            },
            {
              "const": "evidence_received",
              "description": "Spike returned structured findings; refinement can resume.",
              "type": "string"
            },
            {
              "const": "evidence_failed",
              "description": "Spike failed (cancelled, errored, force-closed).",
              "type": "string"
            }
          ]
        },
        "EvidenceLifecycleState": {
          "description": "Top-level evidence lifecycle state for the refinement status surface.\n\nDerived from durable proposal fields, debate-trail lifecycle events,\nlinked-spike task status, and admin freeze state — **not** from\nin-memory coordinator state. Downstream control-plane and UI consumers\nuse this discriminator to determine the refinement's effective state\nwithout needing to inspect individual `needs_evidence` sub-fields.\n\nPrecedence (highest → lowest):\n1. `Terminal` — proposal status is done/rejected/archived/superseded.\n2. `PausedOrFrozen` — admin freeze is active (`build_frozen = true`).\n   This takes precedence over active resume wording.\n3. `EvidenceFailed` — persisted failure lifecycle event exists.\n4. `EvidenceReceived` — persisted receipt lifecycle event exists.\n5. `AwaitingEvidence` — open linked evidence spike.\n6. `Active` — refinement is active, no evidence parking.",
          "oneOf": [
            {
              "const": "active",
              "description": "Refinement is active (advocate/adversary/judge loop running).",
              "type": "string"
            },
            {
              "const": "awaiting_evidence",
              "description": "Refinement is parked: an evidence spike is in flight and findings\nhave not yet arrived.",
              "type": "string"
            },
            {
              "const": "evidence_received",
              "description": "Evidence findings have been recorded; refinement may resume once\ndownstream processing completes.",
              "type": "string"
            },
            {
              "const": "evidence_failed",
              "description": "Evidence spike failed or was force-closed; refinement is blocked\nuntil the failure is addressed.",
              "type": "string"
            },
            {
              "const": "paused_or_frozen",
              "description": "The proposal is administratively paused or frozen. Takes precedence\nover all evidence sub-states and active resume wording.",
              "type": "string"
            },
            {
              "const": "terminal",
              "description": "Refinement has reached a terminal outcome (proposal done/rejected/\narchived/superseded).",
              "type": "string"
            }
          ]
        },
        "GateFailureModel": {
          "description": "One DoR failure in the gate status.",
          "properties": {
            "check": {
              "description": "Which high-level check failed (e.g. `problem_coverage`, `vague_acceptance_criteria`).",
              "type": "string"
            },
            "message": {
              "description": "Human-readable failure message.",
              "type": "string"
            }
          },
          "required": [
            "check",
            "message"
          ],
          "type": "object"
        },
        "NeedsEvidenceStatus": {
          "description": "Needs-evidence parking state for a proposal.",
          "properties": {
            "against_revision_seq": {
              "description": "Proposal revision sequence the demand targets.",
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "claim": {
              "description": "The named feasibility claim that the Judge identified.\nFor structured claims this is the `question` field; for legacy\nplain-string claims this is the raw string.",
              "type": "string"
            },
            "created_by_task_id": {
              "description": "The Judge task id that issued the demand.",
              "type": [
                "string",
                "null"
              ]
            },
            "evidence_phase": {
              "anyOf": [
                {
                  "$ref": "#/$defs/EvidenceLifecyclePhase"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Current evidence lifecycle phase (awaiting, received, or failed).\nDerived from persisted `proposal_revisions` lifecycle events.\n`None` when no lifecycle event has been recorded yet."
            },
            "expected_findings": {
              "description": "What the evidence spike should produce to resolve the claim.\nFrom the structured claim's `expected_findings`.\n`None` when `needs_evidence_claim` is a legacy plain string.",
              "type": [
                "string",
                "null"
              ]
            },
            "failure_reason": {
              "description": "For `evidence_failed`, the failure reason (`spike_cancelled`,\n`spike_errored`, `spike_force_closed`, `malformed_findings`, etc.).\n`None` for other phases.",
              "type": [
                "string",
                "null"
              ]
            },
            "insufficient_in_session_research": {
              "description": "Why in-session research was insufficient to resolve the claim.\nFrom the structured claim's `insufficient_in_session_research`.\n`None` when `needs_evidence_claim` is a legacy plain string.",
              "type": [
                "string",
                "null"
              ]
            },
            "question": {
              "description": "The feasibility question the spike must answer (from the structured\nclaim). `None` when `needs_evidence_claim` is a legacy plain string.",
              "type": [
                "string",
                "null"
              ]
            },
            "round": {
              "description": "Debate round when the demand was issued.",
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "spec_unknown_anchor": {
              "description": "What in the spec is unknown/unverified.",
              "type": [
                "string",
                "null"
              ]
            },
            "spike_short_id": {
