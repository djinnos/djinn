          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Why obsolete work is being reconciled. Defaults to a reconcile reason.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "epic_id"
      ],
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "ProposalDispositionSummary": {
          "description": "Auditable aggregate of the shared parent-terminal disposition matrix.\nBoth proposal abort and obsolete-epic reconciliation return this in preview\nand mutation modes so callers can distinguish disposal from safe retention.",
          "properties": {
            "disposed": {
              "format": "int64",
              "type": "integer"
            },
            "parked": {
              "format": "int64",
              "type": "integer"
            },
            "retained_already_terminal": {
              "format": "int64",
              "type": "integer"
            },
            "retained_external_dependent": {
              "format": "int64",
              "type": "integer"
            },
            "retained_other_parent": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "disposed",
            "parked",
            "retained_other_parent",
            "retained_external_dependent",
            "retained_already_terminal"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "blocked": {
          "description": "`true` when merged work in the target epic prevented mutation.",
          "type": "boolean"
        },
        "blocked_feedback_body": {
          "type": [
            "string",
            "null"
          ]
        },
        "blocked_feedback_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "disposition": {
          "$ref": "#/$defs/ProposalDispositionSummary",
          "default": {
            "disposed": 0,
            "parked": 0,
            "retained_already_terminal": 0,
            "retained_external_dependent": 0,
            "retained_other_parent": 0
          },
          "description": "Child-disposition outcomes for the selected epic. Retained findings do\nnot make the reconciliation fail."
        },
        "epic_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "epics_closed": {
          "description": "Target epic closed, or that would be closed in preview.",
          "format": "int64",
          "type": "integer"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "merged_tasks": {
          "default": [],
          "description": "Task UUIDs in the target epic that have merged work and caused a block.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ok": {
          "type": "boolean"
        },
        "preview": {
          "description": "`true` when this was a dry-run that did not mutate anything.",
          "type": "boolean"
        },
        "proposal_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "sessions_killed": {
          "description": "Retained for wire compatibility. Proposal disposition never kills sessions\ndirectly; normal task status-change handling reconciles worker state.",
          "format": "int64",
          "type": "integer"
        },
        "tasks_closed": {
          "description": "Target-epic tasks disposed (closed), or that would be disposed in preview.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "ok",
        "preview",
        "blocked",
        "epics_closed",
        "tasks_closed",
        "sessions_killed"
      ],
      "type": "object"
    }
  },
  {
    "name": "proposal_refinement_demand_evidence",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "against_revision_seq": {
          "description": "The proposal revision sequence the demand targets.",
          "format": "int32",
          "type": "integer"
        },
        "expected_findings": {
          "description": "What the evidence spike should produce to resolve the claim.",
          "type": "string"
        },
        "insufficient_in_session_research": {
          "description": "Why in-session research was insufficient to resolve the claim.",
          "type": "string"
        },
        "proposal_id": {
          "description": "Proposal UUID or short_id.",
          "type": "string"
        },
        "question": {
          "description": "The feasibility question the evidence spike must answer.",
          "type": "string"
        },
        "round": {
          "description": "The debate round when the demand is issued (from the Judge's task\ndescription).",
          "format": "int32",
          "type": "integer"
        },
        "spec_unknown_anchor": {
          "description": "What in the spec is unknown or unverified.",
          "type": "string"
        },
        "target_subsystem": {
          "description": "The subsystem or module under investigation.",
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "round",
        "against_revision_seq",
        "question",
        "target_subsystem",
        "spec_unknown_anchor",
        "insufficient_in_session_research",
        "expected_findings"
      ],
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "NeedsEvidenceDemandResult": {
          "description": "Accepted demand result for `proposal_refinement_demand_evidence`.\n\nReturned inside [`NeedsEvidenceDemandResponse`] when the Judge's demand\npasses validation. The accepted-demand mutation atomically creates the\nevidence spike task, links it to the proposal, writes a `needs_evidence`\ndebate entry, and records a `refinement_awaiting_evidence_started`\nlifecycle event.",
          "properties": {
            "against_revision_seq": {
              "description": "The pre-refinement snapshot revision seq the demand targets.",
              "format": "int32",
              "type": "integer"
            },
            "claim": {
              "description": "The recorded needs-evidence claim question.",
              "type": "string"
            },
            "round": {
              "description": "The debate round when the demand was issued.",
              "format": "int32",
              "type": "integer"
            },
            "spike_task_id": {
              "description": "The spike task id (UUID) created for this demand. Present when the\ndemand was accepted and the spike was successfully linked.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "claim",
            "against_revision_seq",
            "round"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "accepted": {
          "description": "True when the demand was accepted and recorded.",
          "type": "boolean"
        },
        "error": {
          "description": "Error message for a rejected demand.",
          "type": [
            "string",
            "null"
          ]
        },
        "proposal_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/NeedsEvidenceDemandResult"
            },
            {
              "type": "null"
            }
          ],
          "description": "Details for an accepted demand."
        }
      },
      "required": [
        "accepted"
      ],
      "type": "object"
    }
  },
  {
    "name": "proposal_refinement_demand_round",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "proposal_id": {
          "description": "Proposal UUID or short_id.",
          "type": "string"
        },
        "reason": {
          "description": "Why another round is being demanded. Recorded in proposal history.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "proposal_id"
      ],
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "EvidenceLifecyclePhase": {
          "description": "Evidence lifecycle phase for a needs-evidence parking.\n\nThis is the inner phase within a `NeedsEvidenceStatus` and describes\nonly the evidence-spike lifecycle. See [`EvidenceLifecycleState`] for\nthe top-level refinement status discriminator that includes Active,\nPausedOrFrozen, and Terminal.",
          "oneOf": [
            {
              "const": "awaiting_evidence",
              "description": "Spike is running, no findings yet.",
              "type": "string"
            },
            {
              "const": "evidence_received",
              "description": "Spike returned structured findings; refinement can resume.",
              "type": "string"
            },
            {
              "const": "evidence_failed",
              "description": "Spike failed (cancelled, errored, force-closed).",
              "type": "string"
            }
          ]
        },
        "EvidenceLifecycleState": {
          "description": "Top-level evidence lifecycle state for the refinement status surface.\n\nDerived from durable proposal fields, debate-trail lifecycle events,\nlinked-spike task status, and admin freeze state — **not** from\nin-memory coordinator state. Downstream control-plane and UI consumers\nuse this discriminator to determine the refinement's effective state\nwithout needing to inspect individual `needs_evidence` sub-fields.\n\nPrecedence (highest → lowest):\n1. `Terminal` — proposal status is done/rejected/archived/superseded.\n2. `PausedOrFrozen` — admin freeze is active (`build_frozen = true`).\n   This takes precedence over active resume wording.\n3. `EvidenceFailed` — persisted failure lifecycle event exists.\n4. `EvidenceReceived` — persisted receipt lifecycle event exists.\n5. `AwaitingEvidence` — open linked evidence spike.\n6. `Active` — refinement is active, no evidence parking.",
          "oneOf": [
            {
              "const": "active",
              "description": "Refinement is active (advocate/adversary/judge loop running).",
              "type": "string"
            },
            {
              "const": "awaiting_evidence",
              "description": "Refinement is parked: an evidence spike is in flight and findings\nhave not yet arrived.",
              "type": "string"
            },
            {
              "const": "evidence_received",
              "description": "Evidence findings have been recorded; refinement may resume once\ndownstream processing completes.",
              "type": "string"
            },
            {
              "const": "evidence_failed",
              "description": "Evidence spike failed or was force-closed; refinement is blocked\nuntil the failure is addressed.",
              "type": "string"
            },
            {
              "const": "paused_or_frozen",
              "description": "The proposal is administratively paused or frozen. Takes precedence\nover all evidence sub-states and active resume wording.",
              "type": "string"
            },
            {
              "const": "terminal",
              "description": "Refinement has reached a terminal outcome (proposal done/rejected/\narchived/superseded).",
              "type": "string"
            }
          ]
        },
        "NeedsEvidenceStatus": {
          "description": "Needs-evidence parking state for a proposal.",
          "properties": {
            "against_revision_seq": {
              "description": "Proposal revision sequence the demand targets.",
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "claim": {
              "description": "The named feasibility claim that the Judge identified.\nFor structured claims this is the `question` field; for legacy\nplain-string claims this is the raw string.",
              "type": "string"
            },
            "created_by_task_id": {
              "description": "The Judge task id that issued the demand.",
              "type": [
                "string",
                "null"
              ]
            },
            "evidence_phase": {
              "anyOf": [
                {
                  "$ref": "#/$defs/EvidenceLifecyclePhase"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Current evidence lifecycle phase (awaiting, received, or failed).\nDerived from persisted `proposal_revisions` lifecycle events.\n`None` when no lifecycle event has been recorded yet."
            },
            "expected_findings": {
              "description": "What the evidence spike should produce to resolve the claim.\nFrom the structured claim's `expected_findings`.\n`None` when `needs_evidence_claim` is a legacy plain string.",
              "type": [
                "string",
                "null"
              ]
            },
            "failure_reason": {
              "description": "For `evidence_failed`, the failure reason (`spike_cancelled`,\n`spike_errored`, `spike_force_closed`, `malformed_findings`, etc.).\n`None` for other phases.",
              "type": [
                "string",
                "null"
              ]
            },
            "insufficient_in_session_research": {
              "description": "Why in-session research was insufficient to resolve the claim.\nFrom the structured claim's `insufficient_in_session_research`.\n`None` when `needs_evidence_claim` is a legacy plain string.",
              "type": [
                "string",
                "null"
              ]
            },
            "question": {
              "description": "The feasibility question the spike must answer (from the structured\nclaim). `None` when `needs_evidence_claim` is a legacy plain string.",
              "type": [
                "string",
                "null"
              ]
            },
            "round": {
              "description": "Debate round when the demand was issued.",
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "spec_unknown_anchor": {
              "description": "What in the spec is unknown/unverified.",
              "type": [
                "string",
                "null"
              ]
            },
            "spike_short_id": {
              "description": "The spike task short id (human-readable).",
              "type": "string"
            },
            "spike_status": {
              "description": "Current status of the spike task.",
              "type": "string"
            },
            "spike_task_id": {
              "description": "The spike task id (UUID).",
              "type": "string"
            },
            "target_subsystem": {
              "description": "The subsystem or module under investigation.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "claim",
            "spike_task_id",
            "spike_short_id",
            "spike_status"
          ],
          "type": "object"
        },
        "ProposalRefinementStatusModel": {
          "description": "Refinement session state tracked on the proposal's event_metadata.\nThe coordinator refinement workflow populates these fields; the\ncontrol-plane surfaces them read-only to the UI.",
          "properties": {
            "active": {
              "description": "Whether refinement has been started for this proposal.",
              "type": "boolean"
            },
            "awaiting_review": {
              "default": false,
              "description": "True when the autonomous tribunal has converged (or escalated) and is\nparked for the human's single accept/reject review of the refined spec.",
              "type": "boolean"
            },
            "current_round": {
              "description": "Current debate round (1-based). `None` when refinement has not started.",
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "dry_rounds": {
              "description": "How many consecutive adversary dry rounds have been observed.",
              "format": "int32",
              "type": "integer"
            },
            "evidence_lifecycle_state": {
              "$ref": "#/$defs/EvidenceLifecycleState",
              "description": "Top-level evidence lifecycle state derived from durable proposal\nfields, lifecycle events, and linked-spike task status. Lets\ndownstream consumers distinguish Active, AwaitingEvidence,\nEvidenceFailed, PausedOrFrozen, and Terminal without inspecting\nindividual sub-fields."
            },
            "judge_summary": {
              "description": "The judge's summary shown alongside the accept/reject review.\n`None` unless `awaiting_review` is true.",
              "type": [
                "string",
                "null"
              ]
            },
            "needs_evidence": {
              "anyOf": [
                {
                  "$ref": "#/$defs/NeedsEvidenceStatus"
                },
                {
                  "type": "null"
                }
              ],
              "description": "When the proposal is parked for a needs-evidence spike, this contains\nthe claim and spike task reference. `None` when not parked."
            },
            "snapshot_revision_seq": {
              "description": "The pre-refinement snapshot revision seq (the diff baseline) when\n`awaiting_review` is true.",
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "stop_reason": {
              "description": "When set, refinement has stopped for this reason.\nValues: `adversary_dry`, `round_cap`, `spawn_cap`, `repeated_objection`,\n`agent_failure`, or `null` (still running / not started).",
              "type": [
                "string",
                "null"
              ]
            },
            "total_entries": {
              "description": "Total debate-trail entries produced so far.",
              "format": "int32",
              "type": "integer"
            }
          },
          "required": [
            "active",
            "dry_rounds",
            "total_entries",
            "evidence_lifecycle_state"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "accepted": {
          "description": "True when the demand was accepted and a new round started.",
          "type": "boolean"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "proposal_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "refinement": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProposalRefinementStatusModel"
            },
            {
              "type": "null"
            }
          ],
          "description": "Refinement status after the demand."
        }
      },
      "required": [
        "accepted"
      ],
      "type": "object"
    }
  },
  {
    "name": "proposal_refinement_resolve",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "decision": {
          "description": "The human's decision: `accept` (keep the refined spec) or `reject`\n(revert the live spec to the pre-refinement snapshot).",
          "type": "string"
        },
        "feedback": {
          "default": null,
          "description": "Optional reviewer note — why accepted/rejected. Recorded for the audit\ntrail.",
          "type": [
            "string",
            "null"
          ]
        },
        "proposal_id": {
          "description": "Proposal UUID or short_id.",
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "decision"
      ],
      "type": "object"
    },
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "proposal_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolved": {
          "description": "True when the human's accept/reject was applied.",
          "type": "boolean"
        }
      },
      "required": [
        "resolved"
      ],
      "type": "object"
    }
  },
  {
    "name": "proposal_refinement_start",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "owner_user_id": {
          "default": null,
          "description": "User the refinement run is attributed to: owner of the spawned\nrefinement (tribunal) tasks and the scope for per-user role-model\nresolution. Omit to attribute the run to the proposal author.",
          "type": [
            "string",
            "null"
          ]
        },
        "proposal_id": {
          "description": "Proposal UUID or short_id.",
          "type": "string"
        }
      },
      "required": [
        "proposal_id"
      ],
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "EvidenceLifecyclePhase": {
          "description": "Evidence lifecycle phase for a needs-evidence parking.\n\nThis is the inner phase within a `NeedsEvidenceStatus` and describes\nonly the evidence-spike lifecycle. See [`EvidenceLifecycleState`] for\nthe top-level refinement status discriminator that includes Active,\nPausedOrFrozen, and Terminal.",
          "oneOf": [
            {
              "const": "awaiting_evidence",
              "description": "Spike is running, no findings yet.",
              "type": "string"
            },
            {
              "const": "evidence_received",
              "description": "Spike returned structured findings; refinement can resume.",
              "type": "string"
            },
            {
              "const": "evidence_failed",
              "description": "Spike failed (cancelled, errored, force-closed).",
              "type": "string"
            }
          ]
        },
        "EvidenceLifecycleState": {
          "description": "Top-level evidence lifecycle state for the refinement status surface.\n\nDerived from durable proposal fields, debate-trail lifecycle events,\nlinked-spike task status, and admin freeze state — **not** from\nin-memory coordinator state. Downstream control-plane and UI consumers\nuse this discriminator to determine the refinement's effective state\nwithout needing to inspect individual `needs_evidence` sub-fields.\n\nPrecedence (highest → lowest):\n1. `Terminal` — proposal status is done/rejected/archived/superseded.\n2. `PausedOrFrozen` — admin freeze is active (`build_frozen = true`).\n   This takes precedence over active resume wording.\n3. `EvidenceFailed` — persisted failure lifecycle event exists.\n4. `EvidenceReceived` — persisted receipt lifecycle event exists.\n5. `AwaitingEvidence` — open linked evidence spike.\n6. `Active` — refinement is active, no evidence parking.",
          "oneOf": [
            {
              "const": "active",
              "description": "Refinement is active (advocate/adversary/judge loop running).",
              "type": "string"
            },
            {
              "const": "awaiting_evidence",
              "description": "Refinement is parked: an evidence spike is in flight and findings\nhave not yet arrived.",
              "type": "string"
            },
            {
              "const": "evidence_received",
              "description": "Evidence findings have been recorded; refinement may resume once\ndownstream processing completes.",
              "type": "string"
            },
            {
              "const": "evidence_failed",
              "description": "Evidence spike failed or was force-closed; refinement is blocked\nuntil the failure is addressed.",
              "type": "string"
            },
            {
              "const": "paused_or_frozen",
              "description": "The proposal is administratively paused or frozen. Takes precedence\nover all evidence sub-states and active resume wording.",
              "type": "string"
            },
            {
              "const": "terminal",
              "description": "Refinement has reached a terminal outcome (proposal done/rejected/\narchived/superseded).",
              "type": "string"
            }
          ]
        },
        "NeedsEvidenceStatus": {
          "description": "Needs-evidence parking state for a proposal.",
          "properties": {
            "against_revision_seq": {
              "description": "Proposal revision sequence the demand targets.",
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "claim": {
              "description": "The named feasibility claim that the Judge identified.\nFor structured claims this is the `question` field; for legacy\nplain-string claims this is the raw string.",
              "type": "string"
            },
            "created_by_task_id": {
              "description": "The Judge task id that issued the demand.",
              "type": [
                "string",
                "null"
              ]
            },
            "evidence_phase": {
              "anyOf": [
                {
                  "$ref": "#/$defs/EvidenceLifecyclePhase"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Current evidence lifecycle phase (awaiting, received, or failed).\nDerived from persisted `proposal_revisions` lifecycle events.\n`None` when no lifecycle event has been recorded yet."
            },
            "expected_findings": {
              "description": "What the evidence spike should produce to resolve the claim.\nFrom the structured claim's `expected_findings`.\n`None` when `needs_evidence_claim` is a legacy plain string.",
              "type": [
                "string",
                "null"
              ]
            },
            "failure_reason": {
              "description": "For `evidence_failed`, the failure reason (`spike_cancelled`,\n`spike_errored`, `spike_force_closed`, `malformed_findings`, etc.).\n`None` for other phases.",
              "type": [
                "string",
                "null"
              ]
            },
            "insufficient_in_session_research": {
              "description": "Why in-session research was insufficient to resolve the claim.\nFrom the structured claim's `insufficient_in_session_research`.\n`None` when `needs_evidence_claim` is a legacy plain string.",
              "type": [
                "string",
                "null"
              ]
            },
            "question": {
              "description": "The feasibility question the spike must answer (from the structured\nclaim). `None` when `needs_evidence_claim` is a legacy plain string.",
              "type": [
                "string",
                "null"
              ]
            },
            "round": {
              "description": "Debate round when the demand was issued.",
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "spec_unknown_anchor": {
              "description": "What in the spec is unknown/unverified.",
              "type": [
                "string",
                "null"
              ]
            },
            "spike_short_id": {
              "description": "The spike task short id (human-readable).",
              "type": "string"
            },
            "spike_status": {
              "description": "Current status of the spike task.",
              "type": "string"
            },
            "spike_task_id": {
              "description": "The spike task id (UUID).",
              "type": "string"
            },
            "target_subsystem": {
              "description": "The subsystem or module under investigation.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "claim",
            "spike_task_id",
            "spike_short_id",
            "spike_status"
          ],
          "type": "object"
        },
        "ProposalRefinementStatusModel": {
          "description": "Refinement session state tracked on the proposal's event_metadata.\nThe coordinator refinement workflow populates these fields; the\ncontrol-plane surfaces them read-only to the UI.",
          "properties": {
            "active": {
              "description": "Whether refinement has been started for this proposal.",
              "type": "boolean"
            },
            "awaiting_review": {
              "default": false,
              "description": "True when the autonomous tribunal has converged (or escalated) and is\nparked for the human's single accept/reject review of the refined spec.",
              "type": "boolean"
            },
            "current_round": {
              "description": "Current debate round (1-based). `None` when refinement has not started.",
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "dry_rounds": {
              "description": "How many consecutive adversary dry rounds have been observed.",
              "format": "int32",
              "type": "integer"
            },
            "evidence_lifecycle_state": {
              "$ref": "#/$defs/EvidenceLifecycleState",
              "description": "Top-level evidence lifecycle state derived from durable proposal\nfields, lifecycle events, and linked-spike task status. Lets\ndownstream consumers distinguish Active, AwaitingEvidence,\nEvidenceFailed, PausedOrFrozen, and Terminal without inspecting\nindividual sub-fields."
            },
            "judge_summary": {
              "description": "The judge's summary shown alongside the accept/reject review.\n`None` unless `awaiting_review` is true.",
              "type": [
                "string",
                "null"
              ]
            },
            "needs_evidence": {
              "anyOf": [
                {
                  "$ref": "#/$defs/NeedsEvidenceStatus"
                },
                {
                  "type": "null"
                }
              ],
              "description": "When the proposal is parked for a needs-evidence spike, this contains\nthe claim and spike task reference. `None` when not parked."
            },
            "snapshot_revision_seq": {
              "description": "The pre-refinement snapshot revision seq (the diff baseline) when\n`awaiting_review` is true.",
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "stop_reason": {
              "description": "When set, refinement has stopped for this reason.\nValues: `adversary_dry`, `round_cap`, `spawn_cap`, `repeated_objection`,\n`agent_failure`, or `null` (still running / not started).",
              "type": [
                "string",
                "null"
              ]
            },
            "total_entries": {
              "description": "Total debate-trail entries produced so far.",
              "format": "int32",
              "type": "integer"
            }
          },
          "required": [
            "active",
            "dry_rounds",
            "total_entries",
            "evidence_lifecycle_state"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "proposal_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "refinement": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProposalRefinementStatusModel"
            },
            {
              "type": "null"
            }
          ],
          "description": "The initial refinement status after starting."
        }
      },
      "type": "object"
    }
  },
  {
    "name": "proposal_refinement_status",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "proposal_id": {
          "description": "Proposal UUID or short_id.",
          "type": "string"
        }
      },
      "required": [
        "proposal_id"
      ],
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "EvidenceLifecyclePhase": {
          "description": "Evidence lifecycle phase for a needs-evidence parking.\n\nThis is the inner phase within a `NeedsEvidenceStatus` and describes\nonly the evidence-spike lifecycle. See [`EvidenceLifecycleState`] for\nthe top-level refinement status discriminator that includes Active,\nPausedOrFrozen, and Terminal.",
          "oneOf": [
            {
              "const": "awaiting_evidence",
              "description": "Spike is running, no findings yet.",
              "type": "string"
            },
            {
              "const": "evidence_received",
              "description": "Spike returned structured findings; refinement can resume.",
              "type": "string"
            },
            {
              "const": "evidence_failed",
              "description": "Spike failed (cancelled, errored, force-closed).",
              "type": "string"
            }
          ]
        },
        "EvidenceLifecycleState": {
          "description": "Top-level evidence lifecycle state for the refinement status surface.\n\nDerived from durable proposal fields, debate-trail lifecycle events,\nlinked-spike task status, and admin freeze state — **not** from\nin-memory coordinator state. Downstream control-plane and UI consumers\nuse this discriminator to determine the refinement's effective state\nwithout needing to inspect individual `needs_evidence` sub-fields.\n\nPrecedence (highest → lowest):\n1. `Terminal` — proposal status is done/rejected/archived/superseded.\n2. `PausedOrFrozen` — admin freeze is active (`build_frozen = true`).\n   This takes precedence over active resume wording.\n3. `EvidenceFailed` — persisted failure lifecycle event exists.\n4. `EvidenceReceived` — persisted receipt lifecycle event exists.\n5. `AwaitingEvidence` — open linked evidence spike.\n6. `Active` — refinement is active, no evidence parking.",
          "oneOf": [
            {
              "const": "active",
              "description": "Refinement is active (advocate/adversary/judge loop running).",
              "type": "string"
            },
            {
              "const": "awaiting_evidence",
              "description": "Refinement is parked: an evidence spike is in flight and findings\nhave not yet arrived.",
              "type": "string"
            },
            {
              "const": "evidence_received",
              "description": "Evidence findings have been recorded; refinement may resume once\ndownstream processing completes.",
              "type": "string"
            },
            {
              "const": "evidence_failed",
              "description": "Evidence spike failed or was force-closed; refinement is blocked\nuntil the failure is addressed.",
              "type": "string"
            },
            {
              "const": "paused_or_frozen",
              "description": "The proposal is administratively paused or frozen. Takes precedence\nover all evidence sub-states and active resume wording.",
              "type": "string"
            },
            {
              "const": "terminal",
              "description": "Refinement has reached a terminal outcome (proposal done/rejected/\narchived/superseded).",
              "type": "string"
            }
          ]
        },
        "NeedsEvidenceStatus": {
          "description": "Needs-evidence parking state for a proposal.",
          "properties": {
            "against_revision_seq": {
              "description": "Proposal revision sequence the demand targets.",
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "claim": {
              "description": "The named feasibility claim that the Judge identified.\nFor structured claims this is the `question` field; for legacy\nplain-string claims this is the raw string.",
              "type": "string"
            },
            "created_by_task_id": {
              "description": "The Judge task id that issued the demand.",
              "type": [
                "string",
                "null"
              ]
            },
            "evidence_phase": {
              "anyOf": [
                {
                  "$ref": "#/$defs/EvidenceLifecyclePhase"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Current evidence lifecycle phase (awaiting, received, or failed).\nDerived from persisted `proposal_revisions` lifecycle events.\n`None` when no lifecycle event has been recorded yet."
            },
            "expected_findings": {
              "description": "What the evidence spike should produce to resolve the claim.\nFrom the structured claim's `expected_findings`.\n`None` when `needs_evidence_claim` is a legacy plain string.",
              "type": [
                "string",
                "null"
              ]
            },
            "failure_reason": {
              "description": "For `evidence_failed`, the failure reason (`spike_cancelled`,\n`spike_errored`, `spike_force_closed`, `malformed_findings`, etc.).\n`None` for other phases.",
              "type": [
                "string",
                "null"
              ]
            },
            "insufficient_in_session_research": {
              "description": "Why in-session research was insufficient to resolve the claim.\nFrom the structured claim's `insufficient_in_session_research`.\n`None` when `needs_evidence_claim` is a legacy plain string.",
              "type": [
                "string",
                "null"
              ]
            },
            "question": {
              "description": "The feasibility question the spike must answer (from the structured\nclaim). `None` when `needs_evidence_claim` is a legacy plain string.",
              "type": [
                "string",
                "null"
              ]
            },
            "round": {
              "description": "Debate round when the demand was issued.",
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "spec_unknown_anchor": {
              "description": "What in the spec is unknown/unverified.",
              "type": [
                "string",
                "null"
              ]
            },
            "spike_short_id": {
              "description": "The spike task short id (human-readable).",
              "type": "string"
            },
            "spike_status": {
              "description": "Current status of the spike task.",
              "type": "string"
            },
            "spike_task_id": {
              "description": "The spike task id (UUID).",
              "type": "string"
            },
            "target_subsystem": {
              "description": "The subsystem or module under investigation.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "claim",
            "spike_task_id",
            "spike_short_id",
            "spike_status"
          ],
          "type": "object"
        },
        "ProposalRefinementStatusModel": {
          "description": "Refinement session state tracked on the proposal's event_metadata.\nThe coordinator refinement workflow populates these fields; the\ncontrol-plane surfaces them read-only to the UI.",
          "properties": {
            "active": {
              "description": "Whether refinement has been started for this proposal.",
              "type": "boolean"
            },
            "awaiting_review": {
              "default": false,
              "description": "True when the autonomous tribunal has converged (or escalated) and is\nparked for the human's single accept/reject review of the refined spec.",
              "type": "boolean"
            },
            "current_round": {
              "description": "Current debate round (1-based). `None` when refinement has not started.",
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "dry_rounds": {
              "description": "How many consecutive adversary dry rounds have been observed.",
              "format": "int32",
              "type": "integer"
            },
            "evidence_lifecycle_state": {
              "$ref": "#/$defs/EvidenceLifecycleState",
              "description": "Top-level evidence lifecycle state derived from durable proposal\nfields, lifecycle events, and linked-spike task status. Lets\ndownstream consumers distinguish Active, AwaitingEvidence,\nEvidenceFailed, PausedOrFrozen, and Terminal without inspecting\nindividual sub-fields."
            },
            "judge_summary": {
              "description": "The judge's summary shown alongside the accept/reject review.\n`None` unless `awaiting_review` is true.",
              "type": [
                "string",
                "null"
              ]
            },
            "needs_evidence": {
              "anyOf": [
                {
                  "$ref": "#/$defs/NeedsEvidenceStatus"
                },
                {
                  "type": "null"
                }
              ],
              "description": "When the proposal is parked for a needs-evidence spike, this contains\nthe claim and spike task reference. `None` when not parked."
            },
            "snapshot_revision_seq": {
              "description": "The pre-refinement snapshot revision seq (the diff baseline) when\n`awaiting_review` is true.",
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "stop_reason": {
              "description": "When set, refinement has stopped for this reason.\nValues: `adversary_dry`, `round_cap`, `spawn_cap`, `repeated_objection`,\n`agent_failure`, or `null` (still running / not started).",
              "type": [
                "string",
                "null"
              ]
            },
            "total_entries": {
              "description": "Total debate-trail entries produced so far.",
              "format": "int32",
              "type": "integer"
            }
          },
          "required": [
            "active",
            "dry_rounds",
            "total_entries",
            "evidence_lifecycle_state"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "proposal_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "refinement": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProposalRefinementStatusModel"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    }
  },
  {
    "name": "proposal_remove_target",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
