          "type": "integer"
        },
        "project": {
          "description": "Absolute project path.",
          "type": "string"
        }
      },
      "required": [
        "project"
      ],
      "title": "TaskReadyParams",
      "type": "object"
    },
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": true,
      "title": "ErrorOrTaskReadyResponse",
      "type": "object"
    }
  },
  {
    "name": "task_show",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "id": {
          "description": "Task UUID or short_id.",
          "type": "string"
        },
        "project": {
          "description": "Absolute project path. Optional - task IDs are globally unique.",
          "nullable": true,
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "TaskShowParams",
      "type": "object"
    },
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": true,
      "title": "ErrorOrTaskShowResponse",
      "type": "object"
    }
  },
  {
    "name": "task_timeline",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "project": {
          "default": null,
          "description": "Optional project hint (slug or UUID). Only needed to disambiguate a\n`short_id`; a task UUID resolves globally without it.",
          "nullable": true,
          "type": "string"
        },
        "task_id": {
          "description": "Task UUID or short_id.",
          "nullable": true,
          "type": "string"
        }
      },
      "title": "TaskTimelineParams",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "AnyJson": {},
        "SessionToolSession": {
          "properties": {
            "agent_type": {
              "type": "string"
            },
            "cache_read_tokens": {
              "description": "Running totals of prompt-cache reads (hits) and writes (creation).",
              "format": "int64",
              "type": "integer"
            },
            "cache_write_tokens": {
              "format": "int64",
              "type": "integer"
            },
            "ended_at": {
              "nullable": true,
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "model_id": {
              "type": "string"
            },
            "parked_reason": {
              "description": "Optional deliberate-park reason for terminal sessions, e.g. `budget`.",
              "nullable": true,
              "type": "string"
            },
            "project_id": {
              "description": "`None` for chat sessions (global, user-scoped); `Some(_)` for every\nother agent type. See `SessionRecord::project_id`.",
              "nullable": true,
              "type": "string"
            },
            "started_at": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "task_id": {
              "nullable": true,
              "type": "string"
            },
            "tokens_in": {
              "format": "int64",
              "type": "integer"
            },
            "tokens_out": {
              "format": "int64",
              "type": "integer"
            },
            "workspace_path": {
              "description": "Authoritative workspace path for the session, sourced from the\nattached `task_run` (via `sessions.task_run_id`). `None` when the\nsession is not attached to a task run or the run has no recorded\nworkspace.",
              "nullable": true,
              "type": "string"
            }
          },
          "required": [
            "id",
            "model_id",
            "agent_type",
            "started_at",
            "status",
            "tokens_in",
            "tokens_out",
            "cache_read_tokens",
            "cache_write_tokens"
          ],
          "type": "object"
        },
        "TimelineActivity": {
          "properties": {
            "actor_role": {
              "type": "string"
            },
            "details": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AnyJson"
                },
                {
                  "const": null,
                  "nullable": true
                }
              ]
            },
            "event_type": {
              "type": "string"
            },
            "kind": {
              "description": "Renderer-friendly discriminator. Usually mirrors `event_type`; for\nstructured payloads this is the semantic timeline kind.",
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/AnyJson"
            },
            "summary": {
              "nullable": true,
              "type": "string"
            },
            "timestamp": {
              "type": "string"
            }
          },
          "required": [
            "event_type",
            "actor_role",
            "kind",
            "payload",
            "timestamp"
          ],
          "type": "object"
        },
        "TimelineMessage": {
          "properties": {
            "agent_type": {
              "type": "string"
            },
            "content": {
              "items": {
                "$ref": "#/$defs/AnyJson"
              },
              "type": "array"
            },
            "model_id": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "session_id": {
              "type": "string"
            },
            "timestamp": {
              "type": "string"
            }
          },
          "required": [
            "session_id",
            "role",
            "content",
            "agent_type",
            "model_id",
            "timestamp"
          ],
          "type": "object"
        },
        "TimelineVerificationStep": {
          "properties": {
            "command": {
              "type": "string"
            },
            "duration_ms": {
              "format": "int64",
              "type": "integer"
            },
            "exit_code": {
              "format": "int32",
              "type": "integer"
            },
            "index": {
              "format": "int32",
              "type": "integer"
            },
            "name": {
              "type": "string"
            },
            "phase": {
              "type": "string"
            },
            "stderr": {
              "type": "string"
            },
            "stdout": {
              "type": "string"
            }
          },
          "required": [
            "phase",
            "index",
            "name",
            "command",
            "exit_code",
            "stdout",
            "stderr",
            "duration_ms"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "activity": {
          "items": {
            "$ref": "#/$defs/TimelineActivity"
          },
          "nullable": true,
          "type": "array"
        },
        "error": {
          "nullable": true,
          "type": "string"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/TimelineMessage"
          },
          "nullable": true,
          "type": "array"
        },
        "sessions": {
          "items": {
            "$ref": "#/$defs/SessionToolSession"
          },
          "nullable": true,
          "type": "array"
        },
        "verification_steps": {
          "items": {
            "$ref": "#/$defs/TimelineVerificationStep"
          },
          "nullable": true,
          "type": "array"
        }
      },
      "title": "TaskTimelineResponse",
      "type": "object"
    }
  },
  {
    "name": "task_transition",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "action": {
          "description": "Transition action: start, submit_verification,\nverification_pass, verification_fail, release_verification,\nsubmit_task_review, task_review_start,\ntask_review_reject, task_review_reject_conflict, task_review_approve,\npr_created, pr_undraft, pr_ci_failed, pr_conflict,\npr_merge, pr_changes_requested,\nreopen, close, release, release_task_review, force_close,\nuser_override.",
          "type": "string"
        },
        "actor_id": {
          "nullable": true,
          "type": "string"
        },
        "actor_role": {
          "nullable": true,
          "type": "string"
        },
        "id": {
          "description": "Task UUID or short_id.",
          "type": "string"
        },
        "project": {
          "description": "Absolute project path.",
          "type": "string"
        },
        "reason": {
          "description": "Required for: verification_fail, release_verification,\ntask_review_reject, task_review_reject_conflict,\npr_changes_requested,\nreopen, release, release_task_review, force_close.",
          "nullable": true,
          "type": "string"
        },
        "target_status": {
          "description": "Required when action = \"user_override\". Allowed values: open, in_progress,\nverifying, needs_task_review, in_task_review, approved, pr_draft, pr_review, closed.",
          "nullable": true,
          "type": "string"
        }
      },
      "required": [
        "project",
        "id",
        "action"
      ],
      "title": "TaskTransitionParams",
      "type": "object"
    },
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": true,
      "title": "ErrorOrTaskResponse",
      "type": "object"
    }
  },
  {
    "name": "task_update",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$defs": {
        "AcceptanceCriterionItem": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/AcceptanceCriterionStatus"
            }
          ]
        },
        "AcceptanceCriterionStatus": {
          "properties": {
            "criterion": {
              "type": "string"
            },
            "met": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "criterion"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "acceptance_criteria": {
          "description": "Full replacement for acceptance_criteria.",
          "items": {
            "$ref": "#/$defs/AcceptanceCriterionItem"
          },
          "nullable": true,
          "type": "array"
        },
        "agent_type": {
          "description": "Specialist role name to assign (set None/\"\" to clear).",
          "nullable": true,
          "type": "string"
        },
        "blocked_by_add": {
          "description": "Task IDs (UUID or short_id) to add as blockers of this task.",
          "items": {
            "type": "string"
          },
          "nullable": true,
          "type": "array"
        },
        "blocked_by_remove": {
          "description": "Task IDs (UUID or short_id) to remove as blockers of this task.",
          "items": {
            "type": "string"
          },
          "nullable": true,
          "type": "array"
        },
        "description": {
          "nullable": true,
          "type": "string"
        },
        "design": {
          "nullable": true,
          "type": "string"
        },
        "epic_id": {
          "description": "New parent epic UUID or short_id.",
          "nullable": true,
          "type": "string"
        },
        "id": {
          "description": "Task UUID or short_id.",
          "type": "string"
        },
        "labels_add": {
          "description": "Labels to add.",
          "items": {
            "type": "string"
          },
          "nullable": true,
          "type": "array"
        },
        "labels_remove": {
          "description": "Labels to remove.",
          "items": {
            "type": "string"
          },
          "nullable": true,
          "type": "array"
        },
        "memory_refs_add": {
          "description": "Memory note permalinks to add to this task.",
          "items": {
            "type": "string"
          },
          "nullable": true,
          "type": "array"
        },
        "memory_refs_remove": {
          "description": "Memory note permalinks to remove from this task.",
          "items": {
            "type": "string"
          },
          "nullable": true,
          "type": "array"
        },
        "owner": {
          "nullable": true,
          "type": "string"
        },
        "priority": {
          "format": "int64",
          "nullable": true,
          "type": "integer"
        },
        "project": {
          "description": "Absolute project path.",
          "type": "string"
        },
        "title": {
          "nullable": true,
          "type": "string"
        }
      },
      "required": [
        "project",
        "id"
      ],
      "title": "TaskUpdateParams",
      "type": "object"
    },
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": true,
      "title": "ErrorOrTaskResponse",
      "type": "object"
    }
  },
  {
    "name": "toolchain_versions",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ToolchainVersionsParams",
      "type": "object"
    },
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "status": {
          "type": "string"
        },
        "versions": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "description": "Available versions per language (rust/node/python/go/java/ruby/dotnet/clang),\nfetched live from upstream (cached) with static fallback.",
          "type": "object"
        }
      },
      "required": [
        "status",
        "versions"
      ],
      "title": "ToolchainVersionsResponse",
      "type": "object"
    }
  },
  {
    "name": "user_settings_get",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "target_user_id": {
          "default": null,
          "description": "Admin-only: act on behalf of this user id (e.g. another user to\nconfigure). Non-admins must omit it.",
          "nullable": true,
          "type": "string"
        }
      },
      "title": "UserSettingsGetParams",
      "type": "object"
    },
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "auto_approve_prs": {
          "description": "Auto-approve PRs that are otherwise ready to merge. When true, the\npoller POSTs an APPROVE review using this user's GitHub token at the\nmoment the PR has CI green + no conflicts + no existing approvals.\nDefaults to false. Each task's `created_by_user_id` decides whose\ntoggle applies; background-agent tasks (`created_by_user_id IS NULL`)\nare never auto-approved.",
          "type": "boolean"
        },
        "error": {
          "nullable": true,
          "type": "string"
        },
        "max_sessions": {
          "additionalProperties": {
            "format": "int64",
            "type": "integer"
          },
          "description": "This user's per-model concurrency caps (`{ \"provider/model\": cap }`).\nThe sole admission control at dispatch; empty ⇒ default 1 per model.",
          "type": "object"
        },
        "models": {
          "description": "This user's ordered model selection (highest priority first), full\n`provider/model` ids. Empty when the user has no explicit selection\n(callers then fall back to the global deployment model list).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ok": {
          "type": "boolean"
        },
        "user_id": {
          "description": "`users.id` of the signed-in caller (echoed so the UI can sanity-check identity).",
          "nullable": true,
          "type": "string"
        }
      },
      "required": [
        "ok",
        "auto_approve_prs",
        "models",
        "max_sessions"
      ],
      "title": "UserSettingsGetResponse",
      "type": "object"
    }
  },
  {
    "name": "user_settings_set",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "auto_approve_prs": {
          "description": "Enable or disable auto-approve. Omit to keep the current value.",
          "nullable": true,
          "type": "boolean"
        },
        "max_sessions": {
          "additionalProperties": {
            "format": "int64",
            "type": "integer"
          },
          "description": "Per-model concurrency caps for THIS user (`{ \"provider/model\": cap }`).\nHow many sessions of each model may run concurrently for this user — the\nsole admission control (no global ceiling). Pass `{}` to clear (→ default\n1 per model). Omit to keep the current value.",
          "nullable": true,
          "type": "object"
        },
        "models": {
          "description": "Ordered model selection for THIS user (highest priority first), as full\n`provider/model` ids. Each must be a model on a provider this user has\nconnected. Pass `[]` to clear the selection (→ global fallback). Omit to\nkeep the current value.",
          "items": {
            "type": "string"
          },
          "nullable": true,
          "type": "array"
        },
        "target_user_id": {
          "default": null,
          "description": "Admin-only: act on behalf of this user id (e.g. another user to\nconfigure). Non-admins must omit it.",
          "nullable": true,
          "type": "string"
        }
      },
      "title": "UserSettingsSetParams",
      "type": "object"
    },
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "auto_approve_prs": {
          "nullable": true,
          "type": "boolean"
        },
        "error": {
          "nullable": true,
          "type": "string"
        },
        "max_sessions": {
          "additionalProperties": {
            "format": "int64",
            "type": "integer"
          },
          "description": "The resulting per-model concurrency caps after the patch.",
          "nullable": true,
          "type": "object"
        },
        "models": {
          "description": "The resulting model selection after the patch.",
          "items": {
            "type": "string"
          },
          "nullable": true,
          "type": "array"
        },
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "ok",
        "applied"
      ],
      "title": "UserSettingsSetResponse",
      "type": "object"
    }
  }
]
