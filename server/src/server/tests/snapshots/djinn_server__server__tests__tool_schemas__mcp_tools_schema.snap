  {
    "name": "task_create",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$defs": {
        "AcceptanceCriterionItem": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/AcceptanceCriterionStatus"
            }
          ]
        },
        "AcceptanceCriterionStatus": {
          "properties": {
            "criterion": {
              "type": "string"
            },
            "met": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "criterion"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "acceptance_criteria": {
          "items": {
            "$ref": "#/$defs/AcceptanceCriterionItem"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "agent_type": {
          "description": "Specialist role name to route this task (e.g. \"rust-expert\").",
          "type": [
            "string",
            "null"
          ]
        },
        "blocked_by": {
          "description": "Task IDs (UUID or short_id) that block this task. Blockers are set atomically at creation.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "design": {
          "type": [
            "string",
            "null"
          ]
        },
        "epic_id": {
          "description": "Parent epic ID - UUID or short_id (required).",
          "type": [
            "string",
            "null"
          ]
        },
        "issue_type": {
          "description": "Task type: \"task\" (default), \"feature\", \"bug\", \"spike\", \"research\", \"planning\", or \"review\".\nSpike, research, planning, and review use a simple lifecycle: open → in_progress → closed.\nPlanning tasks are routed to the Planner; spike and review tasks are routed to the Architect.",
          "type": [
            "string",
            "null"
          ]
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "memory_refs": {
          "description": "Memory note permalinks to attach to this task at creation.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "priority": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "project": {
          "description": "Absolute project path.",
          "type": "string"
        },
        "status": {
          "description": "Optional initial status. Allowed value: \"open\" (default).",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "project",
        "title"
      ],
      "type": "object"
    },
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": true,
      "type": "object"
    }
  },
  {
    "name": "task_list",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "issue_type": {
          "description": "Positive (\"task\") or negative (\"!epic\") issue_type filter.",
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "description": "Filter by label value.",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "offset": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "priority": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "project": {
          "description": "Absolute project path.",
          "type": "string"
        },
        "sort": {
          "description": "Sort order: \"priority\" (default), \"created\", \"created_desc\",\n\"updated\", \"updated_desc\", \"closed\".",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "Positive (\"open\") or negative (\"!closed\") status filter. A leading \"!\"\nmatches every task whose status differs from the given value. The\npseudo-status \"merged\" matches closed tasks that actually merged (have a\nmerge-commit SHA, or opened a PR and closed as completed) — this is what\nbacks the Kanban Merged column.",
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "description": "Full-text search on title and description.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "project"
      ],
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "AcceptanceCriterionItem": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/AcceptanceCriterionStatus"
            }
          ]
        },
        "AcceptanceCriterionStatus": {
          "properties": {
            "criterion": {
              "type": "string"
            },
            "met": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "criterion"
          ],
          "type": "object"
        },
        "CiGateSnapshot": {
          "description": "Snapshot of the current-head required-CI gate for a task's PR.\n\nPopulated from the repository-backed CI snapshot (`task_pr_ci_snapshots`).\n`None` when no snapshot exists yet (e.g. task has no PR or has not been\npolled). Downstream lifecycle/API code reads these fields directly instead\nof scraping activity prose.\n\nDerived fields (`gate_state`, `primary_blocking_check`, `summary_reason`,\n`merge_blocked_reason`) are computed from the raw CI status combined with\nthe task's lifecycle status.  They expose human/agent-friendly gate\ninformation without requiring consumers to re-derive policy.",
          "properties": {
            "blocking_required_check_names": {
              "description": "Names of required checks that are currently failing and blocking merge.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "failure_fingerprint": {
              "description": "Stable fingerprint of the current failure signature (e.g. sorted\nfailing check names + head SHA). `None` when not failing.",
              "type": [
                "string",
                "null"
              ]
            },
            "first_seen_at": {
              "description": "ISO-8601 timestamp when this snapshot was first observed.",
              "type": "string"
            },
            "gate_state": {
              "$ref": "#/$defs/CiGateState",
              "description": "Derived CI gate state combining raw CI status with task lifecycle.\n\nMaps to the upstream low-risk design contract:\n- `passing` / `failing` / `pending` / `unknown` mirror `CiStatus`\n  when the task is not in `pr_draft`.\n- `awaiting_ci` when the task is in `pr_draft` *and* the raw CI\n  status is `pending` or `unknown` (CI has not completed yet).\n\nUI consumers render this value directly as the badge text."
            },
            "github_head_sha": {
              "description": "Head SHA of the GitHub PR branch, when known.",
              "type": [
                "string",
                "null"
              ]
            },
            "head_observation_error": {
              "description": "Concise error string from the most recent publication/observation\nfailure, when one is recorded.  Absent when no error is known.",
              "type": [
                "string",
                "null"
              ]
            },
            "head_sha": {
              "description": "Git SHA of the PR head this snapshot describes.",
              "type": "string"
            },
            "heads_diverged": {
              "description": "`true` only when both heads are known and differ; `false` only when\nboth are known and equal; absent/null-compatible when either side is\nunknown.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "last_remediation_base_sha": {
              "description": "Base SHA of the last remediation attempt for this failing signature.\n`None` when no remediation has been attempted yet.",
              "type": [
                "string",
                "null"
              ]
            },
            "last_seen_at": {
              "description": "ISO-8601 timestamp when this snapshot was last observed/updated.",
              "type": "string"
            },
            "merge_blocked_reason": {
              "description": "Reason merge/close is blocked by CI, if applicable.\n\n`Some(_)` when the raw CI status is not `passing` (i.e. failing,\npending, or unknown).  `None` when CI is passing or when no\nsnapshot exists.",
              "type": [
                "string",
                "null"
              ]
            },
            "mirror_head_sha": {
              "description": "Head SHA of the internal mirror branch, when known.",
              "type": [
                "string",
                "null"
              ]
            },
            "pr_number": {
              "description": "GitHub PR number the CI snapshot belongs to, when available.",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "primary_blocking_check": {
              "description": "Primary blocking required check name, when CI is failing.\n\n`Some(_)` when `status == failing` and at least one required check\nfailed.  This is the first element of `blocking_required_check_names`\n(sorted alphabetically) for compact display.  `None` otherwise.",
              "type": [
                "string",
                "null"
              ]
            },
            "same_signature_count": {
              "description": "How many consecutive observations carried the same failure fingerprint\nfor the same head SHA.",
              "format": "int64",
              "type": "integer"
            },
            "status": {
              "$ref": "#/$defs/CiStatus",
              "description": "Current required-CI status for the PR head."
            },
            "summary_reason": {
              "description": "Human-readable summary of the current CI gate state.\n\nDerived from raw CI status and blocking check names.  Examples:\n- `\"All required checks passed\"` (passing)\n- `\"Required check failing: clippy\"` (failing with one check)\n- `\"Required checks pending\"` (pending)\n- `\"CI state unknown\"` (unknown)",
              "type": "string"
            }
          },
          "required": [
            "status",
            "gate_state",
            "head_sha",
            "blocking_required_check_names",
            "summary_reason",
            "first_seen_at",
            "last_seen_at",
            "same_signature_count"
          ],
          "type": "object"
        },
        "CiGateState": {
          "description": "Derived CI gate state combining raw CI status with task lifecycle.\n\nFollows the upstream low-risk design: when a task is in `pr_draft` and the\nraw CI status is `pending` or `unknown`, the gate state is `awaiting_ci`.\nOtherwise it mirrors the raw CI status.",
          "oneOf": [
            {
              "enum": [
                "passing",
                "failing",
                "pending",
                "unknown"
              ],
              "type": "string"
            },
            {
              "const": "awaiting_ci",
              "description": "Task is in `pr_draft` and CI has not completed yet (pending/unknown).",
              "type": "string"
            }
          ]
        },
        "CiStatus": {
          "description": "Required-CI status for the current PR head.\n\nSerializes/deserializes to/from the exact wire strings consumed by the\nbackend DTOs and (eventually) the frontend. These values are intentionally\nindependent of `TaskStatus`; lifecycle policy (e.g. `awaiting_ci`) is\nderived downstream, not encoded here.",
          "oneOf": [
            {
              "const": "passing",
              "description": "All required checks passed on the current head.",
              "type": "string"
            },
            {
              "const": "failing",
              "description": "At least one required check failed on the current head.",
              "type": "string"
            },
            {
              "const": "pending",
              "description": "Required checks are still running; no blocking failure yet.",
              "type": "string"
            },
            {
              "const": "unknown",
              "description": "CI state is not known (e.g. PR not yet polled, no checks present).",
              "type": "string"
            }
          ]
        },
        "TaskListItem": {
          "properties": {
            "acceptance_criteria": {
              "items": {
                "$ref": "#/$defs/AcceptanceCriterionItem"
              },
              "type": "array"
            },
            "active_session": {
              "description": "Active running session for this task, if any.",
              "properties": {
                "agent_type": {
                  "type": "string"
                },
                "model_id": {
                  "type": "string"
                },
                "session_id": {
                  "type": "string"
                },
                "started_at": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                }
              },
              "required": [
                "session_id",
                "agent_type",
                "model_id",
                "started_at",
                "status"
              ],
              "type": [
                "object",
                "null"
              ]
            },
            "agent_type": {
              "description": "Specialist role name assigned to this task, if any.",
              "type": [
                "string",
                "null"
              ]
            },
            "ci": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CiGateSnapshot"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Current-head required-CI gate snapshot for this task's PR, if any."
            },
            "ci_gate_state": {
              "$ref": "#/$defs/CiGateState",
              "description": "Top-level alias for `ci.gate_state`, including `awaiting_ci` for\n`pr_draft` + pending/unknown."
            },
            "ci_merge_blocked_reason": {
              "description": "Structured merge/close blocking reason when current-head CI is not passing.",
              "type": [
                "string",
                "null"
              ]
            },
            "ci_primary_blocking_check": {
              "description": "Primary blocking required check/job when required CI is failing.",
              "type": [
                "string",
                "null"
              ]
            },
            "ci_status": {
              "$ref": "#/$defs/CiStatus",
              "description": "Top-level alias for `ci.status` (`passing`, `failing`, `pending`, or\n`unknown`) sourced from the durable current-head CI snapshot."
            },
            "ci_summary_reason": {
              "description": "Human-readable structured CI summary reason.",
              "type": [
                "string",
                "null"
              ]
            },
            "close_reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "closed_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "continuation_count": {
              "format": "int64",
              "type": "integer"
            },
            "created_at": {
              "type": "string"
            },
            "created_by_user_id": {
              "description": "Stable `users.id` of whoever this task belongs to (session creator, or\nthe parent epic's creator for Planner-spawned tasks). `None` for tasks\nwith no human owner. Resolve to a display name via the org user list.",
              "type": [
                "string",
                "null"
              ]
            },
            "description": {
              "type": "string"
            },
            "design": {
              "type": "string"
            },
            "epic_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "id": {
              "type": "string"
            },
            "intervention_count": {
              "format": "int64",
              "type": "integer"
            },
            "issue_type": {
              "type": "string"
            },
            "labels": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "last_intervention_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "memory_refs": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "merge_commit_sha": {
              "type": [
                "string",
                "null"
              ]
            },
            "merge_conflict_metadata": {
              "additionalProperties": true,
              "description": "JSON metadata about an active merge conflict (files, branches).",
              "type": [
                "object",
                "null"
              ]
            },
            "owner": {
              "type": "string"
            },
            "pr_url": {
              "description": "URL of the associated pull request, once one has been opened.",
              "type": [
                "string",
                "null"
              ]
            },
            "priority": {
              "format": "int64",
              "type": "integer"
            },
            "reopen_count": {
              "format": "int64",
              "type": "integer"
            },
            "session_count": {
              "description": "Total number of sessions that have worked on this task.",
              "format": "int64",
              "type": "integer"
            },
