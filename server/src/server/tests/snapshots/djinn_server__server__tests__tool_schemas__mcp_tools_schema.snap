      ],
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "SessionToolSession": {
          "properties": {
            "agent_type": {
              "type": "string"
            },
            "cache_read_tokens": {
              "description": "Running totals of prompt-cache reads (hits) and writes (creation).",
              "format": "int64",
              "type": "integer"
            },
            "cache_write_tokens": {
              "format": "int64",
              "type": "integer"
            },
            "ended_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "id": {
              "type": "string"
            },
            "model_id": {
              "type": "string"
            },
            "parked_reason": {
              "description": "Optional deliberate-park reason for terminal sessions, e.g. `budget`.",
              "type": [
                "string",
                "null"
              ]
            },
            "project_id": {
              "description": "`None` for chat sessions (global, user-scoped); `Some(_)` for every\nother agent type. See `SessionRecord::project_id`.",
              "type": [
                "string",
                "null"
              ]
            },
            "started_at": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "task_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "tokens_in": {
              "format": "int64",
              "type": "integer"
            },
            "tokens_out": {
              "format": "int64",
              "type": "integer"
            },
            "workspace_path": {
              "description": "Authoritative workspace path for the session, sourced from the\nattached `task_run` (via `sessions.task_run_id`). `None` when the\nsession is not attached to a task run or the run has no recorded\nworkspace.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "model_id",
            "agent_type",
            "started_at",
            "status",
            "tokens_in",
            "tokens_out",
            "cache_read_tokens",
            "cache_write_tokens"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "recovery_triggered": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "sessions": {
          "items": {
            "$ref": "#/$defs/SessionToolSession"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "stale_sessions": {
          "items": {
            "$ref": "#/$defs/SessionToolSession"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
