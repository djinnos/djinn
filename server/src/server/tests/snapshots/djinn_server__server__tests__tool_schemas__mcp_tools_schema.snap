              "type": "string"
            },
            "agent_name": {
              "type": "string"
            },
            "avg_reopens": {
              "format": "double",
              "type": "number"
            },
            "avg_time_seconds": {
              "format": "double",
              "type": "number"
            },
            "avg_tokens": {
              "format": "double",
              "type": "number"
            },
            "avg_tokens_in": {
              "format": "double",
              "type": "number"
            },
            "avg_tokens_out": {
              "format": "double",
              "type": "number"
            },
            "base_role": {
              "type": "string"
            },
            "completed_task_count": {
              "format": "int64",
              "type": "integer"
            },
            "extraction_quality": {
              "$ref": "#/$defs/ExtractionQualityMetricEntry"
            },
            "success_rate": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "agent_id",
            "agent_name",
            "base_role",
            "success_rate",
            "avg_tokens",
            "avg_tokens_in",
            "avg_tokens_out",
            "avg_time_seconds",
            "avg_reopens",
            "completed_task_count",
            "extraction_quality"
          ],
          "type": "object"
        },
        "ExtractionQualityMetricEntry": {
          "properties": {
            "dedup_skipped": {
              "format": "int64",
              "type": "integer"
            },
            "extracted": {
              "format": "int64",
              "type": "integer"
            },
            "novelty_skipped": {
              "format": "int64",
              "type": "integer"
            },
            "written": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "extracted",
            "dedup_skipped",
            "novelty_skipped",
            "written"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "agents": {
          "items": {
            "$ref": "#/$defs/AgentMetricEntry"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "window_days": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "window_days"
      ],
      "type": "object"
    }
  },
