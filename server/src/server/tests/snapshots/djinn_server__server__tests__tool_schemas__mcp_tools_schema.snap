    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$defs": {
        "VerificationRule": {
          "additionalProperties": false,
          "description": "One verification rule.\n\nField names and semantics match the pre-cut-over\n`djinn_db::repositories::project::VerificationRule`, so the P5 boot hook\ncan copy `projects.verification_rules` straight into\n`environment_config.verification.rules` without a translation step.",
          "properties": {
            "commands": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "match_pattern": {
              "type": "string"
            }
          },
          "required": [
            "match_pattern",
            "commands"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "project": {
          "description": "Project UUID or `owner/repo` slug.",
          "type": "string"
        },
        "rules": {
          "description": "Full replacement set of verification rules (glob `match_pattern` +\nshell `commands`). Validated server-side before persisting.",
          "items": {
            "$ref": "#/$defs/VerificationRule"
          },
          "type": "array"
        },
        "test_id": {
          "default": null,
          "description": "Id from a prior `project_verification_test` whose run PASSED, proving\nthese exact rules work. REQUIRED when `rules` is non-empty (the save is\nrejected otherwise, so a broken rule can't disrupt live tasks); an empty\nrule set needs no test.",
          "nullable": true,
          "type": "string"
        }
      },
      "required": [
        "project",
        "rules"
      ],
      "title": "ProjectVerificationSetParams",
      "type": "object"
    },
    "output_schema": {
