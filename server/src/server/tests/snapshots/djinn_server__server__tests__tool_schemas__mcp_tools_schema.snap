              "type": "string"
            },
            "source_id": {
              "type": "string"
            },
            "source_permalink": {
              "type": "string"
            },
            "source_title": {
              "type": "string"
            }
          },
          "required": [
            "source_id",
            "source_permalink",
            "source_title",
            "raw_text"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
