          "items": {
            "type": "string"
          },
          "nullable": true,
          "type": "array"
        },
        "blocked_by_remove": {
          "description": "Epic dependencies to remove (UUIDs or short_ids).",
          "items": {
            "type": "string"
          },
          "nullable": true,
          "type": "array"
        },
        "color": {
          "nullable": true,
          "type": "string"
        },
        "description": {
          "nullable": true,
          "type": "string"
        },
        "emoji": {
          "nullable": true,
          "type": "string"
        },
        "id": {
          "description": "Epic UUID or short_id.",
          "type": "string"
        },
        "memory_refs": {
          "description": "Memory reference URLs for this epic (e.g. ADR paths).",
          "items": {
            "type": "string"
          },
          "nullable": true,
          "type": "array"
        },
        "owner": {
          "nullable": true,
          "type": "string"
        },
        "project": {
          "description": "Absolute project path.",
          "type": "string"
        },
        "status": {
          "description": "Target lifecycle status: \"open\" or \"closed\".",
          "nullable": true,
          "type": "string"
        },
        "title": {
          "nullable": true,
          "type": "string"
        }
      },
      "required": [
        "project",
        "id"
      ],
      "title": "EpicUpdateParams",
      "type": "object"
    },
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "auto_breakdown": {
          "description": "ADR-051 Epic C — mirrors `Epic::auto_breakdown`.",
          "type": "boolean"
        },
        "closed_at": {
          "nullable": true,
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "created_by_user_id": {
          "description": "Real user FK of the epic's creator (NULL for system/unowned epics).\nSurfaced so the board can scope epics to the owner filter, mirroring\n`TaskModel::created_by_user_id`.",
          "nullable": true,
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "emoji": {
          "type": "string"
        },
        "error": {
          "nullable": true,
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "memory_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "originating_adr_id": {
          "description": "ADR-051 Epic C — mirrors `Epic::originating_adr_id`.",
          "nullable": true,
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "short_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      },
      "title": "EpicSingleResponse",
      "type": "object"
    }
  },
