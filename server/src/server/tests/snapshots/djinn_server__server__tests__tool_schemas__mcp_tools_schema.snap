[
  {
    "name": "agent_create",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$defs": {
        "AnyJson": {}
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "base_role": {
          "description": "Base role to extend. One of: worker, lead, planner, architect, reviewer.",
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "mcp_servers": {
          "description": "Additional MCP server refs for this agent.",
          "items": {
            "$ref": "#/$defs/AnyJson"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "model_preference": {
          "description": "Preferred model ID (falls back to project default).",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Unique agent name within the project.",
          "type": "string"
        },
        "project": {
          "description": "Absolute project path.",
          "type": "string"
        },
        "skills": {
          "description": "Skills (prompt templates) available to this agent.",
          "items": {
            "$ref": "#/$defs/AnyJson"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "system_prompt_extensions": {
          "description": "Additional system prompt content appended to the base role prompt.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "project",
        "name",
        "base_role"
      ],
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "AnyJson": {}
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "base_role": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "is_default": {
          "type": "boolean"
        },
        "mcp_servers": {
          "items": {
            "$ref": "#/$defs/AnyJson"
          },
          "type": "array"
        },
        "model_preference": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "skills": {
          "items": {
            "$ref": "#/$defs/AnyJson"
          },
          "type": "array"
        },
        "system_prompt_extensions": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  {
    "name": "agent_list",
