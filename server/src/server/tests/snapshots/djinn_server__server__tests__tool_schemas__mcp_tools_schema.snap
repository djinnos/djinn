  {
    "name": "model_health",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "action": {
          "default": "status",
          "description": "Action to perform: status (view all, default), reset (reset one model),\nreset_all (reset all models), enable (re-enable auto-disabled model).",
          "type": "string"
        },
        "model": {
          "description": "Model ID (required for reset and enable actions).",
          "nullable": true,
          "type": "string"
        }
      },
      "title": "ModelHealthInput",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "ModelHealthOutput": {
          "properties": {
            "auto_disabled": {
              "type": "boolean"
            },
            "consecutive_failures": {
              "format": "int64",
              "type": "integer"
            },
            "cooldown_seconds_remaining": {
              "format": "int64",
              "nullable": true,
              "type": "integer"
            },
            "disable_ttl_trips": {
              "format": "int64",
              "type": "integer"
            },
            "model_id": {
              "type": "string"
            },
            "scope": {
              "description": "Owning user the breaker bucket is scoped to; `null` = shared/system\nbucket (org-shared credential). Health is tracked per `(scope, model)`,\nso the same model can appear once per user that has used it.",
              "nullable": true,
              "type": "string"
            },
            "total_failures": {
              "format": "int64",
              "type": "integer"
            },
            "total_successes": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "model_id",
            "auto_disabled",
            "consecutive_failures",
            "total_failures",
            "total_successes",
            "disable_ttl_trips"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "action": {
          "type": "string"
        },
        "error": {
          "nullable": true,
          "type": "string"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/ModelHealthOutput"
          },
          "type": "array"
        }
      },
      "required": [
        "action",
        "models"
      ],
      "title": "ModelHealthResponse",
      "type": "object"
    }
  },
  {
    "name": "pr_review_context",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$defs": {
        "BoundaryRule": {
          "description": "A single boundary-check rule — a pair of globs. Every rule is\ntreated as a forbidden edge; callers submit only the rules they want\nflagged as violations.",
          "properties": {
            "from_glob": {
              "type": "string"
            },
            "to_glob": {
              "type": "string"
            }
          },
          "required": [
            "from_glob",
            "to_glob"
          ],
          "type": "object"
        },
        "ChangedRange": {
          "description": "A single `(file, start_line, end_line)` hunk from a parsed diff. The\ncaller supplies one of these per `git diff --unified=0` hunk when\ninvoking the `diff_touches` op on the `code_graph` tool.",
          "properties": {
            "end_line": {
              "description": "Inclusive 1-indexed last line of the hunk. Defaults to `start_line`\nwhen the caller passed a single-line hunk.",
              "format": "int64",
              "nullable": true,
              "type": "integer"
            },
            "file": {
              "description": "Repository-relative path of the file the hunk lives in.",
              "type": "string"
            },
            "start_line": {
              "description": "Inclusive 1-indexed first line of the hunk.",
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "file",
            "start_line"
          ],
          "type": "object"
        },
        "PrReviewCaps": {
          "description": "Per-list caps overriding the built-in defaults. Any field left\n`None` uses the default from `default_caps`.",
          "properties": {
            "blast_radius": {
              "format": "int64",
              "nullable": true,
              "type": "integer"
            },
            "hot_path_overlap": {
              "format": "int64",
              "nullable": true,
              "type": "integer"
            },
            "hotspot_overlap": {
              "format": "int64",
              "nullable": true,
              "type": "integer"
            },
            "touched_boundary_violations": {
              "format": "int64",
              "nullable": true,
              "type": "integer"
            },
            "touched_cycles": {
              "format": "int64",
              "nullable": true,
              "type": "integer"
            },
            "touched_deprecated": {
              "format": "int64",
              "nullable": true,
              "type": "integer"
            },
            "touched_symbols": {
              "format": "int64",
              "nullable": true,
              "type": "integer"
            }
          },
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "Input parameters for the `pr_review_context` meta-tool.",
      "properties": {
        "boundary_rules": {
          "default": [],
          "description": "Architecture boundary rules. When empty, boundary analysis is\nskipped and [`PrReviewContextResponse::touched_boundary_violations`]\nis empty.",
          "items": {
            "$ref": "#/$defs/BoundaryRule"
          },
          "type": "array"
        },
        "caps": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrReviewCaps"
            },
            {
              "const": null,
              "nullable": true
            }
          ],
          "description": "Per-list result caps. Missing fields fall back to the defaults\nencoded in `ResolvedCaps::default_caps`."
        },
        "changed_ranges": {
          "description": "Hunks parsed from `git diff --unified=0 base..head`. Must be\nnon-empty for the tool to return useful signal.",
          "items": {
            "$ref": "#/$defs/ChangedRange"
          },
          "type": "array"
        },
        "hotspots_window_days": {
          "default": null,
          "description": "Churn look-back window for the hotspot overlap. Defaults to 90.",
          "format": "int64",
          "nullable": true,
          "type": "integer"
        },
        "project": {
          "description": "Project identifier — either the UUID (`project_id`) or the\ncanonical `\"owner/repo\"` slug. The handler resolves it to the\nserver-managed clone path via `djinn_core::paths::project_dir`\nbefore dispatching to the graph backend.",
          "type": "string"
        },
        "seed_entries": {
          "default": [],
          "description": "Entry-point SCIP keys (route handlers, `main`, etc.) used when\ncomputing [`PrReviewContextResponse::hot_path_overlap`].",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "seed_sinks": {
          "default": [],
          "description": "Sink SCIP keys (DB queries, external APIs, etc.) used when\ncomputing [`PrReviewContextResponse::hot_path_overlap`].",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "project",
        "changed_ranges"
      ],
      "title": "PrReviewContextParams",
      "type": "object"
    },
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": true,
      "title": "ErrorOrPrReviewContextResponse",
      "type": "object"
    }
  },
