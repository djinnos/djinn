          "nullable": true,
          "type": "string"
        }
      },
      "required": [
        "project"
      ],
      "title": "TaskListParams",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "AcceptanceCriterionItem": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/AcceptanceCriterionStatus"
            }
          ]
        },
        "AcceptanceCriterionStatus": {
          "properties": {
            "criterion": {
              "type": "string"
            },
            "met": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "criterion"
          ],
          "type": "object"
        },
        "TaskListItem": {
          "properties": {
            "acceptance_criteria": {
              "items": {
                "$ref": "#/$defs/AcceptanceCriterionItem"
              },
              "type": "array"
            },
            "active_session": {
              "description": "Active running session for this task, if any.",
              "nullable": true,
              "properties": {
                "agent_type": {
                  "type": "string"
                },
                "model_id": {
                  "type": "string"
                },
                "session_id": {
                  "type": "string"
                },
                "started_at": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                }
              },
              "required": [
                "session_id",
                "agent_type",
                "model_id",
                "started_at",
                "status"
              ],
              "type": "object"
            },
            "agent_type": {
              "description": "Specialist role name assigned to this task, if any.",
              "nullable": true,
              "type": "string"
            },
            "close_reason": {
              "nullable": true,
              "type": "string"
            },
            "closed_at": {
              "nullable": true,
              "type": "string"
            },
            "continuation_count": {
              "format": "int64",
              "type": "integer"
            },
            "created_at": {
              "type": "string"
            },
            "created_by_user_id": {
              "description": "Stable `users.id` of whoever this task belongs to (session creator, or\nthe parent epic's creator for Planner-spawned tasks). `None` for tasks\nwith no human owner. Resolve to a display name via the org user list.",
              "nullable": true,
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "design": {
              "type": "string"
            },
            "epic_id": {
              "nullable": true,
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "intervention_count": {
              "format": "int64",
              "type": "integer"
            },
            "issue_type": {
              "type": "string"
            },
            "labels": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "last_intervention_at": {
              "nullable": true,
              "type": "string"
            },
            "memory_refs": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "merge_commit_sha": {
              "nullable": true,
              "type": "string"
            },
            "merge_conflict_metadata": {
              "additionalProperties": true,
              "description": "JSON metadata about an active merge conflict (files, branches).",
              "nullable": true,
              "type": "object"
            },
            "owner": {
              "type": "string"
            },
            "pr_url": {
              "description": "URL of the associated pull request, once one has been opened.",
              "nullable": true,
              "type": "string"
            },
            "priority": {
              "format": "int64",
              "type": "integer"
            },
            "reopen_count": {
              "format": "int64",
              "type": "integer"
            },
            "session_count": {
              "description": "Total number of sessions that have worked on this task.",
              "format": "int64",
              "type": "integer"
            },
            "short_id": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "total_reopen_count": {
              "format": "int64",
              "type": "integer"
            },
            "unresolved_blocker_count": {
              "format": "int64",
              "type": "integer"
            },
            "updated_at": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "short_id",
            "title",
            "description",
            "design",
            "issue_type",
            "status",
            "priority",
            "owner",
            "labels",
            "memory_refs",
            "acceptance_criteria",
            "reopen_count",
            "continuation_count",
            "total_reopen_count",
            "intervention_count",
            "created_at",
            "updated_at",
            "unresolved_blocker_count",
            "session_count"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "has_more": {
          "type": "boolean"
        },
        "limit": {
          "format": "int64",
          "type": "integer"
        },
        "offset": {
