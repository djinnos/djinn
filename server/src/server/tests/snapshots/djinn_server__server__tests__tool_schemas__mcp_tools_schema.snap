  {
    "name": "proposal_stop_build",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "id": {
          "description": "Proposal UUID or short_id (must be `building`).",
          "type": "string"
        },
        "mode": {
          "description": "`abort` (tear the build down and revert to `approved`), `freeze` (hold\nthe build's tasks out of dispatch, leaving epics/tasks/branches in\nplace), or `unfreeze` (resume a frozen build).",
          "type": "string"
        },
        "preview": {
          "description": "When true on `abort`, compute and return the blast radius (epics, open\ntasks, running sessions) WITHOUT mutating anything.",
          "nullable": true,
          "type": "boolean"
        },
        "reason": {
          "description": "Why the build is being stopped. Recorded as the force-close reason on\neach torn-down task. Required for `abort`.",
          "nullable": true,
          "type": "string"
        }
      },
      "required": [
        "id",
        "mode"
      ],
      "title": "ProposalStopBuildParams",
      "type": "object"
    },
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "epics_closed": {
          "description": "Epics torn down (abort) or that would be (preview).",
          "format": "int64",
          "type": "integer"
        },
        "error": {
          "nullable": true,
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "preview": {
          "description": "`true` when this was a dry-run that did not mutate anything.",
          "type": "boolean"
        },
        "proposal_id": {
          "nullable": true,
          "type": "string"
        },
        "sessions_killed": {
          "description": "Running worker sessions killed (abort) or live now (preview).",
          "format": "int64",
          "type": "integer"
        },
        "status": {
          "description": "Resulting proposal status (`approved` after a non-preview abort,\n`building` after freeze/unfreeze/preview).",
          "nullable": true,
          "type": "string"
        },
        "tasks_closed": {
          "description": "Worker tasks force-closed (abort) or open right now (preview).",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "ok",
        "mode",
        "preview",
        "epics_closed",
        "tasks_closed",
        "sessions_killed"
      ],
