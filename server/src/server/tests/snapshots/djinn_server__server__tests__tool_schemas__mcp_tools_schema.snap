  {
    "name": "memory_repair_embeddings",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "force": {
          "description": "If true, re-embed every note even if its content hash already matches.\nDefault false: only notes with missing or stale embeddings are repaired.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "project": {
          "description": "Project path, slug, or id (same forms accepted by other memory tools).",
          "type": "string"
        }
      },
      "required": [
        "project"
      ],
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "MemoryRepairEmbeddingFailure": {
          "properties": {
            "note_id": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "note_id",
            "reason"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "code_chunks_failed": {
          "description": "Code chunks whose re-embed attempt failed.",
          "format": "int64",
          "type": "integer"
        },
        "code_chunks_repaired": {
          "description": "Code chunks that received a fresh embedding during this run.",
          "format": "int64",
          "type": "integer"
        },
        "code_chunks_total": {
          "description": "Total code chunks scanned for the project. Always `0` until the\nchunker (PR B2) and embedding pipeline (PR B3) ship.",
          "format": "int64",
          "type": "integer"
        },
        "code_chunks_up_to_date": {
          "description": "Code chunks whose embedding meta was already current.",
          "format": "int64",
          "type": "integer"
        },
        "error": {
          "description": "Top-level failure: project not found, embedding provider unavailable, etc.",
          "type": [
            "string",
            "null"
          ]
        },
        "failed": {
          "description": "Notes whose re-embed attempt failed (Qdrant down, model error, …).",
          "format": "int64",
          "type": "integer"
        },
        "failures": {
          "description": "First-N failures (capped to keep the response small).",
          "items": {
            "$ref": "#/$defs/MemoryRepairEmbeddingFailure"
          },
          "type": "array"
        },
        "repaired": {
          "description": "Notes that received a fresh embedding during this run.",
          "format": "int64",
          "type": "integer"
        },
        "total": {
          "description": "Total notes scanned for the project.",
          "format": "int64",
          "type": "integer"
        },
        "up_to_date": {
          "description": "Notes whose embedding meta was already current; no work performed.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "total",
        "repaired",
        "up_to_date",
        "failed",
        "failures",
        "code_chunks_total",
        "code_chunks_repaired",
        "code_chunks_up_to_date",
        "code_chunks_failed"
      ],
      "type": "object"
    }
  },
  {
    "name": "memory_run_enrichment",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "background": {
          "description": "When true, schedule enrichment on a background tokio task and return\nimmediately with `status=\"queued\"`. When false (the default), run the\npass synchronously and embed the structured report in the response.\n\nBackground execution mirrors the diei roadmap's \"best-effort, never\nblocks retrieval\" constraint: the spawn path yields to the runtime so\n`memory_graph` (and the wider MCP surface) keep serving while the\npass runs.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "project": {
          "description": "Project path, slug, or id (same forms accepted by other memory tools).",
          "type": "string"
        }
      },
      "required": [
        "project"
      ],
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "EnrichmentClaim": {
          "description": "Claim node extracted by the enrichment pass — a decision or assertion the\nmemory records.",
          "properties": {
            "evidence_quote": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "source_note_id": {
              "type": "string"
            },
            "statement": {
              "type": "string"
            }
          },
          "required": [
            "statement",
            "source_note_id"
          ],
          "type": "object"
        },
        "EnrichmentEdge": {
          "description": "Typed implicit edge between two notes (`builds_on` / `contradicts` /\n`supersedes` / `exemplifies` / `derived_from`).",
          "properties": {
            "confidence": {
              "description": "Confidence in [0.0, 1.0].",
              "format": "double",
              "type": "number"
            },
            "evidence_quote": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string"
            },
            "source_note_id": {
              "type": "string"
            },
            "target_note_id": {
              "type": "string"
            }
          },
          "required": [
            "source_note_id",
            "target_note_id",
            "kind",
            "confidence"
          ],
          "type": "object"
        },
        "EnrichmentEntity": {
          "description": "Entity node extracted by the enrichment pass — recurring system or concept\n(\"dispatch gate\", \"circuit breaker\", \"slot actor\").",
          "properties": {
            "aliases": {
              "default": [],
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "canonical_name": {
              "type": "string"
            }
          },
          "required": [
            "canonical_name"
          ],
          "type": "object"
        },
        "EnrichmentReport": {
          "description": "Structured report returned by the enrichment pass.\n\nMirrors `djinn_slot::memory_enrichment::EnrichmentReport`\none-for-one. The server-side bridge converts between the two at the\nimplementation boundary so the MCP wire shape stays stable.",
          "properties": {
            "batches_sent": {
              "format": "int64",
              "type": "integer"
            },
            "claims": {
              "default": [],
              "items": {
                "$ref": "#/$defs/EnrichmentClaim"
              },
              "type": "array"
            },
            "edges": {
              "default": [],
              "items": {
                "$ref": "#/$defs/EnrichmentEdge"
              },
              "type": "array"
            },
            "edges_dropped_wikilink_dup": {
              "format": "int64",
              "type": "integer"
            },
            "entities": {
              "default": [],
              "items": {
                "$ref": "#/$defs/EnrichmentEntity"
              },
              "type": "array"
            },
            "entity_merges": {
              "format": "int64",
              "type": "integer"
            },
            "notes_processed": {
              "description": "Number of source notes processed. Uses `i64` on the MCP wire to avoid\nnonstandard unsigned integer schema formats.",
              "format": "int64",
              "type": "integer"
            },
            "project_id": {
              "type": "string"
            },
            "warnings": {
              "default": [],
              "description": "Non-fatal warnings — provider errors, parse failures, etc. The pass\nalways succeeds; warnings are surfaced in the response, never\npropagated as blocking failures.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "project_id",
            "notes_processed",
            "batches_sent",
            "entity_merges",
            "edges_dropped_wikilink_dup"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "error": {
          "description": "Top-level failure: project not found, enrichment subsystem not\nconfigured, provider errors that propagate before the pass begins.\nPer-batch provider failures land in `report.warnings` rather than\nhere — the pass is best-effort and never blocks retrieval.",
          "type": [
            "string",
            "null"
          ]
        },
        "project_id": {
          "description": "Resolved DB project id (slug → id translation is performed by the\ntool's project resolver, same as every other memory tool).",
          "type": [
            "string",
            "null"
          ]
        },
        "report": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnrichmentReport"
            },
            {
              "type": "null"
            }
          ],
          "description": "Structured enrichment report. Present only when\n`status=\"completed\"`. None when queued, and None when the trigger\nfails (in which case `error` is populated)."
        },
        "status": {
          "description": "Status of the trigger call — see [`crate::bridge::EnrichmentStatus`].",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    }
  },
  {
    "name": "memory_search",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "edge_kinds": {
          "description": "Optional list of edge kinds to include in graph traversal scoring.\nWhen provided, only edges whose `kind` matches one of these values\nparticipate in spreading activation. Omit to use all edge kinds.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "entity_types": {
          "description": "Optional list of entity types to include: \"note\", \"proposal\".\nOmit (or pass null) to include both. Pass [\"note\"] for notes-only,\n[\"proposal\"] for proposals-only. Pass [] to return no results.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "folder": {
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "project": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "project",
        "query"
      ],
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "MemorySearchResultItem": {
          "description": "A single unified search result row.\n\nEntity taxonomy: the `entity` field discriminates the row type.\nCurrent values are `\"note\"` (memory notes) and `\"proposal\"` (planning\nproposals). Future waves may add `\"task\"` or `\"epic\"`. Use the\n`entity_types` field on the `SearchParams` request to scope the result\nset to a subset of entity types.",
          "properties": {
            "entity": {
              "default": "note",
              "description": "`\"note\"` | `\"proposal\"` — discriminates unified search results.",
              "type": "string"
            },
            "folder": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "note_type": {
              "type": "string"
            },
            "permalink": {
              "type": "string"
            },
            "score": {
              "default": 0.0,
              "description": "RRF fusion score (higher = more relevant). Defaults to 0.0 for backward compat.",
              "format": "double",
              "type": "number"
            },
            "snippet": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "permalink",
            "title",
            "folder",
            "note_type",
            "snippet"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "results": {
          "items": {
            "$ref": "#/$defs/MemorySearchResultItem"
          },
          "type": "array"
        }
      },
      "required": [
        "results"
      ],
      "type": "object"
    }
  },
