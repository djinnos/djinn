  {
    "name": "memory_associations",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "identifier": {
          "description": "Note ID or permalink (e.g. \"decisions/my-adr\").",
          "type": "string"
        },
        "limit": {
          "description": "Maximum number of results. Default: 20.",
          "format": "int64",
          "nullable": true,
          "type": "integer"
        },
        "min_weight": {
          "description": "Minimum association weight [0.0, 1.0]. Default: 0.0 (all associations).",
          "format": "double",
          "nullable": true,
          "type": "number"
        },
        "project": {
          "type": "string"
        }
      },
      "required": [
        "project",
        "identifier"
      ],
      "title": "AssociationsParams",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "MemoryAssociationEntry": {
          "properties": {
            "co_access_count": {
              "format": "int64",
              "type": "integer"
            },
            "kind": {
              "default": "",
              "description": "Association edge kind as stored on `note_associations.kind` (e.g. `\"co_access\"`).\nToday the only value written is `\"co_access\"`; future wave-1 graph-typed edges\n(builds_on / contradicts / supersedes / exemplifies) will widen the value set\n— see Epic 2chl. `#[serde(default)]` keeps older clients deserialising cleanly\nuntil they adopt the new field.",
              "type": "string"
            },
            "last_co_access": {
              "type": "string"
            },
            "note_permalink": {
              "type": "string"
            },
            "note_title": {
              "type": "string"
            },
            "weight": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "note_permalink",
            "note_title",
            "weight",
            "co_access_count",
            "last_co_access"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "associations": {
          "items": {
            "$ref": "#/$defs/MemoryAssociationEntry"
          },
          "type": "array"
        },
        "error": {
          "nullable": true,
          "type": "string"
        }
      },
      "required": [
        "associations"
      ],
      "title": "MemoryAssociationsResponse",
      "type": "object"
    }
  },
