  {
    "name": "epic_update",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "blocked_by_add": {
          "description": "Epic dependencies: epics (UUIDs or short_ids) that must CLOSE before\nthis epic's wave-1 breakdown auto-dispatches. May reference epics in\nother projects (cross-repo ordering). Cycles are rejected.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "blocked_by_remove": {
          "description": "Epic dependencies to remove (UUIDs or short_ids).",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "emoji": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Epic UUID or short_id.",
          "type": "string"
        },
        "memory_refs": {
          "description": "Memory reference URLs for this epic (e.g. ADR paths).",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "description": "Absolute project path.",
          "type": "string"
        },
        "status": {
          "description": "Target lifecycle status: \"open\" or \"closed\".",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "project",
        "id"
      ],
      "type": "object"
    },
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "auto_breakdown": {
          "description": "ADR-051 Epic C — mirrors `Epic::auto_breakdown`.",
          "type": "boolean"
        },
        "closed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "color": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "created_by_user_id": {
          "description": "Real user FK of the epic's creator (NULL for system/unowned epics).\nSurfaced so the board can scope epics to the owner filter, mirroring\n`TaskModel::created_by_user_id`.",
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string"
        },
        "emoji": {
          "type": "string"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "memory_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "originating_adr_id": {
          "description": "ADR-051 Epic C — mirrors `Epic::originating_adr_id`.",
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "type": "string"
        },
        "short_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  {
    "name": "execution_kill_task",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "project": {
          "description": "Project path (accepted for API compatibility, currently unused).",
          "type": [
            "string",
            "null"
          ]
        },
        "task_id": {
          "description": "Task ID to interrupt.",
          "type": "string"
        }
      },
      "required": [
        "task_id"
      ],
      "type": "object"
    },
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "ok": {
          "type": "boolean"
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "ok"
      ],
      "type": "object"
    }
  },
  {
    "name": "get_block_catalog",
    "read_only": true,
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "BlockCatalogEntry": {
          "description": "A single entry in the lean block catalog: just the stable type tag and\nMDX component tag name, loaded from `proposal_block_catalog.json`.",
          "properties": {
            "tag": {
              "description": "MDX component tag, e.g. `AnnotatedCode`.",
              "type": "string"
            },
            "type": {
              "description": "Stable kebab-case block type, e.g. `annotated-code`.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "tag"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "blocks": {
          "items": {
            "$ref": "#/$defs/BlockCatalogEntry"
          },
          "type": "array"
        }
      },
      "required": [
        "blocks"
      ],
      "type": "object"
    }
  },
  {
    "name": "get_project_devcontainer_status",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "project": {
          "description": "Project UUID whose devcontainer + image status should be returned.",
          "type": "string"
        }
      },
      "required": [
        "project"
      ],
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "WorkspaceWarmStatusEntry": {
          "description": "A single per-workspace graph-warm result, projected from a\n`project_workspace_graph` row (the durable freshness source of truth).",
          "properties": {
            "commit_sha": {
              "description": "Commit SHA the row was warmed at, when recorded.",
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "description": "Persisted warm status: `ready | warming | failed | timed_out`.\n`failed`/`timed_out` mean the indexer produced no SCIP artifact for\nthis workspace, even if the overall project graph warmed from other\nworkspaces.",
              "type": "string"
            },
            "warmed_at": {
              "description": "ISO-8601 UTC timestamp of the last warm attempt for this workspace.",
              "type": [
                "string",
                "null"
              ]
            },
            "workspace_slug": {
              "description": "Workspace slug (matches the `code_graph workspaces` op).",
              "type": "string"
            }
          },
          "required": [
            "workspace_slug",
            "status"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "error": {
          "description": "Populated on lookup failures; clients should surface this verbatim.",
          "type": [
            "string",
            "null"
          ]
        },
        "graph_warm_status": {
          "description": "Derived status for the UI banner. One of\n`pending | running | ready | warning | degraded | failed`.\n`pending` means no warm has ever run; `running` means the image is\nready and a warm should be in flight (or imminent); `ready` means\nderived graph freshness exists and every workspace warmed cleanly;\n`warning` means a non-fatal graph-cache shrink backstop fired — the\ncache is still fresh and graph usage is unaffected, but operators\nshould inspect the matching `workspace_warm_statuses` row;\n`degraded` means the overall graph warmed but at least one workspace\nrow is `failed`/`timed_out` (partial success — the graph is usable\nbut incomplete; the failing workspaces are listed in\n`workspace_warm_statuses`); `failed` means the image build failed\n(no warm possible) or a `failed`/`timed_out` workspace exists with\nno successful warm at all. `failed`/`timed_out` always override a\nshrink warning.",
          "type": "string"
        },
        "graph_warmed_at": {
          "description": "ISO-8601 UTC timestamp derived from per-workspace graph freshness\nor the merged repo graph cache. `None` means no freshness source has\ncompleted yet (cold project or failing pipeline). Dispatch no longer\nblocks on this value; it is badge metadata retained under a\ncompatibility field name.",
          "type": [
            "string",
            "null"
          ]
        },
        "image_last_error": {
          "description": "Human-readable error from the most recent failed build, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "image_status": {
          "description": "One of `none | building | ready | failed`. Reflects the project's\nassigned **catalog** image (migration 46) — projects no longer build a\nbespoke per-project image.",
          "type": "string"
        },
        "image_tag": {
          "description": "Content-addressable image tag from the last successful build, or\n`None` when no build has completed.",
          "type": [
            "string",
            "null"
          ]
        },
        "needs_image": {
          "description": "`true` when the project has no catalog image assigned yet — it needs\nsetup (pick an image) before it can build/dispatch. The UI surfaces\nthis as a distinct \"Needs image\" state rather than a build status.",
          "type": "boolean"
        },
        "workspace_warm_statuses": {
          "default": [],
          "description": "Per-workspace graph warm results, sourced from the durable\n`project_workspace_graph` rows (the same source the `code_graph\nworkspaces` op reads). Entries with `failed` or `timed_out` explain\nwhich workspace did not produce a SCIP artifact even when another\nworkspace succeeded and the overall warm reports `degraded`.",
          "items": {
            "$ref": "#/$defs/WorkspaceWarmStatusEntry"
          },
          "type": "array"
        }
      },
      "required": [
        "image_status",
        "needs_image",
        "graph_warm_status"
      ],
      "type": "object"
    }
  },
  {
    "name": "get_project_stack",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "project": {
          "description": "Project UUID whose detected stack should be returned.",
          "type": "string"
        }
      },
      "required": [
        "project"
      ],
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "LanguageStat": {
          "properties": {
            "bytes": {
              "format": "int64",
              "type": "integer"
            },
            "name": {
              "type": "string"
            },
            "pct": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "name",
            "bytes",
            "pct"
          ],
          "type": "object"
        },
        "ManifestSignals": {
          "properties": {
            "has_cargo_toml": {
              "type": "boolean"
            },
            "has_go_mod": {
              "type": "boolean"
            },
            "has_package_json": {
              "type": "boolean"
            },
            "has_pnpm_workspace": {
              "type": "boolean"
            },
            "has_pyproject_toml": {
              "type": "boolean"
            },
            "has_turbo_json": {
              "type": "boolean"
            }
          },
          "required": [
            "has_package_json",
            "has_cargo_toml",
            "has_pyproject_toml",
            "has_go_mod",
            "has_pnpm_workspace",
            "has_turbo_json"
          ],
          "type": "object"
        },
        "Runtimes": {
          "properties": {
            "go": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "node": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "python": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "rust": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "Stack": {
          "description": "Top-level stack descriptor — one per project, recomputed on every\nmirror fetch.",
          "properties": {
            "detected_at": {
              "description": "Wall-clock timestamp of the detection pass.",
              "type": "string"
            },
            "frameworks": {
              "description": "Slugs: `react`, `next`, `vue`, `svelte`, `axum`, `actix`,\n`rocket`, `fastapi`, `flask`, `django`, `rails`, `spring`.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "is_monorepo": {
              "description": "Derived: `monorepo_tools` is non-empty.",
              "type": "boolean"
            },
            "languages": {
              "description": "Languages detected by extension, sorted descending by byte share.",
              "items": {
                "$ref": "#/$defs/LanguageStat"
              },
              "type": "array"
            },
            "manifest_signals": {
              "$ref": "#/$defs/ManifestSignals",
              "description": "Boolean presence flags for the manifests / top-level files the\ndownstream consumers care about. Drives the UI devcontainer\nbanner."
            },
            "monorepo_tools": {
              "description": "Slugs: `pnpm-workspaces`, `yarn-workspaces`, `npm-workspaces`,\n`turbo`, `nx`, `lerna`, `cargo-workspace`, `go-workspace`.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "package_managers": {
              "description": "Canonical slugs: `npm`, `pnpm`, `yarn`, `bun`, `cargo`, `uv`,\n`poetry`, `pdm`, `pip`, `go-mod`, `gradle`, `maven`, `bundler`.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "primary_language": {
              "description": "The single language with the largest byte share (first entry of\n`languages` by construction), or `None` for an empty repo.",
              "type": [
                "string",
                "null"
              ]
            },
            "runtimes": {
              "$ref": "#/$defs/Runtimes",
              "description": "Declared runtime versions (e.g. `{\"node\": \"22\"}`). `None` when\nthe manifest exists but the field is absent.\n\nThis is \"*a* version\" for each language — convenient for the UI\nbanner and Phase-3 image hashing. Multi-toolchain callers\n(post-env-config P5) read [`Stack::workspaces`] instead, since a\nsingle string can't express \"two Rust crates pinned to different\ntoolchains\"."
            },
            "test_runners": {
              "description": "Slugs: `vitest`, `jest`, `mocha`, `playwright`, `nextest`,\n`pytest`, `go-test`, `junit`, `rspec`.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "workspaces": {
              "default": [],
              "description": "Per-workspace toolchain detail — one entry per manifest dir that\nthe detector considered a distinct workspace root. Populated by\n[`detect`]; empty when no manifests are present.\n\nUsed by [`crate::environment::EnvironmentConfig::from_stack`] to\nseed `environment_config.workspaces` during the P5 boot reseed\nhook.",
              "items": {
                "$ref": "#/$defs/StackWorkspace"
              },
              "type": "array"
            }
          },
          "required": [
            "detected_at",
            "languages",
            "package_managers",
            "monorepo_tools",
            "is_monorepo",
            "test_runners",
            "frameworks",
            "runtimes",
            "manifest_signals"
          ],
          "type": "object"
        },
        "StackWorkspace": {
          "description": "One workspace the detector spotted in a mirror. A \"workspace\" here\nmeans \"a directory that owns its own package manifest and deserves\nits own toolchain scope\" — not every member crate in a Cargo\nworkspace, but the Cargo-workspace root itself (or a lone Cargo\ncrate without a workspace table); plus every `package.json`,\n`pyproject.toml`, `go.mod`, `Gemfile`, `pom.xml`, and root-level\nbuild.gradle(.kts) found at any depth.\n\nThe detector de-duplicates by \"shallowest ancestor per language\":\nif `repo/server/Cargo.toml` is already a workspace, a member\n`repo/server/crates/foo/Cargo.toml` does *not* also get emitted.\nThat keeps the toolchain list bounded for typical monorepos while\nstill emitting two Rust entries when two unrelated Cargo workspaces\nsit next to each other (the motivating case for the env-config\nrefactor).",
          "properties": {
            "language": {
              "description": "Canonical language slug: `rust` | `node` | `python` | `go` |\n`java` | `ruby` (future: `dotnet` | `clang`).",
              "type": "string"
            },
            "package_manager": {
              "description": "Package-manager slug pinned by the manifest, when it carries one.\nCurrently populated for `node` (`packageManager` or lockfile\nfallback) and `python` (`uv` / `poetry` / `pdm` / `pip`).",
              "type": [
                "string",
                "null"
              ]
            },
            "root": {
              "description": "Repo-relative path to the workspace directory (forward-slash,\nnever absolute, no `..`). The empty string represents the repo\nroot.",
              "type": "string"
            },
            "toolchain": {
              "description": "Toolchain / version the manifest pins, in its raw form.\n* rust: channel from `rust-toolchain.toml` or\n  `package.rust-version` (e.g. `\"stable\"`, `\"1.85.0\"`,\n  `\"nightly-2026-04-01\"`).\n* node: major from `engines.node` (e.g. `\"22\"`).\n* python: major.minor from `requires-python` (e.g. `\"3.12\"`).\n* go: `go` directive (e.g. `\"1.22\"`).\n* java/ruby: currently unused — left `None`.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "root",
            "language"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "error": {
          "description": "Populated on lookup / deserialization failures; clients should\nsurface this verbatim.",
          "type": [
            "string",
            "null"
          ]
        },
        "stack": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stack"
            },
            {
              "type": "null"
            }
          ],
          "description": "Detected stack metadata, or `None` when the project exists but no\ndetection has run yet (default `{}` in the DB) or when the\npersisted JSON fails to deserialize."
        }
      },
      "type": "object"
    }
  },
  {
    "name": "github_app_install_url",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object"
    },
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "status": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    }
  },
  {
    "name": "github_app_installations",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "InstallationEntry": {
          "properties": {
            "account_login": {
              "description": "`login` of the account (user or org) the App is installed on.",
              "type": "string"
            },
            "account_type": {
              "description": "Either \"User\" or \"Organization\".",
              "type": "string"
            },
            "id": {
              "description": "Numeric installation ID (used for scoping API calls server-side).",
              "format": "int64",
              "type": "integer"
            },
            "install_url": {
              "description": "Direct URL to review/configure this installation.",
              "type": "string"
            }
          },
          "required": [
            "id",
            "account_login",
            "account_type",
            "install_url"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "install_url": {
          "description": "URL to install the App when the user has no installations (or\nwants to add one). Always populated if `GITHUB_APP_SLUG` is set.",
          "type": [
            "string",
            "null"
          ]
        },
        "installations": {
          "items": {
            "$ref": "#/$defs/InstallationEntry"
          },
          "type": "array"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "installations"
      ],
      "type": "object"
    }
  },
  {
    "name": "github_fetch_file",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "end_line": {
          "default": null,
          "description": "Last line to return (1-based, inclusive). Omit for end of file.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "path": {
          "description": "File path within the repository (e.g. \"src/lib.rs\").",
          "type": "string"
        },
        "ref": {
          "default": null,
          "description": "Branch, tag, or commit SHA (default: HEAD / default branch).",
          "type": [
            "string",
            "null"
          ]
        },
        "repo": {
          "description": "Repository in \"owner/repo\" format (e.g. \"tokio-rs/tokio\").",
          "type": "string"
        },
        "start_line": {
          "default": null,
          "description": "First line to return (1-based, inclusive). Omit for start of file.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "repo",
        "path"
      ],
      "type": "object"
    },
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": true,
      "type": "object"
    }
  },
  {
    "name": "github_list_repos",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "per_page": {
          "default": null,
          "description": "Max number of repositories to return (1..=100). Defaults to 30.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "GithubRepoEntry": {
          "properties": {
            "account_login": {
              "description": "Login of the account (user or org) the installation is scoped to.",
              "type": "string"
            },
            "default_branch": {
              "type": "string"
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "installation_id": {
              "description": "GitHub App installation id that surfaced this repo. Pass this back\nto [`project_add_from_github`] to pin the clone to the same\ninstallation without re-scanning.",
              "format": "int64",
              "type": "integer"
            },
            "owner": {
              "type": "string"
            },
            "private": {
              "type": "boolean"
            },
            "repo": {
              "type": "string"
            }
          },
          "required": [
            "owner",
            "repo",
            "default_branch",
            "private",
            "installation_id",
            "account_login"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "repos": {
          "items": {
            "$ref": "#/$defs/GithubRepoEntry"
          },
          "type": "array"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "repos"
      ],
      "type": "object"
    }
  },
  {
    "name": "github_search",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "language": {
          "default": null,
          "description": "Programming language filter (e.g. \"Rust\", \"Python\", \"TypeScript\").",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "default": null,
          "description": "Maximum number of results to return (1–100, default 15).",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "path": {
          "default": null,
          "description": "Path filter to search within specific directories (e.g. \"src/\").",
          "type": [
            "string",
            "null"
          ]
        },
        "query": {
          "description": "Search query string. Supports GitHub code search syntax.",
          "type": "string"
        },
        "repo": {
          "default": null,
          "description": "Repository filter in \"owner/repo\" format (e.g. \"tokio-rs/tokio\").",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": true,
      "type": "object"
    }
  },
  {
    "name": "image_create",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$defs": {
        "CargoCachePolicy": {
          "description": "Per-project Cargo target-cache strategy override.\n\nThe default [`AutoDetected`](Self::AutoDetected) mode is detection-driven:\nconsumers resolve the policy by reading the project shape (Cargo workspace\nlayout, `.cargo/config.toml`, and configured setup command\npatterns) instead of hardcoding one universal compile set. That resolver is\nintentionally non-mutating. It may observe a project's `.cargo/config.toml`,\nincluding `rustc-wrapper = \"sccache\"` and feature-related settings, but it\nmust never create or modify `.cargo/config.toml`.",
          "oneOf": [
            {
              "description": "Resolve the policy from the project itself at warm/worker runtime.",
              "properties": {
                "mode": {
                  "const": "auto-detected",
                  "type": "string"
                }
              },
              "required": [
                "mode"
              ],
              "type": "object"
            },
            {
              "description": "Use this explicit, project-authored override instead of detection.",
              "properties": {
                "mode": {
                  "const": "explicit",
                  "type": "string"
                },
                "policy": {
                  "$ref": "#/$defs/CargoCachePolicyOverride"
                }
              },
              "required": [
                "mode",
                "policy"
              ],
              "type": "object"
            }
          ]
        },
        "CargoCachePolicyOverride": {
          "description": "Explicit Cargo target-cache policy used when auto-detection is overridden.\n\nNOT `deny_unknown_fields`: the dead `sccache`/`incremental` knobs were\nremoved once the platform began forcing `CARGO_INCREMENTAL=1` +\n`RUSTC_WRAPPER=\"\"` on every warm/verify/worker pod (PR #874). Stored rows\nmay still carry those keys; serde ignores them on read.",
          "properties": {
            "all_features": {
              "default": false,
              "description": "Whether warm and worker cargo commands should pass `--all-features`.",
              "type": "boolean"
            },
            "features": {
              "default": [],
              "description": "Feature names to pass consistently to warm and worker cargo commands.\nEmpty means default features only. Use `all_features` for\n`--all-features`; do not include `all-features` in this list.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "warm_commands": {
              "default": [],
              "description": "Warm-base cargo commands derived from or overridden for this project.",
              "items": {
                "$ref": "#/$defs/CargoWarmCommand"
              },
              "type": "array"
            },
            "workspace": {
              "default": false,
              "description": "Whether the Cargo root is a workspace rather than a single package.",
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "CargoWarmCommand": {
          "additionalProperties": false,
          "description": "One Cargo command used to warm a project's target cache.",
          "properties": {
            "args": {
              "description": "Cargo subcommand and arguments, excluding the leading `cargo` binary.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "label": {
              "description": "Human-readable label for logs and metrics.",
              "type": "string"
            }
          },
          "required": [
            "label",
            "args"
          ],
          "type": "object"
        },
        "ClangLanguage": {
          "properties": {
            "default_version": {
              "type": "string"
            }
          },
          "required": [
            "default_version"
          ],
          "type": "object"
        },
        "ConfigSource": {
          "description": "How the config landed in the column.\n\n* `AutoDetected` — written by the P5 boot reseed hook from stack detection.\n  Re-writing from detection is OK (config may still be overwritten on the\n  next detector pass until the user edits it).\n* `UserEdited` — saved via the MCP tool or UI. Never reseeded from stack.",
          "enum": [
            "auto-detected",
            "user-edited"
          ],
          "type": "string"
        },
        "DotnetLanguage": {
          "properties": {
            "default_version": {
              "type": "string"
            }
          },
          "required": [
            "default_version"
          ],
          "type": "object"
        },
        "EnvironmentConfig": {
          "additionalProperties": false,
          "properties": {
            "agent_mcp_defaults": {
              "additionalProperties": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "default": {},
              "description": "Per-agent-role MCP server defaults. Moved here from the pre-cut-over\n`.djinn/settings.json`'s `agent_mcp_defaults` field. The key is a role\nname (e.g. `\"worker\"`, `\"chat\"`) or `\"*\"` for the fallback applied to\nany role with no explicit entry. The value is the list of MCP server\nnames (from root `mcp.json`) that sessions for that role should\nconnect to by default. Specialist role assignments override these.",
              "type": "object"
            },
            "cargo_cache_policy": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CargoCachePolicy"
                },
                {
                  "type": "null"
                }
              ],
              "default": {
                "mode": "auto-detected"
              },
              "description": "Project-level override for Cargo target-cache warming/running policy.\n\nThe default is [`CargoCachePolicy::AutoDetected`]: djinn detects the\ncache strategy from the repository it is about to run, including the\nCargo workspace layout, `.cargo/config.toml` settings such as\n`rustc-wrapper`, and configured setup command shapes. That\ndetection is deliberately read-only. djinn may read `.cargo/config.toml`\nto keep warm-job and worker behavior consistent with the project, but it\nnever creates, edits, or rewrites the project's `.cargo/config.toml`.\n\nSet an explicit policy only when project authors need to override the\ndetected cargo feature set at the environment-config level. `None` is\naccepted for legacy rows and is treated the same as the\ndefault auto-detected policy by consumers."
            },
            "env": {
              "additionalProperties": {
                "type": "string"
              },
              "default": {},
              "type": "object"
            },
            "global_skills": {
              "default": [],
              "description": "Skills injected into every agent prompt regardless of role. Moved here\nfrom the pre-cut-over `.djinn/settings.json`'s `global_skills` field.\nEach entry is a skill file stem (resolved against `.djinn/skills/`).",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "languages": {
              "$ref": "#/$defs/Languages",
              "default": {
                "clang": null,
                "dotnet": null,
                "go": null,
                "java": null,
                "node": null,
                "python": null,
                "ruby": null,
                "rust": null
              }
            },
            "lifecycle": {
              "$ref": "#/$defs/LifecycleHooks",
              "default": {
                "post_build": [],
                "pre_anything": [],
                "pre_task": [],
                "pre_verification": []
              }
            },
            "schema_version": {
              "default": 0,
              "description": "`0` (the default) is the \"needs reseed\" sentinel — the P5 boot hook\ntreats any config with `schema_version < 1` as an un-seeded row and\nrewrites it from `projects.stack`. `validate()` rejects 0 so that\nuser-submitted configs must declare a real version.",
              "format": "int64",
              "type": "integer"
            },
            "source": {
              "$ref": "#/$defs/ConfigSource",
              "default": "auto-detected"
            },
            "system_packages": {
              "default": [],
              "description": "apt packages installed in the image. Alpine was dropped in the\n2026-04-22 cleanup — every image is `debian:bookworm-slim` now.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "workspaces": {
              "default": [],
              "items": {
                "$ref": "#/$defs/Workspace"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "GoLanguage": {
          "properties": {
            "default_version": {
              "type": "string"
            }
          },
          "required": [
            "default_version"
          ],
          "type": "object"
        },
        "HookCommand": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/HookCommand"
              },
              "type": "object"
            }
          ],
          "description": "A lifecycle / setup command.\n\nShape matches the `LifecycleCommand` enum in\n`server/crates/djinn-agent-worker/src/lifecycle.rs`. In P5, that module's\nlocal enum is replaced with this canonical definition so the on-disk\nconfig JSON round-trips through both sides without a translation layer.\n\nThe three forms follow the devcontainer spec that originally inspired them:\na shell string passed to `/bin/sh -c`, an argv array exec'd directly, or\na named map run in parallel."
        },
        "JavaLanguage": {
          "properties": {
            "default_version": {
              "type": "string"
            }
          },
          "required": [
            "default_version"
          ],
          "type": "object"
        },
        "Languages": {
          "additionalProperties": false,
          "properties": {
            "clang": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ClangLanguage"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "dotnet": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DotnetLanguage"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "go": {
              "anyOf": [
                {
                  "$ref": "#/$defs/GoLanguage"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "java": {
              "anyOf": [
                {
                  "$ref": "#/$defs/JavaLanguage"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "node": {
              "anyOf": [
                {
                  "$ref": "#/$defs/NodeLanguage"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "python": {
              "anyOf": [
                {
                  "$ref": "#/$defs/PythonLanguage"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "ruby": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RubyLanguage"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "rust": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RustLanguage"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "type": "object"
        },
        "LifecycleHooks": {
          "properties": {
            "post_build": {
              "default": [],
              "description": "`RUN` lines appended to the generated Dockerfile. Bundle anything\nyou want baked into the image here (apt packages are the easy path;\ncurl-installs like `protoc` go here).",
              "items": {
                "$ref": "#/$defs/HookCommand"
              },
              "type": "array"
            },
            "pre_anything": {
              "default": [],
              "description": "Runs in every Pod djinn starts (warm AND task-run), before any\ndjinn work. The pre-2026-04-22 `pre_warm` field routes here via\nthe serde alias.",
              "items": {
                "$ref": "#/$defs/HookCommand"
              },
              "type": "array"
            },
            "pre_task": {
              "default": [],
              "description": "Runs in the task-run Pod before the supervisor starts.",
              "items": {
                "$ref": "#/$defs/PreTaskCommand"
              },
              "type": "array"
            },
            "pre_verification": {
              "default": [],
              "description": "Workspace setup hook that runs once in the task-run Pod before the\nsupervisor starts. Typically `pnpm install` / `cargo build` / similar\n— commands that prepare the workspace for the agent session.",
              "items": {
                "$ref": "#/$defs/HookCommand"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "NodeLanguage": {
          "properties": {
            "default_package_manager": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "default_version": {
              "type": "string"
            }
          },
          "required": [
            "default_version"
          ],
          "type": "object"
        },
        "PreTaskCommand": {
          "description": "A named pre-task command declared in the project environment config.\n\nPre-task commands run in the task-run Pod before the supervisor starts.\nEach command carries an optional name (auto-generated as `pre_task_N`\nwhen omitted), a shell command string, a timeout, and a failure policy.",
          "properties": {
            "command": {
              "description": "Shell command passed to `/bin/sh -c`.",
              "type": "string"
            },
            "failure_policy": {
              "$ref": "#/$defs/PreTaskFailurePolicy",
              "default": "blocking",
              "description": "What to do when the command exits non-zero."
            },
            "name": {
              "description": "Optional display/identity name. When `None`, resolved to\n`pre_task_1`, `pre_task_2`, etc. at validation time.",
              "type": [
                "string",
                "null"
              ]
            },
            "timeout_seconds": {
              "default": 300,
              "description": "Maximum wall-clock seconds the command may run. Default 300 (5 min).",
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "command"
          ],
          "type": "object"
        },
        "PreTaskFailurePolicy": {
          "description": "Failure policy for a pre-task command.\n\n* `blocking` (default) — the task run fails if the command fails.\n* `best_effort` — failures are logged but do not abort the task run.",
          "enum": [
            "blocking",
            "best_effort"
          ],
          "type": "string"
        },
        "PythonLanguage": {
          "properties": {
            "default_version": {
              "type": "string"
            }
          },
          "required": [
            "default_version"
          ],
          "type": "object"
        },
        "RubyLanguage": {
          "properties": {
            "default_version": {
              "type": "string"
            }
          },
          "required": [
            "default_version"
          ],
          "type": "object"
        },
        "RustLanguage": {
          "properties": {
            "default_toolchain": {
              "type": "string"
            }
          },
          "required": [
            "default_toolchain"
          ],
          "type": "object"
        },
        "Workspace": {
          "properties": {
            "language": {
              "type": "string"
            },
            "name": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "package_manager": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "root": {
              "type": "string"
            },
            "slug": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "tags": {
              "default": [],
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "toolchain": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "version": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "root",
            "language"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "config": {
          "$ref": "#/$defs/EnvironmentConfig",
          "description": "The image's EnvironmentConfig (languages+versions, system_packages,\nbuild env, post_build hooks). Validated server-side."
        },
        "description": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Unique display name (e.g. \"Go\", \"Rust\", \"Node\").",
          "type": "string"
        }
      },
      "required": [
        "name",
        "config"
      ],
      "type": "object"
    },
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    }
  },
  {
    "name": "image_delete",
