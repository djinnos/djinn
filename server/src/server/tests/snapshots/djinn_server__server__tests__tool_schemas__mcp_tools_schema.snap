        "value"
      ],
      "type": "object"
    },
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "auto_merge": {
          "type": "boolean"
        },
        "graph_excluded_paths": {
          "default": [],
          "description": "Glob patterns the `code_graph` MCP handler drops from\ncycles/orphans/ranked result sets (migration 12). Canonical empty\nvalue is an empty array, not null, so the UI can bind a list\neditor to it without a pre-fetch fallback.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "graph_orphan_ignore": {
          "default": [],
