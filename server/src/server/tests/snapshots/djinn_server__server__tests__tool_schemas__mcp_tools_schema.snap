            "pre_anything": {
              "default": [],
              "description": "Runs in every Pod djinn starts (warm AND task-run), before any\ndjinn work. The pre-2026-04-22 `pre_warm` field routes here via\nthe serde alias.",
              "items": {
                "$ref": "#/$defs/HookCommand"
              },
              "type": "array"
            },
            "pre_task": {
              "default": [],
              "description": "Runs in the task-run Pod before the supervisor starts.",
              "items": {
                "$ref": "#/$defs/HookCommand"
              },
              "type": "array"
            },
            "pre_verification": {
              "default": [],
              "description": "Runs once in the task-run Pod, before any verification rule fires.\nTypically `pnpm install` / `cargo build` / similar — commands that\nprepare the workspace so the `verification.rules` commands succeed.\nPreviously lived as `verification.setup`.",
              "items": {
                "$ref": "#/$defs/HookCommand"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "NodeLanguage": {
          "properties": {
            "default_package_manager": {
              "default": null,
              "nullable": true,
              "type": "string"
            },
            "default_version": {
              "type": "string"
            }
          },
          "required": [
