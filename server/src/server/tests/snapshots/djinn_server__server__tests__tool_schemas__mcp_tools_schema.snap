                "type": "string"
              },
              "type": "array"
            },
            "label": {
              "description": "Human-readable label for logs and metrics.",
              "type": "string"
            }
          },
          "required": [
            "label",
            "args"
          ],
          "type": "object"
        },
        "ClangLanguage": {
          "properties": {
            "default_version": {
              "type": "string"
            }
          },
          "required": [
            "default_version"
          ],
          "type": "object"
