---
source: src/server/tests/tool_schemas.rs
expression: signatures
---
[
  {
    "name": "agent_create",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$defs": {
        "AnyJson": {}
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "base_role": {
          "description": "Base role to extend. One of: worker, lead, planner, architect, reviewer.",
          "type": "string"
        },
        "description": {
          "nullable": true,
          "type": "string"
        },
        "mcp_servers": {
          "description": "Additional MCP server refs for this agent.",
          "items": {
            "$ref": "#/$defs/AnyJson"
          },
          "nullable": true,
          "type": "array"
        },
        "model_preference": {
          "description": "Preferred model ID (falls back to project default).",
          "nullable": true,
          "type": "string"
        },
        "name": {
          "description": "Unique agent name within the project.",
          "type": "string"
        },
        "project": {
          "description": "Absolute project path.",
          "type": "string"
        },
        "skills": {
          "description": "Skills (prompt templates) available to this agent.",
          "items": {
            "$ref": "#/$defs/AnyJson"
          },
          "nullable": true,
          "type": "array"
        },
        "system_prompt_extensions": {
          "description": "Additional system prompt content appended to the base role prompt.",
          "nullable": true,
          "type": "string"
        },
        "verification_command": {
          "description": "Custom verification command (falls back to project default).",
          "nullable": true,
          "type": "string"
        }
      },
      "required": [
        "project",
        "name",
        "base_role"
      ],
      "title": "AgentCreateParams",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "AnyJson": {}
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "base_role": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "error": {
          "nullable": true,
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "is_default": {
          "type": "boolean"
        },
        "learned_prompt": {
          "description": "Machine-managed prompt learning state. Derived from active\nlearned_prompt_history amendments. Read-only in public surfaces;\nmutations flow through agent_amend_prompt (Planner) and the\nevaluator/confirmation loop.",
          "nullable": true,
          "type": "string"
        },
        "mcp_servers": {
          "items": {
            "$ref": "#/$defs/AnyJson"
          },
          "type": "array"
        },
        "model_preference": {
          "nullable": true,
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "skills": {
          "items": {
            "$ref": "#/$defs/AnyJson"
          },
          "type": "array"
        },
        "system_prompt_extensions": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "verification_command": {
          "nullable": true,
          "type": "string"
        }
      },
      "title": "AgentSingleResponse",
      "type": "object"
    }
  },
  {
