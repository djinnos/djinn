  {
    "name": "task_create",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$defs": {
        "AcceptanceCriterionItem": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/AcceptanceCriterionStatus"
            }
          ]
        },
        "AcceptanceCriterionStatus": {
          "properties": {
            "criterion": {
              "type": "string"
            },
            "met": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "criterion"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "acceptance_criteria": {
          "items": {
            "$ref": "#/$defs/AcceptanceCriterionItem"
          },
          "nullable": true,
          "type": "array"
        },
        "agent_type": {
          "description": "Specialist role name to route this task (e.g. \"rust-expert\").",
          "nullable": true,
          "type": "string"
        },
        "blocked_by": {
          "description": "Task IDs (UUID or short_id) that block this task. Blockers are set atomically at creation.",
          "items": {
            "type": "string"
          },
          "nullable": true,
          "type": "array"
        },
        "description": {
          "nullable": true,
          "type": "string"
        },
        "design": {
          "nullable": true,
          "type": "string"
        },
        "epic_id": {
          "description": "Parent epic ID - UUID or short_id (required).",
          "nullable": true,
          "type": "string"
        },
        "issue_type": {
          "description": "Task type: \"task\" (default), \"feature\", \"bug\", \"spike\", \"research\", \"planning\", or \"review\".\nSpike, research, planning, and review use a simple lifecycle: open → in_progress → closed.\nPlanning tasks are routed to the Planner; spike and review tasks are routed to the Architect.",
          "nullable": true,
          "type": "string"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "nullable": true,
          "type": "array"
        },
        "memory_refs": {
          "description": "Memory note permalinks to attach to this task at creation.",
          "items": {
            "type": "string"
          },
          "nullable": true,
          "type": "array"
        },
        "owner": {
          "nullable": true,
          "type": "string"
        },
        "priority": {
          "format": "int64",
          "nullable": true,
          "type": "integer"
        },
        "project": {
          "description": "Absolute project path.",
          "type": "string"
        },
        "status": {
          "description": "Optional initial status. Allowed value: \"open\" (default).",
          "nullable": true,
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "project",
        "title"
      ],
      "title": "TaskCreateParams",
      "type": "object"
    },
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": true,
      "title": "ErrorOrTaskResponse",
      "type": "object"
    }
  },
  {
    "name": "task_list",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "issue_type": {
          "description": "Positive (\"task\") or negative (\"!epic\") issue_type filter.",
          "nullable": true,
          "type": "string"
        },
        "label": {
          "description": "Filter by label value.",
          "nullable": true,
          "type": "string"
        },
        "limit": {
          "format": "int64",
          "nullable": true,
          "type": "integer"
        },
        "offset": {
          "format": "int64",
          "nullable": true,
          "type": "integer"
        },
        "priority": {
          "format": "int64",
          "nullable": true,
          "type": "integer"
        },
        "project": {
          "description": "Absolute project path.",
          "type": "string"
        },
        "sort": {
          "description": "Sort order: \"priority\" (default), \"created\", \"created_desc\",\n\"updated\", \"updated_desc\", \"closed\".",
          "nullable": true,
          "type": "string"
        },
        "status": {
          "nullable": true,
          "type": "string"
        },
        "text": {
