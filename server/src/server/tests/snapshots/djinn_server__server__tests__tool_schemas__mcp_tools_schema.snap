            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "has_more": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "limit": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "offset": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "total_count": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  {
    "name": "agent_metrics",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
