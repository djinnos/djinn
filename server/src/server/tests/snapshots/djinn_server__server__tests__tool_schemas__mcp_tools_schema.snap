              "type": "boolean"
            },
            "short_id": {
              "type": "string"
            },
            "status": {
              "description": "Lifecycle: draft | in_review | approved | building | done | rejected |\narchived | superseded.",
              "type": "string"
            },
            "superseded_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": "string"
            },
            "unresolved_feedback_count": {
              "default": 0,
              "description": "Count of unresolved feedback entries — drives the per-row badge in the\nproposals list.",
              "format": "int64",
              "type": "integer"
            },
