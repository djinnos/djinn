  {
    "name": "image_update",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$defs": {
        "CargoCachePolicy": {
          "description": "Per-project Cargo target-cache strategy override.\n\nThe default [`AutoDetected`](Self::AutoDetected) mode is detection-driven:\nconsumers resolve the policy by reading the project shape (Cargo workspace\nlayout, `.cargo/config.toml`, and configured setup/verification command\npatterns) instead of hardcoding one universal compile set. That resolver is\nintentionally non-mutating. It may observe a project's `.cargo/config.toml`,\nincluding `rustc-wrapper = \"sccache\"` and feature-related settings, but it\nmust never create or modify `.cargo/config.toml`.",
          "oneOf": [
            {
              "description": "Resolve the policy from the project itself at warm/worker runtime.",
              "properties": {
                "mode": {
                  "const": "auto-detected",
                  "type": "string"
                }
              },
              "required": [
                "mode"
              ],
              "type": "object"
            },
            {
              "description": "Use this explicit, project-authored override instead of detection.",
              "properties": {
                "mode": {
                  "const": "explicit",
                  "type": "string"
                },
                "policy": {
                  "$ref": "#/$defs/CargoCachePolicyOverride"
                }
              },
              "required": [
                "mode",
                "policy"
              ],
              "type": "object"
            }
          ]
        },
        "CargoCachePolicyOverride": {
          "additionalProperties": false,
          "description": "Explicit Cargo target-cache policy used when auto-detection is overridden.",
          "properties": {
            "all_features": {
              "default": false,
              "description": "Whether warm and worker cargo commands should pass `--all-features`.",
              "type": "boolean"
            },
            "features": {
              "default": [],
              "description": "Feature names to pass consistently to warm and worker cargo commands.\nEmpty means default features only. Use `all_features` for\n`--all-features`; do not include `all-features` in this list.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "incremental": {
              "default": true,
              "description": "Whether to enable Cargo incremental compilation.",
              "type": "boolean"
            },
            "sccache": {
              "default": false,
              "description": "Whether the project should use sccache for rustc invocations.",
              "type": "boolean"
            },
            "warm_commands": {
              "default": [],
              "description": "Warm-base cargo commands derived from or overridden for this project.",
              "items": {
                "$ref": "#/$defs/CargoWarmCommand"
              },
              "type": "array"
            },
            "workspace": {
              "default": false,
              "description": "Whether the Cargo root is a workspace rather than a single package.",
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "CargoWarmCommand": {
          "additionalProperties": false,
          "description": "One Cargo command used to warm a project's target cache.",
          "properties": {
            "args": {
              "description": "Cargo subcommand and arguments, excluding the leading `cargo` binary.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "label": {
              "description": "Human-readable label for logs and metrics.",
              "type": "string"
            }
          },
          "required": [
            "label",
            "args"
          ],
          "type": "object"
        },
        "ClangLanguage": {
          "properties": {
            "default_version": {
              "type": "string"
            }
          },
          "required": [
            "default_version"
          ],
          "type": "object"
        },
        "ConfigSource": {
          "description": "How the config landed in the column.\n\n* `AutoDetected` — written by the P5 boot reseed hook from stack detection.\n  Re-writing from detection is OK (config may still be overwritten on the\n  next detector pass until the user edits it).\n* `UserEdited` — saved via the MCP tool or UI. Never reseeded from stack.",
          "enum": [
            "auto-detected",
            "user-edited"
          ],
          "type": "string"
        },
        "DotnetLanguage": {
          "properties": {
            "default_version": {
              "type": "string"
            }
          },
          "required": [
            "default_version"
          ],
          "type": "object"
        },
        "EnvironmentConfig": {
          "additionalProperties": false,
          "properties": {
            "agent_mcp_defaults": {
              "additionalProperties": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "default": {},
              "description": "Per-agent-role MCP server defaults. Moved here from the pre-cut-over\n`.djinn/settings.json`'s `agent_mcp_defaults` field. The key is a role\nname (e.g. `\"worker\"`, `\"chat\"`) or `\"*\"` for the fallback applied to\nany role with no explicit entry. The value is the list of MCP server\nnames (from root `mcp.json`) that sessions for that role should\nconnect to by default. Specialist role assignments override these.",
              "type": "object"
            },
            "cargo_cache_policy": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CargoCachePolicy"
                },
                {
                  "const": null,
                  "nullable": true
                }
              ],
              "default": {
                "mode": "auto-detected"
              },
              "description": "Project-level override for Cargo target-cache warming/running policy.\n\nThe default is [`CargoCachePolicy::AutoDetected`]: djinn detects the\ncache strategy from the repository it is about to run, including the\nCargo workspace layout, `.cargo/config.toml` settings such as\n`rustc-wrapper`, and configured setup/verification command shapes. That\ndetection is deliberately read-only. djinn may read `.cargo/config.toml`\nto keep warm-job and worker behavior consistent with the project, but it\nnever creates, edits, or rewrites the project's `.cargo/config.toml`.\n\nSet an explicit policy only when project authors need to override the\ndetected feature/sccache/incremental choices at the environment-config\nlevel. `None` is accepted for legacy rows and is treated the same as the\ndefault auto-detected policy by consumers."
            },
            "env": {
              "additionalProperties": {
                "type": "string"
              },
              "default": {},
              "type": "object"
            },
            "global_skills": {
              "default": [],
              "description": "Skills injected into every agent prompt regardless of role. Moved here\nfrom the pre-cut-over `.djinn/settings.json`'s `global_skills` field.\nEach entry is a skill file stem (resolved against `.djinn/skills/`).",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "languages": {
              "$ref": "#/$defs/Languages",
              "default": {
                "clang": null,
                "dotnet": null,
                "go": null,
                "java": null,
                "node": null,
                "python": null,
                "ruby": null,
                "rust": null
              }
            },
            "lifecycle": {
              "$ref": "#/$defs/LifecycleHooks",
              "default": {
                "post_build": [],
                "pre_anything": [],
                "pre_task": [],
                "pre_verification": []
              }
            },
            "schema_version": {
              "default": 0,
              "description": "`0` (the default) is the \"needs reseed\" sentinel — the P5 boot hook\ntreats any config with `schema_version < 1` as an un-seeded row and\nrewrites it from `projects.stack`. `validate()` rejects 0 so that\nuser-submitted configs must declare a real version.",
              "format": "int64",
              "type": "integer"
            },
            "source": {
              "$ref": "#/$defs/ConfigSource",
              "default": "auto-detected"
            },
            "system_packages": {
              "default": [],
              "description": "apt packages installed in the image. Alpine was dropped in the\n2026-04-22 cleanup — every image is `debian:bookworm-slim` now.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "workspaces": {
              "default": [],
              "items": {
                "$ref": "#/$defs/Workspace"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "GoLanguage": {
          "properties": {
            "default_version": {
              "type": "string"
            }
          },
          "required": [
            "default_version"
          ],
          "type": "object"
        },
        "HookCommand": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/HookCommand"
              },
              "type": "object"
            }
          ],
          "description": "A lifecycle / verification / setup command.\n\nShape matches the `LifecycleCommand` enum in\n`server/crates/djinn-agent-worker/src/lifecycle.rs`. In P5, that module's\nlocal enum is replaced with this canonical definition so the on-disk\nconfig JSON round-trips through both sides without a translation layer.\n\nThe three forms follow the devcontainer spec that originally inspired them:\na shell string passed to `/bin/sh -c`, an argv array exec'd directly, or\na named map run in parallel."
        },
        "JavaLanguage": {
          "properties": {
            "default_version": {
              "type": "string"
            }
          },
          "required": [
            "default_version"
          ],
          "type": "object"
        },
        "Languages": {
          "additionalProperties": false,
          "properties": {
            "clang": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ClangLanguage"
                },
                {
                  "const": null,
                  "nullable": true
                }
              ],
              "default": null
            },
            "dotnet": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DotnetLanguage"
                },
                {
                  "const": null,
                  "nullable": true
                }
              ],
              "default": null
            },
            "go": {
              "anyOf": [
                {
                  "$ref": "#/$defs/GoLanguage"
                },
                {
                  "const": null,
                  "nullable": true
                }
              ],
              "default": null
            },
            "java": {
              "anyOf": [
                {
                  "$ref": "#/$defs/JavaLanguage"
                },
                {
                  "const": null,
                  "nullable": true
                }
              ],
              "default": null
            },
            "node": {
              "anyOf": [
                {
                  "$ref": "#/$defs/NodeLanguage"
                },
                {
                  "const": null,
