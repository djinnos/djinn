  {
    "name": "epic_count",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "group_by": {
          "description": "Group results by: \"status\".",
          "nullable": true,
          "type": "string"
        },
        "project": {
          "description": "Absolute project path.",
          "type": "string"
        },
        "status": {
          "nullable": true,
          "type": "string"
        }
      },
      "required": [
        "project"
      ],
      "title": "EpicCountParams",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "EpicCountGroup": {
          "properties": {
            "count": {
