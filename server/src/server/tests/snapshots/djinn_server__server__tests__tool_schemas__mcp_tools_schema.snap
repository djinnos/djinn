            "null"
          ]
        },
        "id": {
          "description": "Proposal UUID or short_id.",
          "type": "string"
        },
        "revision_bodies": {
          "description": "Controls revision body verbosity when `revisions` is selected.\nAccepted values: `excerpt` (default), `full`, `omit`.\nIgnored when `fields` omits `revisions`.",
          "type": [
            "string",
