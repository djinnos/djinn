              "description": "`login` of the account (user or org) the App is installed on.",
              "type": "string"
            },
            "account_type": {
              "description": "Either \"User\" or \"Organization\".",
              "type": "string"
            },
            "id": {
              "description": "Numeric installation ID (used for scoping API calls server-side).",
              "format": "int64",
              "type": "integer"
            },
