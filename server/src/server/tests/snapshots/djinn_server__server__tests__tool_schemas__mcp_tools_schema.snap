  {
    "name": "proposal_show",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "id": {
          "description": "Proposal UUID or short_id.",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "ProposalShowParams",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "AcceptanceCriterionItem": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/AcceptanceCriterionStatus"
            }
          ]
        },
        "AcceptanceCriterionStatus": {
          "properties": {
            "criterion": {
              "type": "string"
            },
            "met": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "criterion"
          ],
          "type": "object"
        },
        "ProposalEpicModel": {
          "description": "An epic this proposal graduated into.",
          "properties": {
            "epic_emoji": {
              "description": "Epic emoji, for display alongside the title.",
              "type": "string"
            },
            "epic_id": {
              "type": "string"
            },
            "epic_short_id": {
              "type": "string"
            },
            "epic_title": {
              "description": "Epic title, for display alongside the short id.",
              "type": "string"
            },
            "needs_reconcile": {
              "type": "boolean"
            },
            "project_path": {
              "type": "string"
            },
            "reconciled_at_revision_seq": {
              "format": "int32",
              "nullable": true,
              "type": "integer"
            },
            "status": {
              "type": "string"
            }
          },
          "required": [
            "epic_id",
            "epic_short_id",
            "epic_title",
            "epic_emoji",
            "project_path",
            "status",
            "needs_reconcile"
          ],
          "type": "object"
        },
        "ProposalFeedbackModel": {
          "properties": {
            "author_kind": {
              "description": "`user` or `ai`.",
              "type": "string"
            },
            "author_model": {
              "nullable": true,
              "type": "string"
            },
            "author_user_id": {
              "nullable": true,
              "type": "string"
            },
            "body": {
              "type": "string"
            },
            "created_at": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "parent_id": {
              "nullable": true,
              "type": "string"
            },
            "proposal_id": {
              "type": "string"
            },
            "resolved_at": {
              "description": "When set, the feedback is resolved (addressed or dismissed) and collapsed\nout of the active thread.",
              "nullable": true,
              "type": "string"
            },
            "resolved_by_user_id": {
              "nullable": true,
              "type": "string"
            },
            "resolved_revision_seq": {
              "description": "The revision that addressed this feedback (`null` when dismissed without\na spec change).",
              "format": "int32",
              "nullable": true,
              "type": "integer"
            },
            "target_section": {
              "nullable": true,
              "type": "string"
            },
            "updated_at": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "proposal_id",
            "author_kind",
            "body",
            "created_at",
            "updated_at"
          ],
          "type": "object"
        },
        "ProposalModel": {
          "properties": {
            "acceptance_criteria": {
              "description": "Structured acceptance criteria (`{criterion, met}` or plain string),\nsame shape as tasks. `met` means \"agreed during scoping\".",
              "items": {
                "$ref": "#/$defs/AcceptanceCriterionItem"
              },
              "type": "array"
            },
            "author_user_id": {
              "nullable": true,
              "type": "string"
            },
            "body": {
              "type": "string"
            },
            "body_format": {
              "description": "Body encoding: `markdown` (legacy default) or `mdx` (block-aware).",
              "type": "string"
            },
            "build_owner_user_id": {
              "description": "Build owner once graduated.",
              "nullable": true,
              "type": "string"
            },
            "closed_at": {
              "nullable": true,
              "type": "string"
            },
            "created_at": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "last_reconciled_revision_seq": {
              "description": "Last proposal revision that the in-flight build has reconciled against.",
              "format": "int32",
              "nullable": true,
              "type": "integer"
            },
            "latest_revision_seq": {
              "description": "Head revision number (sign-offs anchored earlier are stale).",
              "format": "int32",
              "type": "integer"
            },
            "pending_reconcile": {
              "description": "True when the in-flight build is behind the latest proposal revision.",
              "type": "boolean"
            },
            "short_id": {
              "type": "string"
            },
            "status": {
              "description": "Lifecycle: draft | in_review | approved | building | done | rejected |\narchived | superseded.",
              "type": "string"
            },
            "superseded_by": {
              "nullable": true,
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "unresolved_feedback_count": {
              "default": 0,
              "description": "Count of unresolved feedback entries — drives the per-row badge in the\nproposals list. Only populated on `proposal_list`; `0` on show paths.",
              "format": "int64",
              "type": "integer"
            },
            "updated_at": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "short_id",
            "title",
            "body",
            "body_format",
            "acceptance_criteria",
            "status",
            "created_at",
            "updated_at",
            "latest_revision_seq",
            "pending_reconcile"
          ],
          "type": "object"
        },
        "ProposalRevisionModel": {
          "properties": {
            "acceptance_criteria": {
              "items": {
                "$ref": "#/$defs/AcceptanceCriterionItem"
              },
              "type": "array"
            },
            "body": {
              "type": "string"
            },
            "body_format": {
              "description": "Body encoding: `markdown` (legacy default) or `mdx` (block-aware).",
              "type": "string"
            },
            "created_at": {
              "type": "string"
            },
            "edited_by_user_id": {
              "nullable": true,
              "type": "string"
            },
            "event_kind": {
              "description": "`spec_revision` for material spec snapshots, `status_change` for\nlifecycle-only history rows.",
              "type": "string"
            },
            "event_metadata": {
              "nullable": true,
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "seq": {
              "format": "int32",
              "type": "integer"
            },
            "status_from": {
              "nullable": true,
              "type": "string"
            },
            "status_to": {
              "nullable": true,
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "seq",
            "title",
            "body",
            "body_format",
            "acceptance_criteria",
            "event_kind",
            "created_at"
          ],
          "type": "object"
        },
        "ProposalSignoffModel": {
          "properties": {
            "created_at": {
              "type": "string"
            },
            "kind": {
              "description": "`scoped` (product) or `technical` (engineering).",
              "type": "string"
            },
            "revision_seq": {
              "description": "Revision this sign-off was given against.",
              "format": "int32",
              "type": "integer"
            },
            "stale": {
              "description": "True when the proposal advanced past `revision_seq` (needs re-approval).",
              "type": "boolean"
            },
            "user_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "user_id",
            "revision_seq",
            "stale",
            "created_at"
          ],
          "type": "object"
        },
        "ProposalTargetModel": {
          "properties": {
            "created_at": {
              "type": "string"
            },
            "project_id": {
              "type": "string"
            },
            "project_name": {
              "description": "Human-friendly project name, resolved by the handler.",
              "nullable": true,
              "type": "string"
            },
            "project_path": {
              "description": "`owner/repo` slug, resolved by the handler for display chips.",
              "nullable": true,
              "type": "string"
            },
            "role": {
              "description": "`primary` (a write-target) or `reference` (read-only context).",
              "type": "string"
            }
          },
          "required": [
            "project_id",
            "role",
            "created_at"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "epics": {
          "items": {
            "$ref": "#/$defs/ProposalEpicModel"
          },
          "nullable": true,
          "type": "array"
        },
        "error": {
          "nullable": true,
          "type": "string"
        },
        "feedback": {
          "items": {
            "$ref": "#/$defs/ProposalFeedbackModel"
          },
          "nullable": true,
          "type": "array"
        },
        "proposal": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProposalModel"
            },
            {
              "const": null,
              "nullable": true
            }
          ]
        },
        "revisions": {
          "items": {
            "$ref": "#/$defs/ProposalRevisionModel"
          },
          "nullable": true,
          "type": "array"
        },
        "signoffs": {
          "items": {
            "$ref": "#/$defs/ProposalSignoffModel"
          },
          "nullable": true,
          "type": "array"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/ProposalTargetModel"
          },
          "nullable": true,
          "type": "array"
        }
      },
      "title": "ProposalShowResponse",
      "type": "object"
    }
  },
