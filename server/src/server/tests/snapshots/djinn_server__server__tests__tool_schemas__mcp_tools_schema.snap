      "properties": {
        "provider_id": {
          "description": "Provider ID to start OAuth for (accepts catalog aliases, e.g. 'github-copilot').",
          "type": "string"
        },
        "target_user_id": {
          "default": null,
          "description": "Admin-only: act on behalf of this user id (e.g. another user to\nconfigure). Non-admins must omit it.",
          "nullable": true,
          "type": "string"
        }
      },
      "required": [
        "provider_id"
      ],
      "title": "ProviderOauthStartInput",
      "type": "object"
    },
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "builtin_id": {
          "nullable": true,
          "type": "string"
        },
        "configured_keys": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "error": {
          "nullable": true,
          "type": "string"
        },
        "expires_in": {
          "description": "Device-code: how long, in seconds, the user has to complete sign-in.",
          "format": "int64",
          "nullable": true,
          "type": "integer"
        },
        "goose_provider_id": {
          "nullable": true,
          "type": "string"
        },
        "interval": {
          "description": "Device-code: recommended polling interval in seconds (informational —\nthe server does the polling, not the client).",
          "format": "int64",
          "nullable": true,
          "type": "integer"
        },
        "oauth_supported": {
          "type": "boolean"
        },
        "ok": {
          "type": "boolean"
        },
        "pending": {
          "description": "True when the flow is still in progress — the server has spawned a\nbackground task that polls for tokens. The UI should wait for a\n`credential.updated` SSE event to confirm completion.",
          "type": "boolean"
        },
        "provider_id": {
          "type": "string"
        },
        "success": {
          "type": "boolean"
        },
        "user_code": {
          "description": "Device-code: the short code the user must enter at `verification_uri`.",
          "nullable": true,
          "type": "string"
        },
        "verification_uri": {
          "description": "Device-code: the bare URL the user opens to enter the code manually.",
          "nullable": true,
          "type": "string"
        },
        "verification_uri_complete": {
          "description": "Device-code: convenience URL with `user_code` pre-filled as a query\nparam; the UI can surface this as a \"click to open\" link.",
          "nullable": true,
          "type": "string"
        }
      },
      "required": [
        "ok",
        "success",
        "provider_id",
        "oauth_supported",
        "configured_keys",
        "pending"
      ],
      "title": "ProviderOauthStartResponse",
      "type": "object"
    }
  },
