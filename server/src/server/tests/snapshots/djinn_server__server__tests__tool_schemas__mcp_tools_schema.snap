      "properties": {
        "graph_excluded_paths": {
          "default": [],
          "description": "Glob patterns stripped from cycles/orphans/ranked/impact/edges\noutput. Empty array means no per-project globs; Tier 1 (universal\nSCIP-artifact filter) still applies.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "graph_orphan_ignore": {
          "default": [],
          "description": "Exact file paths the `code_graph orphans` op silently drops.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "project": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "project"
      ],
      "type": "object"
    }
  },
