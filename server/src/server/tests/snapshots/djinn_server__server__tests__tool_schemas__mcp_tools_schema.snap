              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "is_default": {
              "type": "boolean"
            },
            "learned_prompt": {
              "description": "Machine-managed prompt learning state. Derived from active\nlearned_prompt_history amendments. Read-only in public surfaces;\nmutations flow through agent_amend_prompt (Planner) and the\nevaluator/confirmation loop.",
              "nullable": true,
              "type": "string"
            },
            "mcp_servers": {
              "items": {
                "$ref": "#/$defs/AnyJson"
              },
              "type": "array"
            },
            "model_preference": {
              "nullable": true,
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "project_id": {
              "type": "string"
            },
            "skills": {
              "items": {
                "$ref": "#/$defs/AnyJson"
              },
              "type": "array"
            },
            "system_prompt_extensions": {
              "type": "string"
            },
            "updated_at": {
              "type": "string"
            },
            "verification_command": {
              "nullable": true,
              "type": "string"
            }
          },
          "required": [
            "id",
            "project_id",
            "name",
            "base_role",
            "description",
            "system_prompt_extensions",
            "mcp_servers",
            "skills",
            "is_default",
            "created_at",
            "updated_at"
          ],
          "type": "object"
        },
        "AnyJson": {}
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "agents": {
          "items": {
            "$ref": "#/$defs/AgentModel"
          },
          "nullable": true,
          "type": "array"
        },
        "error": {
          "nullable": true,
          "type": "string"
        },
        "has_more": {
          "nullable": true,
          "type": "boolean"
        },
        "limit": {
          "format": "int64",
          "nullable": true,
          "type": "integer"
        },
        "offset": {
          "format": "int64",
          "nullable": true,
          "type": "integer"
        },
        "total_count": {
          "format": "int64",
          "nullable": true,
          "type": "integer"
        }
      },
      "title": "AgentListResponse",
      "type": "object"
    }
  },
  {
    "name": "agent_metrics",
    "read_only": false,
    "destructive": true,
