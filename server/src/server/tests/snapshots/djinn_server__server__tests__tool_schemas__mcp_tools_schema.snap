  {
    "name": "proposal_add_target",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "id": {
          "description": "Proposal UUID or short_id.",
          "type": "string"
        },
        "project": {
          "description": "Target project: UUID or owner/repo slug (must be registered).",
          "type": "string"
        },
        "role": {
          "description": "`primary` (a write-target, default) or `reference` (read-only context).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "project"
      ],
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "ProposalTargetModel": {
          "properties": {
            "created_at": {
              "type": "string"
            },
            "project_id": {
              "type": "string"
            },
            "project_name": {
              "description": "Human-friendly project name, resolved by the handler.",
              "type": [
                "string",
                "null"
              ]
            },
            "project_path": {
              "description": "`owner/repo` slug, resolved by the handler for display chips.",
              "type": [
                "string",
                "null"
              ]
            },
            "role": {
              "description": "`primary` (a write-target) or `reference` (read-only context).",
              "type": "string"
            }
          },
          "required": [
            "project_id",
            "role",
            "created_at"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/ProposalTargetModel"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  {
    "name": "proposal_block_patch",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$defs": {
        "BlockPatchSelector": {
          "description": "Selector for targeting a specific range in the proposal body",
          "properties": {
            "byte_range": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ByteRangeSelector"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Byte range selector: start is inclusive, end is exclusive. If\n`expected_text` is provided and does not match the body at that byte\nrange, the patch is rejected (stale-range guard)."
            },
            "exact_text": {
              "description": "Match a contiguous substring of the body. Must occur exactly once;\nzero matches or ambiguous (multiple) matches are rejected.",
              "type": [
                "string",
                "null"
              ]
            },
            "heading_text": {
              "description": "Match a markdown heading by its text (without the `#` prefix). The\nmatched range includes the heading line itself and all content up to\n(but not including) the next heading at the same or higher level, or\nthe end of the body.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "type": "object"
        },
        "ByteRangeSelector": {
          "description": "A byte-range selector with an optional verification text.",
          "properties": {
            "end": {
              "description": "Exclusive byte offset of the target range.",
              "format": "int64",
              "type": "integer"
            },
            "expected_text": {
              "description": "When set, the body text at `[start..end)` must equal this value or the\npatch is rejected. Guards against stale ranges after concurrent edits.",
              "type": [
                "string",
                "null"
              ]
            },
            "start": {
              "description": "Inclusive byte offset of the target range.",
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "block_mdx": {
          "description": "The MDX content to insert (a single block or arbitrary MDX text).",
          "type": "string"
        },
        "expected_latest_revision_seq": {
          "description": "If set, reject the patch when the proposal's latest_revision_seq does\nnot equal this value. Guards against concurrent edits.",
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "description": "Proposal UUID or short_id.",
          "type": "string"
        },
        "native_skill_name": {
          "description": "Name of the native skill producing this patch (e.g. \"visual-spec\").\nPersisted in the revision event_metadata for provenance.",
          "type": [
            "string",
            "null"
          ]
        },
        "native_skill_version": {
          "description": "Pinned version of the native skill.",
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "description": "Optional free-form note persisted alongside the revision metadata.",
          "type": [
            "string",
            "null"
          ]
        },
        "operation": {
          "description": "Operation: `replace` replaces the selected range, `wrap` wraps it.",
          "type": "string"
        },
        "selector": {
          "$ref": "#/$defs/BlockPatchSelector",
          "description": "Target selector: identifies the range in the body to patch."
        }
      },
      "required": [
        "id",
        "selector",
        "operation",
        "block_mdx"
      ],
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "AcceptanceCriterionItem": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/AcceptanceCriterionStatus"
            }
          ]
        },
        "AcceptanceCriterionStatus": {
          "properties": {
            "criterion": {
              "type": "string"
            },
            "met": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "criterion"
          ],
          "type": "object"
        },
        "ProposalListSummary": {
          "description": "Compact tribunal/readiness state for a single proposal row on the list.\n\nEvery field is a cheap, batched approximation of the richer per-proposal\ngate/refinement status surfaced by `proposal_show` — enough to drive the\nlist-row chips (tribunal round / awaiting-review / evidence, and a gate\npass/fail dot with a \"why blocked\" tooltip) without the several-queries-per-\nrow those full builders cost.",
          "properties": {
            "awaiting_review": {
              "description": "Refinement converged and is parked awaiting human review (the human is\nthe bottleneck — the most important state to surface).",
              "type": "boolean"
            },
            "current_round": {
              "description": "Highest debate round reached (`0` when there is no debate trail yet).",
              "format": "int32",
              "type": "integer"
            },
            "dor_ready": {
              "description": "Deterministic Definition-of-Ready passes.",
              "type": "boolean"
            },
            "gate_ready": {
              "description": "Composed-gate approximation passes: `dor_ready` AND the latest judge\nverdict is not needs-work AND there are no unresolved blocking objections\nAND the proposal is not parked on evidence. (Override lifecycle handling\nis intentionally omitted here; the full check lives in `proposal_show`.)",
              "type": "boolean"
            },
            "needs_evidence": {
              "description": "Parked on an open needs-evidence spike.",
              "type": "boolean"
            },
            "refinement_active": {
              "description": "A refinement (tribunal) run is active — a round is in flight.",
              "type": "boolean"
            },
            "unresolved_blocking_count": {
              "description": "Count of unresolved blocking (non-verdict) debate objections.",
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "refinement_active",
            "awaiting_review",
            "current_round",
            "needs_evidence",
            "dor_ready",
            "gate_ready",
            "unresolved_blocking_count"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "acceptance_criteria": {
          "description": "Structured acceptance criteria (`{criterion, met}` or plain string),\nsame shape as tasks. `met` means \"agreed during scoping\".",
          "items": {
            "$ref": "#/$defs/AcceptanceCriterionItem"
          },
          "type": "array"
        },
        "author_user_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "body": {
          "type": "string"
        },
        "body_format": {
          "description": "Body encoding: `markdown` (legacy default) or `mdx` (block-aware).",
          "type": "string"
        },
        "build_owner_user_id": {
          "description": "Build owner once graduated.",
          "type": [
            "string",
            "null"
          ]
        },
        "closed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "string"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "last_reconciled_revision_seq": {
          "description": "Last proposal revision that the in-flight build has reconciled against.",
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "latest_revision_seq": {
          "description": "Head revision number (sign-offs anchored earlier are stale).",
          "format": "int32",
          "type": "integer"
        },
        "linked_spike_task_id": {
          "description": "When parked for needs-evidence: the linked spike task id.",
          "type": [
            "string",
            "null"
          ]
        },
        "list_summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProposalListSummary"
            },
            {
              "type": "null"
            }
          ],
          "description": "Compact tribunal/readiness summary — populated only on `proposal_list`\n(batched across the page) for non-terminal proposals, so list rows can\nrender tribunal/gate chips without opening each proposal. `None` on show\npaths and for terminal proposals (done/rejected/archived/superseded)."
        },
        "mdx": {
          "description": "Portable proposal.mdx representation (populated by `proposal_export`).",
          "type": [
            "string",
            "null"
          ]
        },
        "needs_evidence_claim": {
          "description": "When parked for needs-evidence: the named feasibility claim.",
          "type": [
            "string",
            "null"
          ]
        },
        "pending_reconcile": {
          "description": "True when the in-flight build is behind the latest proposal revision.",
          "type": "boolean"
        },
        "short_id": {
          "type": "string"
        },
        "status": {
          "description": "Lifecycle: draft | in_review | approved | building | done | rejected |\narchived | superseded.",
          "type": "string"
        },
        "superseded_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "unresolved_feedback_count": {
          "default": 0,
          "description": "Count of unresolved feedback entries — drives the per-row badge in the\nproposals list. Only populated on `proposal_list`; `0` on show paths.",
          "format": "int64",
          "type": "integer"
        },
        "updated_at": {
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  {
    "name": "proposal_blocks",
    "read_only": true,
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
