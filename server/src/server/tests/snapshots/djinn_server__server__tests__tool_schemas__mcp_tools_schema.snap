      "properties": {
        "branches": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "current": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "branches"
      ],
      "type": "object"
    }
  },
  {
    "name": "project_config_get",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "project": {
          "type": "string"
        }
      },
      "required": [
        "project"
      ],
      "type": "object"
    },
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "auto_merge": {
          "type": "boolean"
        },
        "graph_excluded_paths": {
          "default": [],
          "description": "Glob patterns the `code_graph` MCP handler drops from\ncycles/orphans/ranked result sets (migration 12). Canonical empty\nvalue is an empty array, not null, so the UI can bind a list\neditor to it without a pre-fetch fallback.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "graph_orphan_ignore": {
          "default": [],
          "description": "Exact file paths the `code_graph orphans` op silently drops\n(migration 12). Intended for the Dead-code panel's \"mark not\nactually dead\" affordance.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "project": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "sync_enabled": {
          "type": "boolean"
        },
        "sync_remote": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_branch": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "project",
        "target_branch",
        "auto_merge",
        "sync_enabled"
      ],
      "type": "object"
    }
  },
  {
