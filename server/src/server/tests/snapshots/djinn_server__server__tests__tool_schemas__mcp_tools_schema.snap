  {
    "name": "proposal_debate_append",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "against_revision_seq": {
          "description": "The proposal revision this entry is written against.",
          "format": "int32",
          "type": "integer"
        },
        "agent_role": {
          "description": "Agent role (e.g. \"advocate\", \"adversary\", \"judge\").",
          "type": "string"
        },
        "author_kind": {
          "default": "agent",
          "description": "`agent` (default) or `user`.",
          "type": "string"
        },
        "author_model": {
          "description": "Model id when `author_kind == \"agent\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "blocking": {
          "default": false,
          "description": "When true, this entry blocks proposal readiness.\nMeaningful for objection and verdict kinds.",
          "type": "boolean"
        },
        "body": {
          "description": "Body text of the debate entry.",
          "type": "string"
        },
        "kind": {
          "description": "`objection` | `rebuttal` | `verdict`.",
          "type": "string"
        },
        "proposal_id": {
          "description": "Proposal UUID or short_id.",
          "type": "string"
        },
        "round": {
          "description": "Debate round (1-based).",
          "format": "int32",
          "type": "integer"
        },
        "source_task_id": {
          "description": "Optional source task attribution.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "proposal_id",
        "kind",
        "body",
        "agent_role",
        "against_revision_seq",
        "round"
      ],
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "ProposalDebateTrailModel": {
          "description": "A structured debate-trail row for the proposal tribunal. Separate from\n[`ProposalFeedbackModel`] (human discussion): debate rows are typed\n(objection, rebuttal, verdict), track blocking state, and carry\nresolution/reopen lifecycle.",
          "properties": {
            "against_revision_seq": {
              "description": "The proposal revision this entry was written against.",
              "format": "int32",
              "type": "integer"
            },
            "agent_role": {
              "description": "Agent role (e.g. \"advocate\", \"adversary\", \"judge\").",
              "type": "string"
            },
            "author_kind": {
              "description": "`agent` or `user`.",
              "type": "string"
            },
            "author_model": {
              "type": [
                "string",
                "null"
              ]
            },
            "author_user_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "blocking": {
              "description": "When true, this entry blocks proposal readiness.",
              "type": "boolean"
            },
            "body": {
              "type": "string"
            },
            "created_at": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "kind": {
              "description": "`objection` | `rebuttal` | `verdict`.",
              "type": "string"
            },
            "proposal_id": {
              "type": "string"
            },
            "reopened_at": {
              "description": "When set alongside `resolved_at`, the entry was reopened.",
              "type": [
                "string",
                "null"
              ]
            },
            "reopened_by_user_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "resolved_at": {
              "description": "When set, the entry has been resolved. `None` while open.",
              "type": [
                "string",
                "null"
              ]
            },
            "resolved_by_user_id": {
              "type": [
                "string",
                "null"
              ]
            },
