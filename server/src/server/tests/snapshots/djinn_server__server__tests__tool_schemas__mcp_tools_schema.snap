                "type": "string"
              },
              "type": "array"
            },
            "status": {
              "description": "Build status of the image's own config: none | building | ready | failed.",
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "status",
            "config"
          ],
          "type": "object"
        },
