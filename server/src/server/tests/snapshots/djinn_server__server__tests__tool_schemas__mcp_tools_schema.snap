    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "target_user_id": {
          "default": null,
          "description": "Admin-only: act on behalf of this user id (e.g. another user to\nconfigure). Non-admins must omit it.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "ProviderCatalogItem": {
          "properties": {
            "base_url": {
              "type": "string"
            },
            "builtin_id": {
              "type": "string"
            },
            "connected": {
              "type": "boolean"
            },
            "connection_methods": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "docs_url": {
              "type": "string"
            },
            "env_vars": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "goose_provider_id": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "is_openai_compatible": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "npm": {
              "type": "string"
            },
            "oauth_keys": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "oauth_supported": {
              "type": "boolean"
            },
            "revoked_reason": {
              "description": "When set, the stored credential for this provider was rejected by the\nprovider (a 401 during a run) and marked revoked. The provider is\nreported disconnected (`connected = false`, no `connection_methods`) and\nthis human-readable reason is carried so the UI can show\n\"Disconnected — <reason>\" persistently (survives reload — it comes from\nthe persisted `credentials.revoked_at/reason`, not a transient event).\nReconnecting the provider clears it.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "builtin_id",
            "goose_provider_id",
            "name",
            "npm",
            "env_vars",
            "base_url",
            "docs_url",
            "is_openai_compatible",
            "connected",
            "oauth_supported",
            "oauth_keys",
            "connection_methods"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "providers": {
          "items": {
            "$ref": "#/$defs/ProviderCatalogItem"
          },
          "type": "array"
        },
        "total": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "providers",
        "total"
      ],
      "type": "object"
    }
  },
