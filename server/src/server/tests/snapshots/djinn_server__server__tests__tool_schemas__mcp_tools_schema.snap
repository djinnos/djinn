  {
    "name": "proposal_stop_build",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "id": {
          "description": "Proposal UUID or short_id (must be `building`).",
          "type": "string"
        },
        "mode": {
          "description": "`abort` (tear the build down and revert to `approved`), `freeze` (hold\nthe build's tasks out of dispatch, leaving epics/tasks/branches in\nplace), or `unfreeze` (resume a frozen build).",
          "type": "string"
        },
        "preview": {
          "description": "When true on `abort`, classify linked epic children and return their\ndisposition outcomes WITHOUT mutating anything.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "reason": {
          "description": "Why the build is being stopped. Recorded with proposal terminal\ndisposition activity. Required for `abort`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "mode"
      ],
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "ProposalDispositionSummary": {
          "description": "Auditable aggregate of the shared parent-terminal disposition matrix.\nBoth proposal abort and obsolete-epic reconciliation return this in preview\nand mutation modes so callers can distinguish disposal from safe retention.",
          "properties": {
            "disposed": {
              "format": "int64",
              "type": "integer"
            },
            "parked": {
              "format": "int64",
              "type": "integer"
            },
            "retained_already_terminal": {
              "format": "int64",
              "type": "integer"
            },
            "retained_external_dependent": {
              "format": "int64",
              "type": "integer"
            },
            "retained_other_parent": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "disposed",
            "parked",
            "retained_other_parent",
            "retained_external_dependent",
            "retained_already_terminal"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "disposition": {
          "$ref": "#/$defs/ProposalDispositionSummary",
          "default": {
            "disposed": 0,
            "parked": 0,
            "retained_already_terminal": 0,
            "retained_external_dependent": 0,
            "retained_other_parent": 0
          },
          "description": "Child-disposition outcomes for all linked epics. Retention findings do\nnot cause abort to fail."
        },
        "epics_closed": {
          "description": "Epics torn down (abort) or that would be (preview).",
          "format": "int64",
          "type": "integer"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "preview": {
          "description": "`true` when this was a dry-run that did not mutate anything.",
          "type": "boolean"
        },
        "proposal_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "sessions_killed": {
          "description": "Retained for wire compatibility. Proposal disposition never kills\nsessions directly; normal status-change handling reconciles them.",
          "format": "int64",
          "type": "integer"
        },
        "status": {
          "description": "Resulting proposal status (`approved` after a non-preview abort,\n`building` after freeze/unfreeze/preview).",
          "type": [
            "string",
            "null"
          ]
        },
        "tasks_closed": {
          "description": "Worker tasks disposed (closed) by the parent-disposition matrix.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "ok",
        "mode",
        "preview",
        "epics_closed",
        "tasks_closed",
        "sessions_killed"
      ],
      "type": "object"
    }
  },
