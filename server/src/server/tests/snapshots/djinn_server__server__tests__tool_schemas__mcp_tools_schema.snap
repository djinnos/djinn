          "default": null,
          "description": "Select which top-level sections to include in the response.\nAccepted values: `proposal`, `targets`, `feedback`, `signoffs`,\n`revisions`, `debate`, `epics`, `gate_status`.\nDefault: all fields selected. Invalid values return a validation error.",
          "items": {
            "type": "string"
          },
          "type": [
