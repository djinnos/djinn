  {
    "name": "model_health",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "action": {
          "default": "status",
          "description": "Action to perform: status (view all, default), reset (reset one model),\nreset_all (reset all models), enable (re-enable auto-disabled model).",
          "type": "string"
        },
        "model": {
          "description": "Model ID (required for reset and enable actions).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "ModelHealthOutput": {
          "properties": {
            "auto_disabled": {
              "type": "boolean"
            },
            "consecutive_failures": {
              "format": "int64",
              "type": "integer"
            },
            "cooldown_seconds_remaining": {
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "disable_ttl_trips": {
              "description": "Current escalating-cooldown tier (how many trips since the last success).\nEach tier triples the auto-disable cooldown (5s → 15s → … → 4h cap).",
              "format": "int64",
              "type": "integer"
            },
            "hard_disabled": {
              "description": "Hard-disabled by the trip-rate ceiling: held unavailable with no\nauto-expiry until a human re-enables it via `model_health(action=enable)`.\nWhen true, `cooldown_seconds_remaining` is null (there is no auto-expiry).",
              "type": "boolean"
            },
            "model_id": {
              "type": "string"
            },
            "scope": {
              "description": "Owning user the breaker bucket is scoped to; `null` = shared/system\nbucket (org-shared credential). Health is tracked per `(scope, model)`,\nso the same model can appear once per user that has used it.",
              "type": [
                "string",
                "null"
              ]
            },
            "total_failures": {
              "format": "int64",
              "type": "integer"
            },
            "total_successes": {
              "format": "int64",
              "type": "integer"
            },
            "trips_in_window": {
              "description": "Number of breaker trips inside the rolling trip-rate window (6h). When it\nreaches the ceiling (8) the bucket hard-disables.",
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "model_id",
            "auto_disabled",
            "consecutive_failures",
            "total_failures",
            "total_successes",
            "disable_ttl_trips",
            "hard_disabled",
            "trips_in_window"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "action": {
          "type": "string"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "models": {
          "items": {
            "$ref": "#/$defs/ModelHealthOutput"
          },
          "type": "array"
        }
      },
      "required": [
        "action",
        "models"
      ],
      "type": "object"
    }
  },
  {
    "name": "org_policy_get",
    "read_only": true,
    "destructive": false,
    "idempotent": true,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "OrgDefaultLanesPayload": {
          "description": "Org-default per-role lanes over the wire (mirrors the per-user lane shape).",
          "properties": {
            "implement": {
              "default": [],
              "description": "worker",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "plan": {
              "default": [],
              "description": "planner, architect, chat",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "review": {
              "default": [],
              "description": "reviewer",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "SubscriptionPolicyItem": {
          "description": "One subscription provider as the admin policy surface sees it: its id,\ndisplay name, data-residency jurisdiction, and whether it is currently\nblocked. Lets the UI render the allow/block table grouped by jurisdiction\nwithout re-deriving the residency map client-side.",
          "properties": {
            "blocked": {
              "description": "Whether this subscription is currently blocked org-wide.",
              "type": "boolean"
            },
            "id": {
              "type": "string"
            },
            "jurisdiction": {
              "description": "Data residency: `us`, `eu`, `cn`, or `other` (djinn-owned classification).",
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "jurisdiction",
            "blocked"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "additional_recommended_model_ids": {
          "description": "Fully-qualified `provider/model-id` entries to add to the recommended set.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "blocked_subscriptions": {
          "description": "The blocked subscription provider ids (subset of `subscriptions`).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "default_lanes": {
          "$ref": "#/$defs/OrgDefaultLanesPayload",
          "description": "Org-default per-role lanes new members inherit when they have none."
        },
        "demoted_recommended_model_ids": {
          "description": "Fully-qualified `provider/model-id` entries to demote from the recommended set.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "lock_level": {
          "description": "`flexible` (members may override) | `locked` (org assignment authoritative).",
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "subscriptions": {
          "description": "Every known subscription provider with its jurisdiction + blocked flag.",
          "items": {
            "$ref": "#/$defs/SubscriptionPolicyItem"
          },
          "type": "array"
        }
      },
      "required": [
        "ok",
        "subscriptions",
        "blocked_subscriptions",
        "default_lanes",
        "lock_level",
        "additional_recommended_model_ids",
        "demoted_recommended_model_ids"
      ],
      "type": "object"
    }
  },
  {
    "name": "org_policy_set",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$defs": {
        "OrgDefaultLanesPayload": {
          "description": "Org-default per-role lanes over the wire (mirrors the per-user lane shape).",
          "properties": {
            "implement": {
              "default": [],
              "description": "worker",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "plan": {
              "default": [],
              "description": "planner, architect, chat",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "review": {
              "default": [],
              "description": "reviewer",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "additional_recommended_model_ids": {
          "default": null,
          "description": "Fully-qualified `provider/model-id` entries to add to the recommended\nset on top of the baseline. Omit to keep the current value; pass an\nempty list to clear.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "blocked_subscriptions": {
          "default": null,
          "description": "Replacement set of blocked subscription provider ids. Only subscription\nproviders are honored; any non-subscription id is ignored. Omit to keep\nthe current value.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "default_lanes": {
          "anyOf": [
            {
              "$ref": "#/$defs/OrgDefaultLanesPayload"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Org-default per-role lanes new members inherit. Pass all-empty to clear.\nOmit to keep the current value."
        },
        "demoted_recommended_model_ids": {
          "default": null,
          "description": "Fully-qualified `provider/model-id` entries to demote from the\nrecommended set. Omit to keep the current value; pass an empty list to\nclear.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "lock_level": {
          "default": null,
          "description": "Lane lock level: `flexible` or `locked`. Omit to keep the current value.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "OrgDefaultLanesPayload": {
          "description": "Org-default per-role lanes over the wire (mirrors the per-user lane shape).",
          "properties": {
            "implement": {
              "default": [],
              "description": "worker",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "plan": {
              "default": [],
              "description": "planner, architect, chat",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "review": {
              "default": [],
              "description": "reviewer",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "additional_recommended_model_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "applied": {
          "type": "boolean"
        },
        "blocked_subscriptions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "default_lanes": {
          "$ref": "#/$defs/OrgDefaultLanesPayload"
        },
        "demoted_recommended_model_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "lock_level": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "ok",
        "applied",
        "blocked_subscriptions",
        "default_lanes",
        "lock_level",
        "additional_recommended_model_ids",
        "demoted_recommended_model_ids"
      ],
      "type": "object"
    }
  },
  {
    "name": "pr_review_context",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$defs": {
        "BoundaryRule": {
          "description": "A single boundary-check rule — a pair of globs. Every rule is\ntreated as a forbidden edge; callers submit only the rules they want\nflagged as violations.",
          "properties": {
            "description": {
              "description": "Optional human-readable explanation of why this rule exists,\nsurfaced in CI output so violations are self-documenting.",
              "type": [
                "string",
                "null"
              ]
            },
            "from_glob": {
              "type": "string"
            },
            "to_glob": {
              "type": "string"
            }
          },
          "required": [
            "from_glob",
            "to_glob"
          ],
          "type": "object"
        },
        "ChangedRange": {
          "description": "A single `(file, start_line, end_line)` hunk from a parsed diff. The\ncaller supplies one of these per `git diff --unified=0` hunk when\ninvoking the `diff_touches` op on the `code_graph` tool.",
          "properties": {
            "end_line": {
              "description": "Inclusive 1-indexed last line of the hunk. Defaults to `start_line`\nwhen the caller passed a single-line hunk.",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "file": {
              "description": "Repository-relative path of the file the hunk lives in.",
              "type": "string"
            },
            "start_line": {
              "description": "Inclusive 1-indexed first line of the hunk.",
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "file",
            "start_line"
          ],
          "type": "object"
        },
        "PrReviewCaps": {
          "description": "Per-list caps overriding the built-in defaults. Any field left\n`None` uses the default from `default_caps`.",
          "properties": {
            "blast_radius": {
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "hot_path_overlap": {
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "hotspot_overlap": {
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "touched_boundary_violations": {
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "touched_cycles": {
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "touched_deprecated": {
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "touched_symbols": {
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "boundary_rules": {
          "default": [],
          "description": "Architecture boundary rules. When empty, boundary analysis is\nskipped and [`PrReviewContextResponse::touched_boundary_violations`]\nis empty.",
          "items": {
            "$ref": "#/$defs/BoundaryRule"
          },
          "type": "array"
        },
        "caps": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrReviewCaps"
            },
            {
              "type": "null"
            }
          ],
          "description": "Per-list result caps. Missing fields fall back to the defaults\nencoded in `ResolvedCaps::default_caps`."
        },
        "changed_ranges": {
          "description": "Hunks parsed from `git diff --unified=0 base..head`. Must be\nnon-empty for the tool to return useful signal.",
          "items": {
            "$ref": "#/$defs/ChangedRange"
          },
          "type": "array"
        },
        "hotspots_window_days": {
          "default": null,
          "description": "Churn look-back window for the hotspot overlap. Defaults to 90.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "project": {
          "description": "Project identifier — either the UUID (`project_id`) or the\ncanonical `\"owner/repo\"` slug. The handler resolves it to the\nserver-managed clone path via `djinn_core::paths::project_dir`\nbefore dispatching to the graph backend.",
          "type": "string"
        },
        "seed_entries": {
          "default": [],
          "description": "Entry-point SCIP keys (route handlers, `main`, etc.) used when\ncomputing [`PrReviewContextResponse::hot_path_overlap`].",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "seed_sinks": {
          "default": [],
          "description": "Sink SCIP keys (DB queries, external APIs, etc.) used when\ncomputing [`PrReviewContextResponse::hot_path_overlap`].",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "project",
        "changed_ranges"
      ],
      "type": "object"
    },
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": true,
      "type": "object"
    }
  },
  {
    "name": "project_add_from_github",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "installation_id": {
          "default": null,
          "description": "GitHub App installation id that has access to this repo. When\nomitted, the server scans the user's installations and picks one\nthat contains `owner/repo`.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "default": null,
          "description": "Optional project display name. Defaults to `{owner}/{repo}`.",
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "description": "GitHub owner (user or organization).",
          "type": "string"
        },
        "ref": {
          "default": null,
          "description": "Optional branch to check out after cloning. Defaults to the repo's\ndefault branch as reported by the GitHub API.",
          "type": [
            "string",
            "null"
          ]
        },
        "repo": {
          "description": "GitHub repository name.",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "repo"
      ],
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "ProjectInfo": {
          "properties": {
            "github_owner": {
              "type": "string"
            },
            "github_repo": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "github_owner",
            "github_repo"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "project": {
          "$ref": "#/$defs/ProjectInfo"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "project"
      ],
      "type": "object"
    }
  },
  {
    "name": "project_branches",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "project_id": {
          "description": "Project UUID to resolve the server-owned clone path for.",
          "type": "string"
        }
      },
      "required": [
        "project_id"
      ],
      "type": "object"
    },
    "output_schema": {
