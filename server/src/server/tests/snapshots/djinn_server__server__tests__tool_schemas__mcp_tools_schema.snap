          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "project": {
          "description": "Project UUID or `owner/repo` slug.",
          "type": "string"
        },
        "rules": {
          "description": "Candidate verification rules to test (not saved). Their commands run in\nthe project's image against the default branch.",
