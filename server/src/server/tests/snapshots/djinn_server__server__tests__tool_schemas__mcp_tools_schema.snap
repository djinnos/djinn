              "type": "string"
            },
            "created_at": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "kind": {
              "description": "`objection` | `rebuttal` | `verdict`.",
              "type": "string"
            },
            "proposal_id": {
              "type": "string"
            },
            "reopened_at": {
              "description": "When set alongside `resolved_at`, the entry was reopened.",
              "type": [
                "string",
                "null"
              ]
            },
            "reopened_by_user_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "resolved_at": {
              "description": "When set, the entry has been resolved. `None` while open.",
              "type": [
                "string",
                "null"
              ]
            },
            "resolved_by_user_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "round": {
              "description": "Debate round (1-based).",
              "format": "int32",
              "type": "integer"
            },
            "source_task_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "updated_at": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "proposal_id",
            "kind",
            "body",
            "blocking",
            "agent_role",
            "author_kind",
            "against_revision_seq",
            "round",
            "created_at",
            "updated_at"
          ],
          "type": "object"
        },
        "ProposalEpicModel": {
          "description": "An epic this proposal graduated into.",
          "properties": {
            "epic_emoji": {
              "description": "Epic emoji, for display alongside the title.",
              "type": "string"
            },
            "epic_id": {
              "type": "string"
            },
            "epic_short_id": {
              "type": "string"
            },
            "epic_title": {
              "description": "Epic title, for display alongside the short id.",
              "type": "string"
            },
            "needs_reconcile": {
              "type": "boolean"
            },
            "project_path": {
              "type": "string"
            },
            "reconciled_at_revision_seq": {
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "status": {
              "type": "string"
            }
          },
          "required": [
            "epic_id",
            "epic_short_id",
            "epic_title",
            "epic_emoji",
            "project_path",
            "status",
            "needs_reconcile"
          ],
          "type": "object"
        },
        "ProposalFeedbackModel": {
          "properties": {
            "author_kind": {
              "description": "`user` or `ai`.",
              "type": "string"
            },
            "author_model": {
              "type": [
                "string",
                "null"
              ]
            },
            "author_user_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "body": {
              "type": "string"
            },
            "created_at": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "parent_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "proposal_id": {
              "type": "string"
            },
            "resolved_at": {
              "description": "When set, the feedback is resolved (addressed or dismissed) and collapsed\nout of the active thread.",
              "type": [
                "string",
                "null"
              ]
            },
            "resolved_by_user_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "resolved_revision_seq": {
              "description": "The revision that addressed this feedback (`null` when dismissed without\na spec change).",
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "updated_at": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "proposal_id",
            "author_kind",
            "body",
            "created_at",
            "updated_at"
          ],
          "type": "object"
        },
        "ProposalGateStatusModel": {
          "description": "Composed gate status for a proposal: deterministic DoR + tribunal\nconditions. Returned by `proposal_show` so the UI can render readiness\nwithout recomputing it client-side.",
          "properties": {
            "adversary_dry_count": {
              "description": "Consecutive adversary dry rounds at the end of the trail.",
              "format": "int32",
              "type": "integer"
            },
            "blocked_explanations": {
              "description": "Human-readable explanations of all gate failures, each naming the\nexact blocking condition. Empty when `ready` is true.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "dor_failures": {
              "description": "Specific DoR failures (empty when `dor_ready` is true).",
              "items": {
                "$ref": "#/$defs/GateFailureModel"
              },
              "type": "array"
            },
            "dor_ready": {
              "description": "Whether the deterministic DoR checks pass.",
              "type": "boolean"
            },
            "human_override_active": {
              "description": "Whether a current human override exists for this revision.",
              "type": "boolean"
            },
            "judge_needs_work": {
              "description": "Whether the latest judge verdict contains \"needs-work\".",
              "type": "boolean"
            },
            "judge_verdict_body": {
              "description": "Latest judge verdict body text, when a judge has issued a verdict.",
              "type": [
                "string",
                "null"
              ]
            },
            "judge_verdict_id": {
              "description": "Latest judge verdict entry id, when a judge has issued a verdict.",
              "type": [
                "string",
                "null"
              ]
            },
            "needs_evidence": {
              "anyOf": [
                {
                  "$ref": "#/$defs/NeedsEvidenceStatus"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Needs-evidence spike parking state. `None` when not parked."
            },
            "ready": {
              "description": "Whether the composed gate passes (DoR ready + tribunal conditions met).",
              "type": "boolean"
            },
            "unresolved_blocking_count": {
              "description": "Count of unresolved blocking debate-trail entries.",
              "format": "int32",
              "type": "integer"
            },
            "unresolved_blocking_ids": {
              "description": "IDs of unresolved blocking debate-trail entries.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "ready",
            "dor_ready",
            "dor_failures",
            "judge_needs_work",
            "adversary_dry_count",
            "unresolved_blocking_count",
            "unresolved_blocking_ids",
            "human_override_active",
            "blocked_explanations"
          ],
          "type": "object"
        },
        "ProposalListSummary": {
          "description": "Compact tribunal/readiness state for a single proposal row on the list.\n\nEvery field is a cheap, batched approximation of the richer per-proposal\ngate/refinement status surfaced by `proposal_show` — enough to drive the\nlist-row chips (tribunal round / awaiting-review / evidence, and a gate\npass/fail dot with a \"why blocked\" tooltip) without the several-queries-per-\nrow those full builders cost.",
          "properties": {
            "awaiting_review": {
              "description": "Refinement converged and is parked awaiting human review (the human is\nthe bottleneck — the most important state to surface).",
              "type": "boolean"
            },
            "current_round": {
              "description": "Highest debate round reached (`0` when there is no debate trail yet).",
              "format": "int32",
              "type": "integer"
            },
            "dor_ready": {
              "description": "Deterministic Definition-of-Ready passes.",
              "type": "boolean"
            },
            "gate_ready": {
              "description": "Composed-gate approximation passes: `dor_ready` AND the latest judge\nverdict is not needs-work AND there are no unresolved blocking objections\nAND the proposal is not parked on evidence. (Override lifecycle handling\nis intentionally omitted here; the full check lives in `proposal_show`.)",
              "type": "boolean"
            },
            "needs_evidence": {
              "description": "Parked on an open needs-evidence spike.",
              "type": "boolean"
            },
            "refinement_active": {
              "description": "A refinement (tribunal) run is active — a round is in flight.",
              "type": "boolean"
            },
            "unresolved_blocking_count": {
              "description": "Count of unresolved blocking (non-verdict) debate objections.",
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "refinement_active",
            "awaiting_review",
            "current_round",
            "needs_evidence",
            "dor_ready",
            "gate_ready",
            "unresolved_blocking_count"
          ],
          "type": "object"
        },
        "ProposalMemoryRefModel": {
          "description": "A memory note linked to a proposal via its graduated epics/tasks.",
          "properties": {
            "note_type": {
              "type": "string"
            },
            "permalink": {
              "type": "string"
            },
            "source_entity_type": {
              "description": "The entity the note is attached to: `\"epic\"` or `\"task\"`.",
              "type": "string"
            },
            "source_short_id": {
              "description": "Short ID of the epic or task that links the note.",
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "permalink",
            "title",
            "note_type",
            "source_entity_type",
            "source_short_id"
          ],
          "type": "object"
        },
        "ProposalModel": {
          "properties": {
            "acceptance_criteria": {
              "description": "Structured acceptance criteria (`{criterion, met}` or plain string),\nsame shape as tasks. `met` means \"agreed during scoping\".",
              "items": {
                "$ref": "#/$defs/AcceptanceCriterionItem"
              },
              "type": "array"
            },
            "author_user_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "body": {
              "type": "string"
            },
            "body_format": {
              "description": "Body encoding: `markdown` (legacy default) or `mdx` (block-aware).",
              "type": "string"
            },
            "build_owner_user_id": {
              "description": "Build owner once graduated.",
              "type": [
                "string",
                "null"
              ]
            },
            "closed_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "created_at": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "last_reconciled_revision_seq": {
              "description": "Last proposal revision that the in-flight build has reconciled against.",
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "latest_revision_seq": {
              "description": "Head revision number (sign-offs anchored earlier are stale).",
              "format": "int32",
              "type": "integer"
            },
            "linked_spike_task_id": {
              "description": "When parked for needs-evidence: the linked spike task id.",
              "type": [
                "string",
                "null"
              ]
            },
            "list_summary": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ProposalListSummary"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Compact tribunal/readiness summary — populated only on `proposal_list`\n(batched across the page) for non-terminal proposals, so list rows can\nrender tribunal/gate chips without opening each proposal. `None` on show\npaths and for terminal proposals (done/rejected/archived/superseded)."
            },
            "needs_evidence_claim": {
              "description": "When parked for needs-evidence: the named feasibility claim.",
              "type": [
                "string",
                "null"
              ]
            },
            "pending_reconcile": {
              "description": "True when the in-flight build is behind the latest proposal revision.",
              "type": "boolean"
            },
            "short_id": {
              "type": "string"
            },
            "status": {
              "description": "Lifecycle: draft | in_review | approved | building | done | rejected |\narchived | superseded.",
              "type": "string"
            },
            "superseded_by": {
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": "string"
            },
            "unresolved_feedback_count": {
              "default": 0,
              "description": "Count of unresolved feedback entries — drives the per-row badge in the\nproposals list. Only populated on `proposal_list`; `0` on show paths.",
              "format": "int64",
              "type": "integer"
            },
            "updated_at": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "short_id",
            "title",
            "body",
            "body_format",
            "acceptance_criteria",
            "status",
            "created_at",
            "updated_at",
            "latest_revision_seq",
            "pending_reconcile"
          ],
          "type": "object"
        },
        "ProposalRefinementStatusModel": {
          "description": "Refinement session state tracked on the proposal's event_metadata.\nThe coordinator refinement workflow populates these fields; the\ncontrol-plane surfaces them read-only to the UI.",
          "properties": {
            "active": {
              "description": "Whether refinement has been started for this proposal.",
              "type": "boolean"
            },
            "awaiting_review": {
              "default": false,
              "description": "True when the autonomous tribunal has converged (or escalated) and is\nparked for the human's single accept/reject review of the refined spec.",
              "type": "boolean"
            },
            "current_round": {
              "description": "Current debate round (1-based). `None` when refinement has not started.",
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "dry_rounds": {
              "description": "How many consecutive adversary dry rounds have been observed.",
              "format": "int32",
              "type": "integer"
            },
            "evidence_lifecycle_state": {
              "$ref": "#/$defs/EvidenceLifecycleState",
              "description": "Top-level evidence lifecycle state derived from durable proposal\nfields, lifecycle events, and linked-spike task status. Lets\ndownstream consumers distinguish Active, AwaitingEvidence,\nEvidenceFailed, PausedOrFrozen, and Terminal without inspecting\nindividual sub-fields."
            },
            "judge_summary": {
              "description": "The judge's summary shown alongside the accept/reject review.\n`None` unless `awaiting_review` is true.",
              "type": [
                "string",
                "null"
              ]
            },
            "needs_evidence": {
              "anyOf": [
                {
                  "$ref": "#/$defs/NeedsEvidenceStatus"
                },
                {
                  "type": "null"
                }
              ],
              "description": "When the proposal is parked for a needs-evidence spike, this contains\nthe claim and spike task reference. `None` when not parked."
            },
            "snapshot_revision_seq": {
              "description": "The pre-refinement snapshot revision seq (the diff baseline) when\n`awaiting_review` is true.",
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "stop_reason": {
              "description": "When set, refinement has stopped for this reason.\nValues: `adversary_dry`, `round_cap`, `spawn_cap`, `repeated_objection`,\n`agent_failure`, or `null` (still running / not started).",
              "type": [
                "string",
                "null"
              ]
            },
            "total_entries": {
              "description": "Total debate-trail entries produced so far.",
              "format": "int32",
              "type": "integer"
            }
          },
          "required": [
            "active",
            "dry_rounds",
            "total_entries",
            "evidence_lifecycle_state"
          ],
          "type": "object"
        },
        "ProposalRevisionModel": {
          "properties": {
            "acceptance_criteria": {
              "items": {
                "$ref": "#/$defs/AcceptanceCriterionItem"
              },
              "type": "array"
            },
            "body": {
              "description": "Full revision body — present only when `revision_bodies = \"full\"`.",
              "type": [
                "string",
                "null"
              ]
            },
            "body_excerpt": {
              "description": "First 512 Unicode scalar values of the revision body.\nPresent when `revision_bodies` is `excerpt` or `full`.",
              "type": [
                "string",
                "null"
              ]
            },
            "body_format": {
              "description": "Body encoding: `markdown` (legacy default) or `mdx` (block-aware).",
              "type": "string"
            },
            "body_truncated": {
              "description": "`true` when the original revision body exceeded the 512-scalar cap.\nPresent when `revision_bodies` is `excerpt` or `full`.",
              "type": [
                "boolean",
                "null"
              ]
            },
            "created_at": {
              "type": "string"
            },
            "edited_by_user_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "event_kind": {
              "description": "`spec_revision` for material spec snapshots, `status_change` for\nlifecycle-only history rows.",
              "type": "string"
            },
            "event_metadata": {
              "type": [
                "string",
                "null"
              ]
            },
            "id": {
              "type": "string"
            },
            "seq": {
              "format": "int32",
              "type": "integer"
            },
            "status_from": {
              "type": [
                "string",
                "null"
              ]
            },
            "status_to": {
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "seq",
            "title",
            "body_format",
            "acceptance_criteria",
            "event_kind",
            "created_at"
          ],
          "type": "object"
        },
        "ProposalSignoffModel": {
          "properties": {
            "created_at": {
              "type": "string"
            },
            "kind": {
              "description": "`scoped` (product) or `technical` (engineering).",
              "type": "string"
            },
            "revision_seq": {
              "description": "Revision this sign-off was given against.",
              "format": "int32",
              "type": "integer"
            },
            "stale": {
              "description": "True when the proposal advanced past `revision_seq` (needs re-approval).",
              "type": "boolean"
            },
            "user_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "user_id",
            "revision_seq",
            "stale",
            "created_at"
          ],
          "type": "object"
        },
        "ProposalTargetModel": {
          "properties": {
            "created_at": {
              "type": "string"
            },
            "project_id": {
              "type": "string"
            },
            "project_name": {
              "description": "Human-friendly project name, resolved by the handler.",
              "type": [
                "string",
                "null"
              ]
            },
            "project_path": {
              "description": "`owner/repo` slug, resolved by the handler for display chips.",
              "type": [
                "string",
                "null"
              ]
            },
            "role": {
              "description": "`primary` (a write-target) or `reference` (read-only context).",
              "type": "string"
            }
          },
          "required": [
            "project_id",
            "role",
            "created_at"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "debate_trail": {
          "description": "Structured debate-trail rows (objections, rebuttals, verdicts).\nKept separate from `feedback` (plain human discussion).",
          "items": {
            "$ref": "#/$defs/ProposalDebateTrailModel"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "epics": {
          "items": {
            "$ref": "#/$defs/ProposalEpicModel"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "feedback": {
          "items": {
            "$ref": "#/$defs/ProposalFeedbackModel"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "gate_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProposalGateStatusModel"
            },
            {
              "type": "null"
            }
          ],
          "description": "Composed gate status: deterministic DoR + tribunal conditions.\nAlways present on a successful `proposal_show` response."
        },
        "memory_refs": {
          "description": "Memory notes linked to this proposal's graduated epics/tasks.",
          "items": {
            "$ref": "#/$defs/ProposalMemoryRefModel"
          },
          "type": "array"
        },
        "proposal": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProposalModel"
            },
            {
              "type": "null"
            }
          ]
        },
        "refinement": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProposalRefinementStatusModel"
            },
            {
              "type": "null"
            }
          ],
          "description": "Refinement session status (active round, stop reason, update authority).\n`None` when refinement has not been started for this proposal."
        },
        "revisions": {
          "items": {
            "$ref": "#/$defs/ProposalRevisionModel"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "signoffs": {
          "items": {
            "$ref": "#/$defs/ProposalSignoffModel"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/ProposalTargetModel"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  {
    "name": "proposal_signoff",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "id": {
          "description": "Proposal UUID or short_id.",
          "type": "string"
        },
        "kind": {
          "description": "`scoped` (product) or `technical` (engineering).",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "AcceptanceCriterionItem": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/AcceptanceCriterionStatus"
            }
          ]
        },
        "AcceptanceCriterionStatus": {
          "properties": {
            "criterion": {
              "type": "string"
            },
            "met": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "criterion"
          ],
          "type": "object"
        },
        "ProposalListSummary": {
          "description": "Compact tribunal/readiness state for a single proposal row on the list.\n\nEvery field is a cheap, batched approximation of the richer per-proposal\ngate/refinement status surfaced by `proposal_show` — enough to drive the\nlist-row chips (tribunal round / awaiting-review / evidence, and a gate\npass/fail dot with a \"why blocked\" tooltip) without the several-queries-per-\nrow those full builders cost.",
          "properties": {
            "awaiting_review": {
              "description": "Refinement converged and is parked awaiting human review (the human is\nthe bottleneck — the most important state to surface).",
              "type": "boolean"
            },
            "current_round": {
              "description": "Highest debate round reached (`0` when there is no debate trail yet).",
              "format": "int32",
              "type": "integer"
            },
            "dor_ready": {
              "description": "Deterministic Definition-of-Ready passes.",
              "type": "boolean"
            },
            "gate_ready": {
              "description": "Composed-gate approximation passes: `dor_ready` AND the latest judge\nverdict is not needs-work AND there are no unresolved blocking objections\nAND the proposal is not parked on evidence. (Override lifecycle handling\nis intentionally omitted here; the full check lives in `proposal_show`.)",
              "type": "boolean"
            },
            "needs_evidence": {
              "description": "Parked on an open needs-evidence spike.",
              "type": "boolean"
            },
            "refinement_active": {
              "description": "A refinement (tribunal) run is active — a round is in flight.",
              "type": "boolean"
            },
            "unresolved_blocking_count": {
              "description": "Count of unresolved blocking (non-verdict) debate objections.",
              "format": "int64",
