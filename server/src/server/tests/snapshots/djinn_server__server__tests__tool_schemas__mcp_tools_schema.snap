          "description": "Image id.",
          "type": "string"
        },
        "preset_ids": {
          "description": "Service-preset ids to inject as native sidecars into every Pod that runs\nthis image (full replacement). Empty clears all injected services.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "preset_ids"
      ],
      "title": "ImageSetServicesParams",
