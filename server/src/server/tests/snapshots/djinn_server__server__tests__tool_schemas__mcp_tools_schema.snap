  {
    "name": "proposal_update",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$defs": {
        "AcceptanceCriterionItem": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/AcceptanceCriterionStatus"
            }
          ]
        },
        "AcceptanceCriterionStatus": {
          "properties": {
            "criterion": {
              "type": "string"
            },
            "met": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "criterion"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "acceptance_criteria": {
          "description": "Acceptance criteria: plain strings or `{criterion, met}` objects.",
          "items": {
            "$ref": "#/$defs/AcceptanceCriterionItem"
          },
          "nullable": true,
          "type": "array"
        },
        "body": {
          "nullable": true,
          "type": "string"
        },
        "body_format": {
          "description": "Body encoding: `markdown` (default) or `mdx` (block-aware).",
          "nullable": true,
          "type": "string"
        },
        "id": {
          "description": "Proposal UUID or short_id.",
          "type": "string"
        },
        "status": {
          "description": "draft | in_review | approved | building | done | rejected | archived | superseded.",
          "nullable": true,
          "type": "string"
        },
        "superseded_by": {
          "description": "UUID or short_id of the proposal that supersedes this one.",
          "nullable": true,
          "type": "string"
        },
        "title": {
          "nullable": true,
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "ProposalUpdateParams",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "AcceptanceCriterionItem": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/AcceptanceCriterionStatus"
            }
          ]
        },
        "AcceptanceCriterionStatus": {
          "properties": {
            "criterion": {
              "type": "string"
            },
            "met": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "criterion"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "acceptance_criteria": {
          "description": "Structured acceptance criteria (`{criterion, met}` or plain string),\nsame shape as tasks. `met` means \"agreed during scoping\".",
          "items": {
            "$ref": "#/$defs/AcceptanceCriterionItem"
          },
          "type": "array"
        },
        "author_user_id": {
          "nullable": true,
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "body_format": {
          "description": "Body encoding: `markdown` (legacy default) or `mdx` (block-aware).",
          "type": "string"
        },
        "build_owner_user_id": {
          "description": "Build owner once graduated.",
          "nullable": true,
          "type": "string"
        },
        "closed_at": {
          "nullable": true,
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "error": {
          "nullable": true,
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "last_reconciled_revision_seq": {
          "description": "Last proposal revision that the in-flight build has reconciled against.",
          "format": "int32",
          "nullable": true,
          "type": "integer"
        },
        "latest_revision_seq": {
          "description": "Head revision number (sign-offs anchored earlier are stale).",
          "format": "int32",
          "type": "integer"
        },
        "pending_reconcile": {
          "description": "True when the in-flight build is behind the latest proposal revision.",
          "type": "boolean"
        },
        "short_id": {
          "type": "string"
        },
        "status": {
          "description": "Lifecycle: draft | in_review | approved | building | done | rejected |\narchived | superseded.",
          "type": "string"
        },
        "superseded_by": {
          "nullable": true,
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "unresolved_feedback_count": {
          "default": 0,
          "description": "Count of unresolved feedback entries — drives the per-row badge in the\nproposals list. Only populated on `proposal_list`; `0` on show paths.",
          "format": "int64",
          "type": "integer"
        },
        "updated_at": {
          "type": "string"
        }
      },
      "title": "ProposalSingleResponse",
      "type": "object"
    }
  },
  {
    "name": "provider_catalog",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "target_user_id": {
          "default": null,
          "description": "Admin-only: act on behalf of this user id (e.g. another user to\nconfigure). Non-admins must omit it.",
          "nullable": true,
          "type": "string"
        }
      },
      "title": "ProviderCatalogInput",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "ProviderCatalogItem": {
          "properties": {
            "base_url": {
              "type": "string"
            },
            "builtin_id": {
              "type": "string"
            },
            "connected": {
              "type": "boolean"
            },
            "connection_methods": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "docs_url": {
              "type": "string"
            },
            "env_vars": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "goose_provider_id": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "is_openai_compatible": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "npm": {
              "type": "string"
            },
            "oauth_keys": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "oauth_supported": {
              "type": "boolean"
            },
            "revoked_reason": {
              "description": "When set, the stored credential for this provider was rejected by the\nprovider (a 401 during a run) and marked revoked. The provider is\nreported disconnected (`connected = false`, no `connection_methods`) and\nthis human-readable reason is carried so the UI can show\n\"Disconnected — <reason>\" persistently (survives reload — it comes from\nthe persisted `credentials.revoked_at/reason`, not a transient event).\nReconnecting the provider clears it.",
              "nullable": true,
              "type": "string"
            }
          },
          "required": [
            "id",
            "builtin_id",
            "goose_provider_id",
            "name",
            "npm",
            "env_vars",
            "base_url",
            "docs_url",
            "is_openai_compatible",
            "connected",
            "oauth_supported",
            "oauth_keys",
            "connection_methods"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "providers": {
          "items": {
            "$ref": "#/$defs/ProviderCatalogItem"
          },
          "type": "array"
        },
        "total": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "providers",
        "total"
      ],
      "title": "ProviderCatalogResponse",
      "type": "object"
    }
  },
