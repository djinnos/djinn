          "properties": {
            "description": {
              "description": "Optional authoring guidance for the LLM: how to encode this block's\nchildren/attributes. Absent for blocks whose shape is self-evident.",
              "type": [
                "string",
                "null"
              ]
            },
            "fields": {
              "additionalProperties": {
                "$ref": "#/$defs/ProposalBlockFieldSchema"
              },
              "description": "Field schema keyed by field name.",
              "type": "object"
            },
            "tag": {
              "description": "MDX component tag, e.g. `AnnotatedCode`.",
              "type": "string"
            },
            "type": {
              "description": "Stable proposal block type identifier, e.g. `annotated-code`.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "tag",
            "fields"
          ],
          "type": "object"
        },
        "ProposalBlockFieldSchema": {
          "properties": {
            "enum_values": {
              "items": {
                "type": "string"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "fields": {
              "additionalProperties": {
                "$ref": "#/$defs/ProposalBlockFieldSchema"
              },
              "type": [
                "object",
                "null"
              ]
            },
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ProposalBlockFieldSchema"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "description": "Primitive schema kind: `string`, `boolean`, `object`, or `array`.",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "blocks": {
          "additionalProperties": {
            "$ref": "#/$defs/ProposalBlockDefinition"
          },
          "type": "object"
        }
      },
      "required": [
        "blocks"
      ],
      "type": "object"
    }
  },
