            "raw_text"
          ],
          "type": "object"
        },
        "GraphNode": {
          "description": "A knowledge graph node (note with connection metadata).",
          "properties": {
            "broken_targets": {
              "default": [],
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "connection_count": {
              "description": "Total resolved edges incident to this node (inbound + outbound).",
              "format": "int64",
              "type": "integer"
            },
            "folder": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "is_orphan": {
              "default": false,
              "type": "boolean"
            },
            "note_type": {
              "type": "string"
            },
            "permalink": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "permalink",
            "title",
            "note_type",
            "folder",
            "connection_count"
          ],
          "type": "object"
        },
        "TypedEdge": {
          "description": "A typed semantic edge between two notes (builds_on, contradicts, supersedes,\nexemplifies, derived_from). These are stored on `note_associations` with a\n`kind` value other than `co_access` and surfaced through the\n`memory_graph` tool as a separate layer from wikilink `GraphEdge`s so the\nUI can toggle/style them independently.\n\nNote: the F5 `note_associations` substrate is undirected (canonical-pair\nordering: `note_a_id < note_b_id`). Outbound direction for directional\nkinds (e.g. `supersedes`) is reconstructed at scoring/context time.",
          "properties": {
            "kind": {
              "type": "string"
            },
            "source_id": {
              "type": "string"
            },
            "target_id": {
              "type": "string"
            },
            "weight": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "source_id",
            "target_id",
            "kind",
            "weight"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "edges": {
          "items": {
            "$ref": "#/$defs/GraphEdge"
          },
          "type": "array"
        },
        "error": {
          "nullable": true,
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/GraphNode"
          },
          "type": "array"
        },
        "typed_edges": {
          "default": [],
          "description": "Typed semantic edges (builds_on, contradicts, supersedes, exemplifies,\nderived_from) from `note_associations` where `kind <> 'co_access'`.",
          "items": {
            "$ref": "#/$defs/TypedEdge"
          },
          "type": "array"
        }
      },
      "required": [
        "nodes",
        "edges"
      ],
      "title": "MemoryGraphResponse",
      "type": "object"
    }
  },
  {
    "name": "memory_health",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "project": {
          "description": "Absolute path to the project directory.",
          "nullable": true,
          "type": "string"
        }
      },
      "title": "HealthParams",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "LifecycleHealth": {
          "description": "Lifecycle-status counts for a project's notes.",
          "properties": {
            "active_notes": {
              "format": "int64",
              "type": "integer"
            },
            "archived_notes": {
              "format": "int64",
              "type": "integer"
            },
            "deprecated_notes": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "active_notes",
            "archived_notes",
            "deprecated_notes"
          ],
          "type": "object"
        },
        "RecentSweepMetrics": {
          "description": "Most recent housekeeping/operator lifecycle sweep counters surfaced through\n`memory_health`.",
          "properties": {
            "last_archived_count": {
              "format": "int64",
              "type": "integer"
            },
            "last_decayed_count": {
              "format": "int64",
              "type": "integer"
            },
            "last_superseded_source_count": {
              "format": "int64",
              "type": "integer"
            },
            "last_sweep_at": {
              "nullable": true,
              "type": "string"
            }
          },
          "required": [
            "last_decayed_count",
            "last_archived_count",
            "last_superseded_source_count"
          ],
          "type": "object"
        },
        "StaleFolder": {
          "description": "Stale-note count for one folder.",
          "properties": {
            "count": {
              "format": "int64",
              "type": "integer"
            },
            "folder": {
              "type": "string"
            }
          },
          "required": [
            "folder",
            "count"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "broken_link_count": {
          "format": "int64",
          "nullable": true,
          "type": "integer"
        },
        "error": {
          "nullable": true,
          "type": "string"
        },
        "lifecycle": {
          "anyOf": [
            {
              "$ref": "#/$defs/LifecycleHealth"
            },
            {
              "const": null,
              "nullable": true
            }
          ]
        },
        "low_confidence_note_count": {
          "format": "int64",
          "nullable": true,
          "type": "integer"
        },
        "orphan_note_count": {
          "format": "int64",
          "nullable": true,
          "type": "integer"
        },
        "recent_sweep": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecentSweepMetrics"
            },
            {
              "const": null,
              "nullable": true
            }
          ]
        },
        "stale_note_count": {
          "format": "int64",
          "nullable": true,
          "type": "integer"
        },
        "stale_notes_by_folder": {
          "items": {
            "$ref": "#/$defs/StaleFolder"
          },
          "nullable": true,
          "type": "array"
        },
        "total_notes": {
          "format": "int64",
          "nullable": true,
          "type": "integer"
        }
      },
      "title": "MemoryHealthResponse",
      "type": "object"
    }
  },
