  {
    "name": "task_timeline",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "project": {
          "default": null,
          "description": "Optional project hint (slug or UUID). Only needed to disambiguate a\n`short_id`; a task UUID resolves globally without it.",
          "type": [
            "string",
            "null"
          ]
        },
        "task_id": {
          "description": "Task UUID or short_id.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "AnyJson": {},
        "SessionToolSession": {
          "properties": {
            "agent_type": {
              "type": "string"
            },
            "cache_read_tokens": {
              "description": "Running totals of prompt-cache reads (hits) and writes (creation).",
              "format": "int64",
              "type": "integer"
            },
            "cache_write_tokens": {
              "format": "int64",
              "type": "integer"
            },
            "ended_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "id": {
              "type": "string"
            },
            "model_id": {
              "type": "string"
            },
            "parked_reason": {
              "description": "Optional deliberate-park reason for terminal sessions, e.g. `budget`.",
              "type": [
                "string",
                "null"
              ]
            },
            "project_id": {
              "description": "`None` for chat sessions (global, user-scoped); `Some(_)` for every\nother agent type. See `SessionRecord::project_id`.",
              "type": [
                "string",
                "null"
              ]
            },
            "started_at": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "task_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "tokens_in": {
              "format": "int64",
              "type": "integer"
            },
            "tokens_out": {
              "format": "int64",
              "type": "integer"
            },
            "workspace_path": {
              "description": "Authoritative workspace path for the session, sourced from the\nattached `task_run` (via `sessions.task_run_id`). `None` when the\nsession is not attached to a task run or the run has no recorded\nworkspace.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "model_id",
            "agent_type",
            "started_at",
            "status",
            "tokens_in",
            "tokens_out",
            "cache_read_tokens",
            "cache_write_tokens"
          ],
          "type": "object"
        },
        "TimelineActivity": {
          "properties": {
            "actor_role": {
              "type": "string"
            },
            "details": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AnyJson"
                },
                {
                  "type": "null"
                }
              ]
            },
            "event_type": {
              "type": "string"
            },
            "kind": {
              "description": "Renderer-friendly discriminator. Usually mirrors `event_type`; for\nstructured payloads this is the semantic timeline kind.",
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/AnyJson"
            },
            "summary": {
              "type": [
                "string",
                "null"
              ]
            },
            "timestamp": {
              "type": "string"
            }
          },
          "required": [
            "event_type",
            "actor_role",
            "kind",
            "payload",
            "timestamp"
          ],
          "type": "object"
        },
        "TimelineMessage": {
          "properties": {
            "agent_type": {
              "type": "string"
            },
            "content": {
              "items": {
                "$ref": "#/$defs/AnyJson"
              },
              "type": "array"
            },
            "model_id": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "session_id": {
              "type": "string"
            },
            "timestamp": {
              "type": "string"
            }
          },
          "required": [
            "session_id",
            "role",
            "content",
            "agent_type",
            "model_id",
            "timestamp"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "activity": {
          "items": {
            "$ref": "#/$defs/TimelineActivity"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/TimelineMessage"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "sessions": {
          "items": {
            "$ref": "#/$defs/SessionToolSession"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  {
    "name": "task_transition",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "action": {
          "description": "Transition action: start,\nsubmit_task_review, task_review_start,\ntask_review_reject, task_review_reject_conflict, task_review_approve,\npr_created, pr_undraft, pr_ci_failed, pr_conflict,\npr_merge, pr_changes_requested,\nreopen, close, release, release_task_review, force_close,\nuser_override.",
          "type": "string"
        },
        "actor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "actor_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Task UUID or short_id.",
          "type": "string"
        },
        "project": {
          "description": "Absolute project path.",
          "type": "string"
        },
        "reason": {
          "description": "Required for:\ntask_review_reject, task_review_reject_conflict,\npr_changes_requested,\nreopen, release, release_task_review, force_close.",
          "type": [
            "string",
            "null"
          ]
        },
        "target_status": {
          "description": "Required when action = \"user_override\". Allowed values: open, in_progress,\nneeds_task_review, in_task_review, approved, pr_draft, pr_review, closed.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "project",
        "id",
        "action"
      ],
      "type": "object"
    },
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": true,
      "type": "object"
    }
  },
  {
    "name": "task_update",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$defs": {
        "AcceptanceCriterionItem": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/AcceptanceCriterionStatus"
            }
          ]
        },
        "AcceptanceCriterionStatus": {
          "properties": {
            "criterion": {
              "type": "string"
            },
            "met": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "criterion"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "acceptance_criteria": {
          "description": "Full replacement for acceptance_criteria.",
          "items": {
            "$ref": "#/$defs/AcceptanceCriterionItem"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "agent_type": {
          "description": "Specialist role name to assign (set None/\"\" to clear).",
          "type": [
            "string",
            "null"
          ]
        },
        "blocked_by_add": {
          "description": "Task IDs (UUID or short_id) to add as blockers of this task.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "blocked_by_remove": {
          "description": "Task IDs (UUID or short_id) to remove as blockers of this task.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "design": {
          "type": [
            "string",
            "null"
          ]
        },
        "epic_id": {
          "description": "New parent epic UUID or short_id.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Task UUID or short_id.",
          "type": "string"
        },
        "labels_add": {
          "description": "Labels to add.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "labels_remove": {
          "description": "Labels to remove.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "memory_refs_add": {
          "description": "Memory note permalinks to add to this task.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "memory_refs_remove": {
          "description": "Memory note permalinks to remove from this task.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "priority": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "project": {
          "description": "Absolute project path.",
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "project",
        "id"
      ],
      "type": "object"
    },
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": true,
      "type": "object"
    }
  },
  {
    "name": "toolchain_versions",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object"
    },
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "status": {
          "type": "string"
        },
        "versions": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "description": "Available versions per language (rust/node/python/go/java/ruby/dotnet/clang),\nfetched live from upstream (cached) with static fallback.",
          "type": "object"
        }
      },
      "required": [
        "status",
        "versions"
      ],
      "type": "object"
    }
  },
  {
    "name": "user_settings_get",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "target_user_id": {
          "default": null,
          "description": "Admin-only: act on behalf of this user id (e.g. another user to\nconfigure). Non-admins must omit it.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "LaneMaxSessionsPayload": {
          "description": "Per-user concurrency ceilings for each role lane.",
          "properties": {
            "implement": {
              "description": "Concurrent worker sessions.",
              "format": "int64",
              "maximum": 10,
              "minimum": 1,
              "type": "integer"
            },
            "plan": {
              "description": "Concurrent autonomous planning and refinement sessions. Interactive\nchat is not subject to this ceiling.",
              "format": "int64",
              "maximum": 10,
              "minimum": 1,
              "type": "integer"
            },
            "review": {
              "description": "Concurrent reviewer sessions.",
              "format": "int64",
              "maximum": 10,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "plan",
            "implement",
            "review"
          ],
          "type": "object"
        },
        "ModelLanesPayload": {
          "description": "Per-user, per-ROLE ordered model selection over the wire. Each lane is an\nordered fallback list (highest priority first) of full `provider/model` ids.\nA task's base role maps to one lane: `plan` (planner/architect/chat),\n`implement` (worker), `review` (reviewer).",
          "properties": {
            "implement": {
              "default": [],
              "description": "worker",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "plan": {
              "default": [],
              "description": "planner, architect, chat",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "review": {
              "default": [],
              "description": "reviewer",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "auto_approve_prs": {
          "description": "Auto-approve PRs that are otherwise ready to merge. When true, the\npoller POSTs an APPROVE review using this user's GitHub token at the\nmoment the PR has CI green + no conflicts + no existing approvals.\nDefaults to false. Each task's `created_by_user_id` decides whose\ntoggle applies; background-agent tasks (`created_by_user_id IS NULL`)\nare never auto-approved.",
          "type": "boolean"
        },
        "diverse_refinement": {
          "description": "Cross-model (\"Diverse\") refinement. When true (the default), the\nproposal-refinement roles (advocate, adversary, judge) prefer a model id\ndifferent from the primary task model. Falls back to same-model when\nalternatives are unavailable.",
          "type": "boolean"
        },
        "diverse_review": {
          "description": "Cross-model (\"Thorough\") review. When true (the default), a task\ndispatched to the reviewer role prefers a model id different from the one\nthat implemented it. A degenerate single-model selection falls back to\nsame-model review.",
          "type": "boolean"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "lane_locked": {
          "description": "True when the org AI policy locks lane assignment: the member may not\nedit lanes (UI disables the controls; the server rejects lane writes).",
          "type": "boolean"
        },
        "lane_max_sessions": {
          "anyOf": [
            {
              "$ref": "#/$defs/LaneMaxSessionsPayload"
            },
            {
              "type": "null"
            }
          ],
          "description": "Per-lane concurrency ceilings. `None` means this user has no\nlane-specific ceiling (legacy/unbounded behavior)."
        },
        "lanes": {
          "$ref": "#/$defs/ModelLanesPayload",
          "description": "This user's per-ROLE ordered model lanes (each highest priority first),\nfull `provider/model` ids. All-empty when the user has no explicit\nselection (callers then fall back to the global deployment model list).\nWhen the org lane policy is `locked`, this echoes the org default\n(member edits are ignored)."
        },
        "max_sessions": {
          "additionalProperties": {
            "format": "int64",
            "type": "integer"
          },
          "description": "This user's per-model concurrency caps (`{ \"provider/model\": cap }`).\nPer-model admission ceilings at dispatch, composed with any per-lane\nceiling; empty ⇒ default 1 per model.",
          "type": "object"
        },
        "ok": {
          "type": "boolean"
        },
        "user_id": {
          "description": "`users.id` of the signed-in caller (echoed so the UI can sanity-check identity).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "ok",
        "auto_approve_prs",
        "lanes",
        "lane_locked",
        "max_sessions",
        "diverse_review",
        "diverse_refinement"
      ],
      "type": "object"
    }
  },
  {
    "name": "user_settings_set",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$defs": {
        "LaneMaxSessionsPayload": {
          "description": "Per-user concurrency ceilings for each role lane.",
          "properties": {
            "implement": {
              "description": "Concurrent worker sessions.",
              "format": "int64",
              "maximum": 10,
              "minimum": 1,
              "type": "integer"
            },
            "plan": {
              "description": "Concurrent autonomous planning and refinement sessions. Interactive\nchat is not subject to this ceiling.",
              "format": "int64",
              "maximum": 10,
              "minimum": 1,
              "type": "integer"
            },
            "review": {
              "description": "Concurrent reviewer sessions.",
              "format": "int64",
              "maximum": 10,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "plan",
            "implement",
            "review"
          ],
          "type": "object"
        },
        "ModelLanesPayload": {
          "description": "Per-user, per-ROLE ordered model selection over the wire. Each lane is an\nordered fallback list (highest priority first) of full `provider/model` ids.\nA task's base role maps to one lane: `plan` (planner/architect/chat),\n`implement` (worker), `review` (reviewer).",
          "properties": {
            "implement": {
              "default": [],
              "description": "worker",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "plan": {
              "default": [],
              "description": "planner, architect, chat",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "review": {
              "default": [],
              "description": "reviewer",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "auto_approve_prs": {
          "description": "Enable or disable auto-approve. Omit to keep the current value.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "diverse_refinement": {
          "description": "Enable or disable cross-model (\"Diverse\") refinement for THIS user. When\non (the default), proposal-refinement roles prefer a different model from\nthe primary task model. Falls back to same-model when alternatives are\nunavailable. Omit to keep the current value.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "diverse_review": {
          "description": "Enable or disable cross-model (\"Thorough\") review for THIS user. When on\n(the default), the reviewer prefers a model id different from the\nimplementer's. Omit to keep the current value.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "lane_max_sessions": {
          "anyOf": [
            {
              "$ref": "#/$defs/LaneMaxSessionsPayload"
            },
            {
              "type": "null"
            }
          ],
          "description": "Per-lane concurrency ceilings for THIS user. Every value must be in\n1..=10. Omit to keep the current value."
        },
        "lanes": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelLanesPayload"
            },
            {
              "type": "null"
            }
          ],
          "description": "Per-ROLE ordered model lanes for THIS user (each highest priority first),\nas full `provider/model` ids: `plan` (planner/architect/chat),\n`implement` (worker), `review` (reviewer). Each id must be a model on a\nprovider this user has connected. Pass all-empty lanes to clear the\nselection (→ global fallback). Omit to keep the current value."
        },
        "max_sessions": {
          "additionalProperties": {
            "format": "int64",
            "type": "integer"
          },
          "description": "Per-model concurrency caps for THIS user (`{ \"provider/model\": cap }`).\nHow many sessions of each model may run concurrently for this user — the\nper-model admission ceiling (there is no global ceiling), composed with\nany per-lane ceiling. Pass `{}` to clear (→ default 1 per model). Omit to\nkeep the current value.",
          "type": [
            "object",
            "null"
          ]
        },
        "target_user_id": {
          "default": null,
          "description": "Admin-only: act on behalf of this user id (e.g. another user to\nconfigure). Non-admins must omit it.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "LaneMaxSessionsPayload": {
          "description": "Per-user concurrency ceilings for each role lane.",
          "properties": {
            "implement": {
              "description": "Concurrent worker sessions.",
              "format": "int64",
              "maximum": 10,
              "minimum": 1,
              "type": "integer"
            },
            "plan": {
              "description": "Concurrent autonomous planning and refinement sessions. Interactive\nchat is not subject to this ceiling.",
              "format": "int64",
              "maximum": 10,
              "minimum": 1,
              "type": "integer"
            },
            "review": {
              "description": "Concurrent reviewer sessions.",
              "format": "int64",
              "maximum": 10,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "plan",
            "implement",
            "review"
          ],
          "type": "object"
        },
        "ModelLanesPayload": {
          "description": "Per-user, per-ROLE ordered model selection over the wire. Each lane is an\nordered fallback list (highest priority first) of full `provider/model` ids.\nA task's base role maps to one lane: `plan` (planner/architect/chat),\n`implement` (worker), `review` (reviewer).",
          "properties": {
            "implement": {
              "default": [],
              "description": "worker",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "plan": {
              "default": [],
              "description": "planner, architect, chat",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "review": {
              "default": [],
              "description": "reviewer",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "auto_approve_prs": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "diverse_refinement": {
          "description": "The resulting cross-model refinement toggle after the patch.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "diverse_review": {
          "description": "The resulting cross-model review toggle after the patch.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "lane_max_sessions": {
          "anyOf": [
            {
              "$ref": "#/$defs/LaneMaxSessionsPayload"
            },
            {
              "type": "null"
            }
          ],
          "description": "The resulting per-lane concurrency ceilings after the patch. `None`\nmeans no lane-specific ceiling."
        },
        "lanes": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelLanesPayload"
            },
            {
              "type": "null"
            }
          ],
          "description": "The resulting per-role model lanes after the patch."
        },
        "max_sessions": {
          "additionalProperties": {
            "format": "int64",
            "type": "integer"
          },
          "description": "The resulting per-model concurrency caps after the patch.",
          "type": [
            "object",
            "null"
          ]
        },
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "ok",
        "applied"
      ],
      "type": "object"
    }
  }
]
