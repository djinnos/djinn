              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "criterion"
          ],
          "type": "object"
        },
        "ProposalListRow": {
          "description": "List-specific proposal row model.\n\nBy default (`include_bodies = false`) the full `body` field is omitted\nfrom serialization; callers receive only `body_excerpt` and\n`body_truncated`.  When `include_bodies = true`, the full `body` is\nincluded alongside the excerpt metadata so callers that need the\ncomplete text can still get it in a single list call.",
          "properties": {
            "acceptance_criteria": {
              "description": "Structured acceptance criteria (`{criterion, met}` or plain string),\nsame shape as tasks. `met` means \"agreed during scoping\".",
              "items": {
                "$ref": "#/$defs/AcceptanceCriterionItem"
              },
              "type": "array"
            },
            "author_user_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "body": {
              "description": "Full proposal body — **only serialized when `include_bodies = true`**.",
              "type": [
                "string",
                "null"
              ]
            },
            "body_excerpt": {
              "description": "First 512 Unicode scalar values of the proposal body.  Always\npresent regardless of `include_bodies`.",
              "type": "string"
            },
            "body_format": {
              "description": "Body encoding: `markdown` (legacy default) or `mdx` (block-aware).",
              "type": "string"
            },
            "body_truncated": {
              "description": "`true` when the original body exceeded the 512-scalar cap.",
              "type": "boolean"
            },
            "build_owner_user_id": {
              "description": "Build owner once graduated.",
              "type": [
                "string",
                "null"
              ]
            },
            "closed_at": {
              "type": [
                "string",
                "null"
              ]
            },
