  {
    "name": "memory_edit",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "content": {
          "type": "string"
        },
        "find_text": {
          "description": "Required for find_replace: exact text to search for.",
          "type": [
            "string",
            "null"
          ]
        },
        "identifier": {
          "description": "Note permalink or title.",
          "type": "string"
        },
        "operation": {
          "description": "Operation: \"append\", \"prepend\", \"find_replace\", \"replace_section\".",
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "retrieval_anchor": {
          "default": null,
          "description": "Replace the note's retrieval anchor without modifying the note body.\nAlso accepted as `applies_when`.",
          "type": [
            "string",
            "null"
          ]
        },
        "section": {
          "description": "Required for replace_section: heading text identifying the section.",
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "description": "If provided and different from current type, move the note to the new\ntype's folder. Allowed values same as memory_write type.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "project",
        "identifier",
        "operation",
        "content"
      ],
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "MemoryProposalRefItem": {
          "properties": {
            "id": {
              "type": "string"
            },
            "short_id": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "short_id",
            "title",
            "status"
          ],
          "type": "object"
        },
        "MemoryTaskRefItem": {
          "properties": {
            "id": {
              "type": "string"
            },
            "short_id": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "short_id",
            "title",
            "status"
          ],
          "type": "object"
        },
        "ResolvedMention": {
          "properties": {
            "entity_type": {
              "type": "string"
            },
            "permalink": {
              "type": "string"
            },
            "short_id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "short_id",
            "entity_type",
            "title",
            "permalink"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "content": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "deduplicated": {
          "type": "boolean"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "file_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "folder": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_accessed": {
          "type": [
            "string",
            "null"
          ]
        },
        "note_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "permalink": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "proposals": {
          "description": "Proposals reachable through this note's tasks/epics (via proposal_epics).",
          "items": {
            "$ref": "#/$defs/MemoryProposalRefItem"
          },
          "type": "array"
        },
        "resolved_mentions": {
          "description": "Short_id mentions found in note body, resolved to entities.",
          "items": {
            "$ref": "#/$defs/ResolvedMention"
          },
          "type": "array"
        },
        "retrieval_anchor": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "tasks": {
          "description": "Tasks whose memory_refs contain this note's permalink.",
          "items": {
            "$ref": "#/$defs/MemoryTaskRefItem"
          },
          "type": "array"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "deduplicated"
      ],
      "type": "object"
    }
  },
  {
    "name": "memory_extracted_audit",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "project": {
          "type": "string"
        }
      },
      "required": [
        "project"
      ],
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "ExtractedNoteAuditCategory": {
          "description": "Classification assigned during ADR-054 extracted-note corpus audits.",
          "enum": [
            "merge_candidate",
            "underspecified",
            "demote_to_working_spec",
            "archive_candidate"
          ],
          "type": "string"
        },
        "ExtractedNoteAuditFinding": {
          "description": "A single extracted note flagged by the ADR-054 audit.",
          "properties": {
            "category": {
              "$ref": "#/$defs/ExtractedNoteAuditCategory"
            },
            "folder": {
              "type": "string"
            },
            "note_id": {
              "type": "string"
            },
            "note_type": {
              "type": "string"
            },
            "permalink": {
              "type": "string"
            },
            "reasons": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "related_note_ids": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "note_id",
            "permalink",
            "title",
            "note_type",
            "folder",
            "category",
            "reasons",
            "related_note_ids"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "archive_candidates": {
          "items": {
            "$ref": "#/$defs/ExtractedNoteAuditFinding"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "demote_to_working_spec": {
          "items": {
            "$ref": "#/$defs/ExtractedNoteAuditFinding"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "merge_candidates": {
          "items": {
            "$ref": "#/$defs/ExtractedNoteAuditFinding"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "rerun_hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "scanned_note_count": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "underspecified": {
          "items": {
            "$ref": "#/$defs/ExtractedNoteAuditFinding"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  {
    "name": "memory_graph",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "project": {
          "type": "string"
        }
      },
      "required": [
        "project"
      ],
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "GraphEdge": {
          "description": "A resolved wikilink edge between two notes.",
          "properties": {
            "raw_text": {
              "type": "string"
            },
            "source_id": {
              "type": "string"
            },
            "target_id": {
              "type": "string"
            }
          },
          "required": [
            "source_id",
            "target_id",
            "raw_text"
          ],
          "type": "object"
        },
        "GraphNode": {
          "description": "A knowledge graph node (note with connection metadata).",
          "properties": {
            "broken_targets": {
              "default": [],
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "connection_count": {
              "description": "Total resolved edges incident to this node (inbound + outbound).",
              "format": "int64",
              "type": "integer"
            },
            "entity_type": {
              "default": "note",
              "description": "Entity type discriminator: `\"note\"` for note rows, `\"proposal\"` for\nproposal rows. Defaults to `\"note\"` so existing serialized responses\nremain backward-compatible.",
              "type": "string"
            },
            "folder": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "is_orphan": {
              "default": false,
              "type": "boolean"
            },
            "note_type": {
              "type": "string"
            },
            "permalink": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "permalink",
            "title",
            "note_type",
            "folder",
            "connection_count"
          ],
          "type": "object"
        },
        "TypedEdge": {
          "description": "A typed semantic edge between two notes (builds_on, contradicts, supersedes,\nexemplifies, derived_from). These are stored on `note_associations` with a\n`kind` value other than `co_access` and surfaced through the\n`memory_graph` tool as a separate layer from wikilink `GraphEdge`s so the\nUI can toggle/style them independently.\n\nNote: the F5 `note_associations` substrate is undirected (canonical-pair\nordering: `note_a_id < note_b_id`). Outbound direction for directional\nkinds (e.g. `supersedes`) is reconstructed at scoring/context time.",
          "properties": {
            "kind": {
              "type": "string"
            },
            "source_entity_type": {
              "default": "note",
              "description": "Entity type of the source endpoint. Defaults to `\"note\"` for backward\ncompatibility with existing serialized responses.",
              "type": "string"
            },
            "source_id": {
              "type": "string"
            },
            "target_entity_type": {
              "default": "note",
              "description": "Entity type of the target endpoint. Defaults to `\"note\"` for backward\ncompatibility with existing serialized responses.",
              "type": "string"
            },
            "target_id": {
              "type": "string"
            },
            "weight": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "source_id",
            "target_id",
            "kind",
            "weight"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "edges": {
          "items": {
            "$ref": "#/$defs/GraphEdge"
          },
          "type": "array"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/GraphNode"
          },
          "type": "array"
        },
        "typed_edges": {
          "default": [],
          "description": "Typed semantic edges (builds_on, contradicts, supersedes, exemplifies,\nderived_from) from `note_associations` where `kind <> 'co_access'`.",
          "items": {
            "$ref": "#/$defs/TypedEdge"
          },
          "type": "array"
        }
      },
      "required": [
        "nodes",
        "edges"
      ],
      "type": "object"
    }
  },
  {
    "name": "memory_health",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "project": {
          "description": "Absolute path to the project directory.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "LifecycleHealth": {
          "description": "Lifecycle-status counts for a project's notes.",
          "properties": {
            "active_notes": {
              "format": "int64",
              "type": "integer"
            },
            "archived_notes": {
              "format": "int64",
              "type": "integer"
            },
            "deprecated_notes": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "active_notes",
            "archived_notes",
            "deprecated_notes"
          ],
          "type": "object"
        },
        "RecentSweepMetrics": {
          "description": "Most recent housekeeping/operator lifecycle sweep counters surfaced through\n`memory_health`.",
          "properties": {
            "last_archived_count": {
              "format": "int64",
              "type": "integer"
            },
            "last_decayed_count": {
              "format": "int64",
              "type": "integer"
            },
            "last_superseded_source_count": {
              "format": "int64",
              "type": "integer"
            },
            "last_sweep_at": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "last_decayed_count",
            "last_archived_count",
            "last_superseded_source_count"
          ],
          "type": "object"
        },
        "StaleFolder": {
          "description": "Stale-note count for one folder.",
          "properties": {
            "count": {
              "format": "int64",
              "type": "integer"
            },
            "folder": {
              "type": "string"
            }
          },
          "required": [
            "folder",
            "count"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "authored_orphan_count": {
          "description": "Notes with zero inbound authored wikilink or explicit authored\nassociation edges.  Machine-minted edges do *not* hide authored-link\ndebt.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "broken_link_count": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "isolated_count": {
          "description": "Notes with no retrieval-effective edges at all — the strictest\nconnectivity metric.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "isolated_pct": {
          "description": "`isolated_count` as a percentage of non-singleton notes.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "lifecycle": {
          "anyOf": [
            {
              "$ref": "#/$defs/LifecycleHealth"
            },
            {
              "type": "null"
            }
          ]
        },
        "low_confidence_note_count": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "machine_connected_orphan_count": {
          "description": "Authored-orphan notes that are *not* graph-isolated because at\nleast one non-authored retrieval edge connects them.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "orphan_note_count": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "recent_sweep": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecentSweepMetrics"
            },
            {
              "type": "null"
            }
          ]
        },
        "stale_note_count": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "stale_notes_by_folder": {
          "items": {
            "$ref": "#/$defs/StaleFolder"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "total_notes": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  {
    "name": "memory_history",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
