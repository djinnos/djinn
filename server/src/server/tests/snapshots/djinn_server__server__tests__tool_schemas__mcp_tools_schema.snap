  {
    "name": "provider_model_lookup",
    "read_only": false,
    "destructive": true,
    "idempotent": false,
    "open_world": false,
    "concurrent_safe": false,
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "model_id": {
          "description": "Full model ID in 'providerID/modelID' format (e.g. 'anthropic/claude-opus-4-6').",
          "type": "string"
        }
      },
      "required": [
        "model_id"
      ],
      "title": "ProviderModelLookupInput",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "ErrorClass": {
          "description": "Coarse failure taxonomy for [`ToolError`].\n\nUsed by supervisors and downstream consumers to branch on failure mode\nwithout having to re-parse the message string. Every variant maps to a\ndistinct operational decision the agent can make.\n\nSee the [module-level documentation](self) for the full classification\ntable. The serialized form is the snake_case variant name (e.g.\n`\"conflict_recoverable\"`).",
          "oneOf": [
            {
              "const": "not_found",
              "description": "The targeted resource does not exist (HTTP 404).",
              "type": "string"
            },
            {
              "const": "conflict_recoverable",
              "description": "A recoverable state conflict — the agent can take a concrete next step\n(HTTP 409, HTTP 422 with a known recovery-action substring such as\n\"already exists\"). Hints on this class MUST name the recovery action.",
              "type": "string"
            },
            {
              "const": "validation",
              "description": "The request was malformed or invalid (HTTP 400, generic HTTP 422).",
              "type": "string"
            },
            {
              "const": "permission",
              "description": "Credentials missing or insufficient (HTTP 401, 403).",
              "type": "string"
            },
            {
              "const": "rate_limited",
              "description": "Upstream quota exhausted (HTTP 429).",
              "type": "string"
            },
            {
              "const": "transient",
              "description": "A typed retryable network/upstream condition (HTTP 5xx). Only emitted\nwhen the typed source confirms a retryable signature.",
              "type": "string"
            },
            {
              "const": "internal",
              "description": "Status-less or unknown error. Default for [`ToolError::from_untyped`]\nand any unclassified typed source. **Never** used for retryable network\nblips — those are [`ErrorClass::Transient`].",
              "type": "string"
            }
          ]
        },
        "ModelPricingOutput": {
          "properties": {
            "cache_read_per_million": {
              "format": "double",
              "type": "number"
            },
            "cache_write_per_million": {
              "format": "double",
              "type": "number"
            },
            "input_per_million": {
              "format": "double",
              "type": "number"
            },
            "output_per_million": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "input_per_million",
            "output_per_million",
            "cache_read_per_million",
            "cache_write_per_million"
          ],
          "type": "object"
        },
        "ProviderModelOutput": {
          "properties": {
            "attachment": {
              "type": "boolean"
            },
            "context_window": {
              "format": "int64",
              "type": "integer"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "output_limit": {
              "format": "int64",
              "type": "integer"
            },
            "pricing": {
              "$ref": "#/$defs/ModelPricingOutput"
            },
            "provider_id": {
              "type": "string"
            },
            "reasoning": {
              "type": "boolean"
            },
            "tool_call": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "provider_id",
            "name",
            "tool_call",
            "reasoning",
            "attachment",
            "context_window",
            "output_limit",
            "pricing"
          ],
          "type": "object"
        },
        "ToolError": {
          "description": "Structured error envelope returned to the agent in place of (or alongside) a\nflat error string. Serializes to a JSON object; absent fields are omitted so\nthe wire shape stays compact.",
          "properties": {
            "body": {
              "description": "Bounded upstream detail (response body, provider message) when\navailable. Truncated to [`MAX_BODY_EXCERPT_BYTES`] bytes with a\n`[truncated: N bytes omitted]` marker if the raw body was longer. The\nraw body is preserved internally for `tracing::warn!` but never\nserialized into the agent-visible envelope.",
              "nullable": true,
              "type": "string"
            },
            "error": {
              "description": "Human-readable message describing what went wrong. Always present.",
              "type": "string"
            },
            "error_class": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ErrorClass"
                },
                {
                  "const": null,
                  "nullable": true
                }
              ],
              "description": "Coarse failure class. Assigned at construction time from a typed\nsource (HTTP status, provider error variant). Omitted from the wire\nwhen unknown — the legacy envelope shape (without this field) is\nstill valid."
            },
            "hint": {
              "description": "Actionable next step the agent can take to recover or disambiguate.",
              "nullable": true,
              "type": "string"
            },
            "method": {
              "description": "The logical operation that failed — typically the MCP tool name (e.g.\n\"provider_model_lookup\") or the upstream method (\"GET /search/code\").",
              "nullable": true,
              "type": "string"
            },
            "path": {
              "description": "The resource the call targeted — a model id, repo path, PR ref, URL, etc.",
              "nullable": true,
              "type": "string"
            },
            "status": {
              "description": "Status as a numeric HTTP code (e.g. \"404\", \"422\") or a coarse category\n(e.g. \"not_found\", \"rate_limited\", \"network\"). Stored as a string so a\nnumeric HTTP status and a symbolic category share one field.",
              "nullable": true,
              "type": "string"
            }
          },
          "required": [
            "error"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolError"
            },
            {
              "const": null,
              "nullable": true
            }
          ],
          "description": "G3 structured-error envelope, populated on a 404-style miss (the model id\nis not in the catalog). Lets the agent branch on `status == \"404\"` and\nfollow the `hint` instead of re-guessing the same bad id. Absent on a hit."
        },
        "found": {
          "type": "boolean"
        },
        "model": {
          "$ref": "#/$defs/ProviderModelOutput"
        },
        "model_id": {
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "found",
        "model"
      ],
      "title": "ProviderModelLookupResponse",
      "type": "object"
    }
  },
