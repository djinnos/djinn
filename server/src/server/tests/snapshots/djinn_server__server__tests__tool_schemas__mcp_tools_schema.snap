          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "project": {
          "description": "Absolute project path.",
          "type": "string"
        }
      },
      "required": [
        "project"
      ],
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "AgentModel": {
          "properties": {
            "base_role": {
              "type": "string"
            },
            "created_at": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "is_default": {
              "type": "boolean"
            },
            "mcp_servers": {
              "items": {
                "$ref": "#/$defs/AnyJson"
              },
              "type": "array"
            },
            "model_preference": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": "string"
            },
            "project_id": {
              "type": "string"
            },
            "skills": {
              "items": {
                "$ref": "#/$defs/AnyJson"
              },
              "type": "array"
            },
            "system_prompt_extensions": {
              "type": "string"
            },
            "updated_at": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "project_id",
            "name",
            "base_role",
            "description",
            "system_prompt_extensions",
            "mcp_servers",
            "skills",
            "is_default",
            "created_at",
            "updated_at"
          ],
          "type": "object"
        },
        "AnyJson": {}
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "agents": {
          "items": {
            "$ref": "#/$defs/AgentModel"
          },
          "type": [
