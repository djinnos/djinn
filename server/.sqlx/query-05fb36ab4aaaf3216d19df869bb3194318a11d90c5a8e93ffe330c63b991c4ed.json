  "query": "SELECT DISTINCT p.id AS \"id!\", p.short_id, p.title, p.status AS \"status!\"\n             FROM proposals p\n             JOIN proposal_epics pe ON pe.proposal_id = p.id\n             JOIN tasks t ON t.epic_id = pe.epic_id\n             WHERE t.memory_refs @> $1\n             ORDER BY p.id",
