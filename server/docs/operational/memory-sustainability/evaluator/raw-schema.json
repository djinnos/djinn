{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory-sustainability-raw/v1",
  "title": "Memory sustainability offline evaluator input",
  "type": "object",
  "required": ["candidate"],
  "properties": {
    "candidate": {"$ref": "#/$defs/run"},
    "pre_change_diagnostic": {"$ref": "#/$defs/run"}
  },
  "additionalProperties": false,
  "$defs": {
    "run": {
      "type": "object",
      "required": ["schema", "run_id", "candidate_image_id", "cgroup_limit_bytes", "samples", "route_samples", "board_passes"],
      "properties": {
        "schema": {"const": "memory-sustainability-raw/v1"},
        "run_id": {"type": "string", "minLength": 1},
        "candidate_image_id": {"type": "string", "minLength": 1},
        "cgroup_limit_bytes": {"const": 4294967296},
        "samples": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/sample"}},
        "route_samples": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/route"}},
        "board_passes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/board"}}
      },
      "additionalProperties": false
    },
    "sample": {
      "type": "object",
      "required": ["run_id", "image_id", "phase", "server_rss_bytes", "warm_job_rss_bytes", "jemalloc_retained_bytes", "graph_generation_id", "oom_kill_count", "restart_count"],
      "properties": {
        "run_id": {"type": "string"}, "image_id": {"type": "string"},
        "phase": {"enum": ["T0", "graph_install", "T1", "burst", "T2"]},
        "server_rss_bytes": {"type": "integer", "minimum": 0}, "warm_job_rss_bytes": {"type": "integer", "minimum": 0},
        "jemalloc_retained_bytes": {"type": "integer", "minimum": 0}, "graph_generation_id": {"type": "string", "minLength": 1},
        "oom_kill_count": {"type": "integer", "minimum": 0}, "restart_count": {"type": "integer", "minimum": 0}
      }, "additionalProperties": false
    },
    "route": {"type": "object", "required": ["run_id", "image_id", "http_status", "rss_before_bytes", "rss_after_bytes"], "properties": {"run_id": {"type": "string"}, "image_id": {"type": "string"}, "http_status": {"enum": [200, 304]}, "rss_before_bytes": {"type": "integer", "minimum": 0}, "rss_after_bytes": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "board": {"type": "object", "required": ["run_id", "image_id", "duration_ms"], "properties": {"run_id": {"type": "string"}, "image_id": {"type": "string"}, "duration_ms": {"type": "integer", "minimum": 0}}, "additionalProperties": false}
  }
}
