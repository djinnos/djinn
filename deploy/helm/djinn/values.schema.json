{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "djinn chart values",
  "type": "object",
  "properties": {
    "cacheCleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["delete", "dry_run"] }
      }
    },
    "graphRetention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "historyN"],
      "properties": {
        "mode": { "type": "string", "enum": ["off", "dry_run", "delete"] },
        "historyN": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    },
    "scipCache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxBytes", "maxIdleHours"],
      "properties": {
        "maxBytes": { "type": "integer", "minimum": 0 },
        "maxIdleHours": { "type": "integer", "minimum": 0 }
      }
    },
    "scipIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "intervalSeconds",
        "quiescenceSeconds",
        "claimWaitSeconds"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "intervalSeconds": { "type": "integer", "minimum": 1 },
        "quiescenceSeconds": { "type": "integer", "minimum": 0 },
        "claimWaitSeconds": { "type": "integer", "minimum": 0 }
      }
    },
    "kueue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "buildCpu", "buildMemory", "buildPods", "armed", "namespaceLabelledExternally", "capacity"],
      "properties": {
        "enabled": { "type": "boolean" },
        "buildCpu": { "$ref": "#/definitions/quantity" },
        "buildMemory": { "$ref": "#/definitions/quantity" },
        "buildPods": { "type": "integer", "minimum": 1 },
        "armed": { "type": "boolean" },
        "namespaceLabelledExternally": { "type": "boolean" },
        "capacity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "idleCpu", "compileCpu", "failSafePods", "failSafeCompileSlots", "contract", "source", "queueName", "nodeSelector", "flavorSelector", "headroom", "staticFallback", "nodePool"],
          "properties": {
            "enabled": { "type": "boolean" },
            "idleCpu": { "type": "string", "pattern": "^[1-9][0-9]*m$" },
            "compileCpu": { "type": "string", "pattern": "^[1-9][0-9]*m$" },
            "failSafePods": { "type": "integer", "minimum": 1 },
            "failSafeCompileSlots": { "type": "integer", "minimum": 1 },
            "contract": { "type": "string", "enum": ["", "vector-v1"] },
            "source": { "type": "string", "enum": ["node-sum", "nodepool-limits", "static"] },
            "queueName": { "type": "string" },
            "nodeSelector": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "value"],
              "properties": { "key": { "type": "string" }, "value": { "type": "string" } }
            },
            "flavorSelector": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "value"],
              "properties": { "key": { "type": "string" }, "value": { "type": "string" } }
            },
            "headroom": {"type":"object","additionalProperties":false,"required":["cpu","memory","pods"],"properties":{"cpu":{"$ref":"#/definitions/quantity"},"memory":{"$ref":"#/definitions/quantity"},"pods":{"type":"integer","minimum":0}}},
            "staticFallback": {"type":"object","additionalProperties":false,"required":["cpu","memory","pods"],"properties":{"cpu":{"$ref":"#/definitions/quantity"},"memory":{"$ref":"#/definitions/quantity"},"pods":{"type":"integer","minimum":1}}},
            "nodePool": {"type":"object","additionalProperties":false,"required":["dedicated","name"],"properties":{"dedicated":{"type":"boolean"},"name":{"type":"string"}}}
          }
        }
      }
    },
    "logCollector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "vectorImage", "rotatorImage", "storePath", "bufferMiB", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "vectorImage": {
          "type": "string",
          "pattern": "^.+:[A-Za-z0-9][A-Za-z0-9._-]*$",
          "not": { "pattern": ":latest$" }
        },
        "rotatorImage": {
          "type": "string",
          "pattern": "^.+:[A-Za-z0-9][A-Za-z0-9._-]*$",
          "not": { "pattern": ":latest$" }
        },
        "storePath": { "type": "string", "pattern": "^/[^\\n]*$", "minLength": 2 },
        "bufferMiB": { "type": "integer", "minimum": 1, "maximum": 64 },
        "resources": { "type": "object" }
      }
    },
    "monitoring": {"type":"object","additionalProperties":false,"required":["enabled","prometheus","alertmanager","alerts"],"properties":{"enabled":{"type":"boolean"},"prometheus":{"type":"object","additionalProperties":false,"required":["image","retention","resources"],"properties":{"image":{"type":"string","pattern":"^.+:[A-Za-z0-9][A-Za-z0-9._-]*$","not":{"pattern":":latest$"}},"retention":{"type":"string","const":"7d"},"resources":{"type":"object"}}},"alertmanager":{"type":"object","additionalProperties":false,"required":["image","webhookSecret","resources"],"properties":{"image":{"type":"string","pattern":"^.+:[A-Za-z0-9][A-Za-z0-9._-]*$","not":{"pattern":":latest$"}},"webhookSecret":{"type":"object","additionalProperties":false,"required":["name","key"],"properties":{"name":{"type":"string","pattern":"^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$","maxLength":253},"key":{"type":"string","pattern":"^[A-Za-z0-9._-]+$","minLength":1}}},"resources":{"type":"object"}}},"alerts":{"type":"object","additionalProperties":false,"required":["dispatchStarts","memoryPressureThreshold"],"properties":{"dispatchStarts":{"type":"integer","minimum":1,"maximum":100},"memoryPressureThreshold":{"type":"number","exclusiveMinimum":0,"exclusiveMaximum":1}}}}},
    "cgroupLauncher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["disabled", "required"] }
      }
    },
    "cgroupWritable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeClass", "taskRuns"],
      "properties": {
        "runtimeClass": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "taskRuns": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" }
          }
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicas", "strategy"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 0 },
        "mallocConf": { "type": "string" },
        "strategy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["Recreate", "RollingUpdate"] },
            "rollingUpdate": {
              "type": "object",
              "additionalProperties": false,
              "required": ["maxSurge", "maxUnavailable"],
              "properties": {
                "maxSurge": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "string" }] },
                "maxUnavailable": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "string" }] }
              }
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "taskrun": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cpu", "memory", "lightCpu"],
              "properties": {
                "cpu": {
                  "type": "string",
                  "pattern": "^[+-]?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)([eE][+-]?[0-9]+|[numkKMGTPE]|[KMGTPE]i)?$"
                },
                "memory": { "type": "string" },
                "lightCpu": {
                  "type": "string",
                  "pattern": "^[+-]?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)([eE][+-]?[0-9]+|[numkKMGTPE]|[KMGTPE]i)?$"
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "quantity": {
      "type": "string",
      "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+|[numkKMGTPE]|(?:Ki|Mi|Gi|Ti|Pi|Ei))?$"
    }
  },
  "required": ["kueue"],
  "allOf": [
    {"if":{"properties":{"monitoring":{"properties":{"enabled":{"const":true}},"required":["enabled"]}}},"then":{"properties":{"monitoring":{"properties":{"alertmanager":{"properties":{"webhookSecret":{"properties":{"name":{"minLength":1}},"required":["name","key"]}},"required":["webhookSecret"]}},"required":["alertmanager"]}}}},
    {
      "if": {
        "properties": {"kueue":{"properties":{"capacity":{"properties":{"contract":{"const":"vector-v1"}},"required":["contract"]}},"required":["capacity"]}},
        "required": ["kueue"]
      },
      "then": {
        "properties": {"kueue":{"properties":{"capacity":{"properties":{"enabled":{"const":true},"staticFallback":{"required":["cpu","memory","pods"]}},"required":["enabled","source","staticFallback","nodePool","flavorSelector"]}},"required":["capacity"]}}
      }
    },
    {
      "if": {
        "properties": {
          "kueue": {
            "properties": {
              "capacity": {
                "properties": { "source": { "const": "nodepool-limits" } },
                "required": ["source"]
              }
            },
            "required": ["capacity"]
          }
        },
        "required": ["kueue"]
      },
      "then": {
        "properties": {
          "kueue": {
            "properties": {
              "capacity": {
                "required": ["staticFallback", "nodePool"],
                "properties": {
                  "staticFallback": { "required": ["cpu", "memory", "pods"] },
                  "nodePool": {
                    "required": ["dedicated", "name"],
                    "properties": {
                      "dedicated": { "const": true },
                      "name": { "minLength": 1 }
                    }
                  }
                }
              }
            },
            "required": ["capacity"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cgroupWritable": {
            "properties": {
              "taskRuns": {
                "properties": { "enabled": { "const": true } },
                "required": ["enabled"]
              }
            },
            "required": ["taskRuns"]
          }
        },
        "required": ["cgroupWritable"]
      },
      "then": {
        "properties": {
          "cgroupWritable": {
            "properties": {
              "runtimeClass": {
                "properties": { "enabled": { "const": true } },
                "required": ["enabled"]
              }
            },
            "required": ["runtimeClass"]
          }
        }
      }
    }
  ]
}
