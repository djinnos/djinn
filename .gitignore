# Djinn task management
.task-runtime/
.djinn/.obsidian/
.planning/
.claude/
.djinn/cases/
.djinn/patterns/
.djinn/pitfalls/

# Build / test artifacts
target/
target-*/
.cargo-target/
.taskrun-backstop-validation/
tmp/
.tmp/
.tmp-test/
test-tmp/

# MCP config (machine-specific paths, may contain API keys)
mcp.json
.mcp.json

# Package manager stores
.pnpm-store/
.npm-cache/
node_modules/
# pnpm/npm/corepack write here when HOME points inside the worktree (e.g. a
# worker sets HOME=<worktree> to make pnpm runnable). The pnpm content store
# lands at .local/share/pnpm and is huge — never commit it.
.local/

# Tilt local state — dev vault key + optional GitHub App creds consumed by the Tiltfile.
/.tilt/

# Local research / planning scratch (reference-repo mining, implementation plans). Not tracked.
/plans/

# Ephemeral per-run scratch (avoid junk-file review loops from interrupted sessions)
.cache/

# Telemetry analysis report outputs (generated by run_telemetry_analysis example;
# never commit — these are runtime artifacts, not fixtures)
phase1_report.json
*_report.json
report.json

# Playwright MCP session artifacts (screenshots/console/page dumps)
.playwright-mcp/

# Linux core dumps. A tokio worker stack overflow in the djinn-coordinator test
# suite writes ~15 MB core.<pid> files into the crate directory; on 2026-07-30
# a 263 MB dump was swept in by `git add -A` twice and caught only at the
# `git show --stat` check before push.
core.[0-9]*
core

# Knowledge-injection ranking evaluation corpus (proposal 5205).
#
# The judged fixture, its manifest, and the captured baseline are
# PER-DEPLOYMENT empirical artifacts: they contain real note IDs, task IDs,
# retrieval-trace IDs, base commits, and human relevance judgments from one
# specific installation. They must never be committed — this repository is
# shared across deployments, and a hand-authored substitute would make every
# downstream metric green while proving nothing.
#
# Each operator supplies their own corpus here and points the evaluator at it:
#   cargo run -p djinn-memory-eval -- injection-ranking \
#     --manifest server/crates/djinn-memory-eval/fixtures/local/injection-ranking-v1.manifest.json
server/crates/djinn-memory-eval/fixtures/local/
