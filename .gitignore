# Djinn task management
.djinn/worktrees/
.djinn/.obsidian/
.planning/
.claude/
.djinn/cases/
.djinn/patterns/
.djinn/pitfalls/

# Build / test artifacts
target/
target-*/
.cargo-target/
.taskrun-backstop-validation/
tmp/
.tmp/
.tmp-test/
test-tmp/

# MCP config (machine-specific paths, may contain API keys)
mcp.json
.mcp.json

# Package manager stores
.pnpm-store/
.npm-cache/
node_modules/
# pnpm/npm/corepack write here when HOME points inside the worktree (e.g. a
# worker sets HOME=<worktree> to make pnpm runnable). The pnpm content store
# lands at .local/share/pnpm and is huge — never commit it.
.local/

# Tilt local state — dev vault key + optional GitHub App creds consumed by the Tiltfile.
/.tilt/

# Local research / planning scratch (reference-repo mining, implementation plans). Not tracked.
/plans/

# Ephemeral per-run scratch (avoid junk-file review loops from interrupted sessions)
.cache/

# Telemetry analysis report outputs (generated by run_telemetry_analysis example;
# never commit — these are runtime artifacts, not fixtures)
phase1_report.json
*_report.json
report.json

# Stray .cargo state created by interrupted session tooling.
/server/scripts/fixtures/cargo-fingerprint-mtime/.cargo/

# Playwright MCP session artifacts (screenshots/console/page dumps)
.playwright-mcp/

